% ---------- metadata: \aaronsetup{course=..., number=..., due=..., id=...} ----------
\newcommand{\aaron@course}{}
\newcommand{\aaron@number}{}
\newcommand{\aaron@due}{}
\newcommand{\aaron@id}{}
\newcommand{\aaron@kicker}{}
\ExplSyntaxOn
\keys_define:nn { aaron/meta }
  {
    course .tl_set:N = \aaron@course,
    number .tl_set:N = \aaron@number,

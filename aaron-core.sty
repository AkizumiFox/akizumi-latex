% aaron-core.sty -- shared visual identity: fonts, colors, theorem styles,
% section / title / page styling. Loaded by aaron-hw, aaron-note, aaron-exam
% and beamerthemeAaron. Requires XeLaTeX.
%
% Options:  lang = en | zh   (default en)
%           cjk  = <font>    (default PingFangTC-Regular)
%           cjk-bold = <font>(default PingFangTC-Semibold)
%           bb   = light | regular | ams  (default light: bboldx, light weight)
%           text = serif | sans  (body text; default serif. Headings, labels,
%                  titles and slides stay Lato either way)
%           bib  = <file.bib>[,<file2.bib>]  (loads biblatex + biber; documents only)
%           paper  = a4 | letter | pad    (pad: 3:4 page for reading on a tablet)
%           layout = normal | margin      (margin: wide right margin for sidenotes)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aaron-core}[2026/10/21 v0.4 Aaron Lin shared style]

\RequirePackage{iftex}
\RequireXeTeX

\newif\ifaaron@zh
\newif\ifaaron@bboldx
\newif\ifaaron@serif
\newif\ifaaron@marginlayout
\ExplSyntaxOn
\tl_new:N \l__aaron_bb_tl
\clist_new:N \l__aaron_bib_clist
\int_new:N \l__aaron_paper_int
\keys_define:nn { aaron/core }
  {
    lang     .choices:nn = { en, zh }
      { \str_if_eq:VnTF \l_keys_choice_tl { zh } { \aaron@zhtrue } { \aaron@zhfalse } },
    cjk      .tl_set:N = \aaron@cjkfont,
    cjk      .initial:n = PingFangTC-Regular,
    cjk-bold .tl_set:N = \aaron@cjkboldfont,
    cjk-bold .initial:n = PingFangTC-Semibold,
    bb       .choices:nn = { light, regular, ams }
      { \tl_set_eq:NN \l__aaron_bb_tl \l_keys_choice_tl },
    bb       .initial:n = light,
    text     .choices:nn = { sans, serif }
      { \str_if_eq:VnTF \l_keys_choice_tl { serif } { \aaron@seriftrue } { \aaron@seriffalse } },
    text     .initial:n = serif,
    bib      .clist_set:N = \l__aaron_bib_clist,
    paper    .choices:nn = { a4, letter, pad }
      { \int_set_eq:NN \l__aaron_paper_int \l_keys_choice_int },
    paper    .initial:n = a4,
    layout   .choices:nn = { normal, margin }
      { \str_if_eq:VnTF \l_keys_choice_tl { margin } { \aaron@marginlayouttrue } { \aaron@marginlayoutfalse } },
    layout   .initial:n = normal,
  }
\ProcessKeyOptions [ aaron/core ]
\cs_new:Npn \aaron@paper { \int_use:N \l__aaron_paper_int }
\str_case:Vn \l__aaron_bb_tl
  {
    { light }   { \aaron@bboldxtrue \PassOptionsToPackage { light } { bboldx } }
    { regular } { \aaron@bboldxtrue }
  }
\ExplSyntaxOff

\RequirePackage{aaron-math}

% Blackboard bold: bboldx covers upper/lowercase, digits and Greek, so
% \mathbb{1} and \mathbb{k} work; \mathbfbb is the bold weight. Kept out of
% aaron-math so papers keep the venue's default \mathbb.
\ifaaron@bboldx\RequirePackage{bboldx}\fi

% ---------- fonts ----------
% Lato is the structure font: headings, labels, titles, headers, slides.
% Body text is Lato too (text=sans) or New Computer Modern Book (text=serif),
% which matches the Computer Modern math. Lato ships with TeX Live but is
% invisible to fontconfig, so it is loaded by file name. Its standard
% ligatures include a stylised "ti", so common ligatures are off.
\RequirePackage{fontspec}
\setsansfont{Lato}[
  Extension      = .ttf,
  UprightFont    = *-Regular,
  BoldFont       = *-Bold,
  ItalicFont     = *-Italic,
  BoldItalicFont = *-BoldItalic,
  Ligatures      = NoCommon]
\@ifclassloaded{beamer}{\aaron@seriffalse}{}
\ifaaron@serif
  \setmainfont{NewCM10}[
    Extension      = .otf,
    UprightFont    = *-Book,
    BoldFont       = *-Bold,
    ItalicFont     = *-BookItalic,
    BoldItalicFont = *-BoldItalic]
\else
  \renewcommand{\familydefault}{\sfdefault}
\fi
\IfFontExistsTF{JetBrains Mono}
  {\setmonofont{JetBrains Mono}[Scale=MatchLowercase]}
  {}

\RequirePackage{xeCJK}
% PingFang and Songti ship with macOS only. Elsewhere fall back to Noto CJK TC,
% then to Fandol (always in TeX Live), with a warning instead of a hard error.
\newcommand{\aaron@cjkserif}{STSongti-TC-Regular}
\newcommand{\aaron@cjkserifbold}{STSongti-TC-Bold}
\IfFontExistsTF{\aaron@cjkfont}{}{%
  \IfFontExistsTF{Noto Sans CJK TC}
    {\def\aaron@cjkfont{Noto Sans CJK TC}\def\aaron@cjkboldfont{Noto Sans CJK TC Bold}}
    {\def\aaron@cjkfont{FandolHei-Regular.otf}\def\aaron@cjkboldfont{FandolHei-Bold.otf}}%
  \PackageWarningNoLine{aaron-core}{CJK sans font not found; using \aaron@cjkfont}}
\IfFontExistsTF{\aaron@cjkserif}{}{%
  \IfFontExistsTF{Noto Serif CJK TC}
    {\def\aaron@cjkserif{Noto Serif CJK TC}\def\aaron@cjkserifbold{Noto Serif CJK TC Bold}}
    {\def\aaron@cjkserif{FandolSong-Regular.otf}\def\aaron@cjkserifbold{FandolSong-Bold.otf}}%
  \PackageWarningNoLine{aaron-core}{CJK serif font not found; using \aaron@cjkserif}}
% Chinese has no italic, so \emph / \textit on CJK text falls back to the bold
% weight; Latin text in the same \emph still gets Lato Italic.
% Serif body pairs with Songti TC; sans body and all structure use PingFang.
\ifaaron@serif
  \setCJKmainfont{\aaron@cjkserif}[BoldFont=\aaron@cjkserifbold,
    ItalicFont=\aaron@cjkserifbold, BoldItalicFont=\aaron@cjkserifbold]
\else
  \setCJKmainfont{\aaron@cjkfont}[BoldFont=\aaron@cjkboldfont,
    ItalicFont=\aaron@cjkboldfont, BoldItalicFont=\aaron@cjkboldfont]
\fi
\setCJKsansfont{\aaron@cjkfont}[BoldFont=\aaron@cjkboldfont,
  ItalicFont=\aaron@cjkboldfont, BoldItalicFont=\aaron@cjkboldfont]
\setCJKmonofont{\aaron@cjkfont}[ItalicFont=\aaron@cjkfont]
\xeCJKsetup{CJKmath=true}


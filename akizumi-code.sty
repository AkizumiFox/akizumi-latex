% \iosample{input lines, \\ between}{output lines}: two boxes side by side,
% each as wide as its content (at most half the line); an empty side is left
% out. \\ is a plain line break here, so "\\ [1, 2]" is safe.
\dim_new:N \l__akizumi_code_io_dim
\box_new:N \l__akizumi_code_io_box
\tcbset{akizumi/io/.style={akizumi/output, enhanced, nobeforeafter, box~align=top,
  boxsep=0pt, left=0.7em, right=0.7em, top=0.45em, bottom=0.45em, arc=0pt,
  coltitle=mute, colbacktitle=rule!45!wash, fonttitle=\ttfamily\footnotesize,
  titlerule=0pt, toptitle=0.2em, bottomtitle=0.2em, lefttitle=0.7em}}
\cs_new_protected:Npn \__akizumi_code_io_text:n #1
  { \ttfamily \small \raggedright \skip_set:Nn \parskip { 0pt } \cs_set:Npn \\ { \par } \everypar { \strut } \ignorespaces #1 \par }
\cs_new_protected:Npn \__akizumi_code_io_box:nnn #1#2#3
  {
    \hbox_set:Nn \l__akizumi_code_io_box
      { \begin{varwidth}{ \dim_eval:n {#3} } \__akizumi_code_io_text:n {#2} \end{varwidth} }
    \dim_set:Nn \l__akizumi_code_io_dim { \box_wd:N \l__akizumi_code_io_box }
    \hbox_set:Nn \l__akizumi_code_io_box { \ttfamily \footnotesize #1 }
    \dim_set:Nn \l__akizumi_code_io_dim
      { \dim_max:nn { \l__akizumi_code_io_dim } { \box_wd:N \l__akizumi_code_io_box } + 1.4em + 0.8pt }
    \begin{tcolorbox}[akizumi/io, title={#1}, width=\l__akizumi_code_io_dim]
      \__akizumi_code_io_text:n {#2}
    \end{tcolorbox}
  }
\NewDocumentCommand \iosample { +m +m }
  {
    \par \addvspace { 0.8em }
    \group_begin:
    \centering \noindent
    \tl_if_blank:nTF {#1}
      { \tl_if_blank:nF {#2} { \__akizumi_code_io_box:nnn { \akizumi@str{codeoutput} } {#2} { \linewidth - 1.6em } } }
      {
        \tl_if_blank:nTF {#2}
          { \__akizumi_code_io_box:nnn { \akizumi@str{codeinput} } {#1} { \linewidth - 1.6em } }
          {
            \__akizumi_code_io_box:nnn { \akizumi@str{codeinput} } {#1} { 0.46\linewidth - 1.6em }
            \hspace { 1.2em }
            \__akizumi_code_io_box:nnn { \akizumi@str{codeoutput} } {#2} { 0.46\linewidth - 1.6em }
          }
      }
    \par
    \group_end:
    \addvspace { 0.8em }
  }


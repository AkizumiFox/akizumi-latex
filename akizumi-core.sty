% After cleveref (documents: below; slides: beamerthemeAkizumi): CJK words
% between the references of one \cref. \def, so a preamble may \renewcommand them.
\newcommand{\akizumi@crefcjk}{%
  \ifakizumi@cjk
    \def\crefpairconjunction{\akizumi@str{cref-and}}%
    \def\crefmiddleconjunction{\akizumi@str{cref-comma}}%
    \def\creflastconjunction{\akizumi@str{cref-and}}%
    \def\crefpairgroupconjunction{\akizumi@str{cref-group}}%
    \def\crefmiddlegroupconjunction{\akizumi@str{cref-comma}}%
    \def\creflastgroupconjunction{\akizumi@str{cref-group}}%
    \def\crefrangeconjunction{\akizumi@str{cref-to}}%
    % English labels: the next kind's name is Latin, so a space after 與 too
    \ifakizumi@cjklabels\else
      \def\crefpairgroupconjunction{\akizumi@str{cref-and}}%
      \def\creflastgroupconjunction{\akizumi@str{cref-and}}%
    \fi
  \fi
  \ifakizumi@cjklabels  % otherwise cleveref's English names and plurals
    \crefformat{section}{##2\akizumi@num{section}{##1}##3}%
    \crefname{figure}{\akizumi@str{figure}}{\akizumi@str{figure}}%
    \crefname{table}{\akizumi@str{table}}{\akizumi@str{table}}%
    \crefformat{equation}{##2\akizumi@num{equation}{##1}##3}%
    \crefformat{appendix}{##2\akizumi@num{appendix}{##1}##3}%
    \crefformat{subappendix}{##2\akizumi@num{appendix}{##1}##3}%
  \fi}


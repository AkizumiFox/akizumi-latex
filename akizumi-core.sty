% ---------- theorem-like environments ----------
% A left bar marks where each one starts and ends. Kinds differ by bar weight
% and tone, not by hue, so the page keeps one accent color:
%   theorem lemma proposition corollary claim  1.6pt accent      accent label
%   definition assumption                1.6pt accentsoft  accent label
%   example remark                       1pt   asidebar    ink label
%   proof, solution                      0.8pt rule        muted label + qed
% Every kind also has an unnumbered starred form (theorem*, definition*, ...).
% Bodies are upright (italic would turn whole CJK statements bold).
\newtheoremstyle{akizumi-claim}{0pt}{0pt}{}{}{\sffamily\bfseries\color{accent}}{\akizumi@thmpunct}{0.6em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{\mdseries\color{mute}\akizumi@str{note-open}#3\akizumi@str{note-close}}}
\newtheoremstyle{akizumi-aside}{0pt}{0pt}{}{}{\sffamily\bfseries}{\akizumi@thmpunct}{0.6em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{\mdseries\color{mute}\akizumi@str{note-open}#3\akizumi@str{note-close}}}
\theoremstyle{akizumi-claim}
% Names come from the language table (\akizumi@tn above).
\newtheorem{theorem}{\akizumi@str{theorem}}
\newtheorem*{theorem*}{\akizumi@str{theorem}}
% \akizumi@thm{env}{English plural}: numbered together with theorem, plus an
% unnumbered env*. Not \newtheorem{env}[theorem]: the LaTeX kernel turned that
% into a counter alias in 2026-06, which clashes with thmtools. Instead env
% gets its own counter name whose count register *is* theorem's, so the
% numbers are shared, cleveref reads the type from the counter name, and
% \theH... keeps hyperref anchors unique. Works with old and new kernels.
% CJK names have no plural form.
\def\akizumi@crefname#1#2{%
  \ifakizumi@nativethm\ifakizumi@cjk
    \crefname{#1}{\akizumi@str{#1}}{\akizumi@str{#1}}%
  \else\crefname{#1}{\akizumi@str{#1}}{#2}\fi
  \else\crefname{#1}{\akizumi@str{#1}}{#2}\fi}
\akizumi@crefname{theorem}{Theorems}
\def\akizumi@thm#1#2{%
  \newtheorem{#1}{\akizumi@str{#1}}\newtheorem*{#1*}{\akizumi@str{#1}}%
  \expandafter\let\csname c@#1\endcsname\c@theorem
  \expandafter\def\csname the#1\endcsname{\thetheorem}%
  \expandafter\def\csname theH#1\endcsname{\theHtheorem}%
  \akizumi@crefname{#1}{#2}}
\akizumi@thm{lemma}{Lemmas}
\akizumi@thm{proposition}{Propositions}
\akizumi@thm{corollary}{Corollaries}
\akizumi@thm{claim}{Claims}
\akizumi@thm{definition}{Definitions}
\akizumi@thm{assumption}{Assumptions}
\theoremstyle{akizumi-aside}
\akizumi@thm{example}{Examples}
\akizumi@thm{remark}{Remarks}
\renewcommand{\proofname}{\akizumi@str{proof}}
\renewcommand{\qedsymbol}{\textcolor{mute}{$\square$}}
\renewenvironment{proof}[1][\proofname]{%
  \par\pushQED{\qed}\normalfont\topsep\z@\relax
  \trivlist\item[\hskip\labelsep{\sffamily\bfseries\color{mute}#1\akizumi@thmpunct}]\akizumi@thmheadtrue\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

% Right after \item the item's label goes on a line of its own first, as with
% amsthm (else: "Something's wrong--perhaps a missing \item").
\def\akizumi@afteritem{\if@inlabel\leavevmode\fi}
\def\akizumi@onebar#1#2#3{%
  \tcolorboxenvironment{#1}{akizumi/bar={#2}{#3}}%
  \AddToHook{env/#1/before}{\akizumi@afteritem\Needspace{4\baselineskip}}%
  \DeclareHookRule{env/#1/before}{akizumi-core}{before}{tcolorbox}% outside the box
  \akizumi@directbar{#1}{#2}{#3}}
% The bar hangs on \begin{env}. thmtools' restatable (and its \name* copies)
% call \env ... \endenv directly, so at \begin{document}, when every kind is
% final, each barred kind learns to draw its bar itself when \@currenvir is
% not its own name.
\newif\ifakizumi@ownbar
\def\akizumi@barkinds{}
\def\akizumi@directbar#1#2#3{%
  \expandafter\gdef\csname akizumi@bar@#1\endcsname{{#2}{#3}}%
  \@ifundefined{akizumi@barlisted@#1}{%
    \expandafter\gdef\csname akizumi@barlisted@#1\endcsname{}%
    \xdef\akizumi@barkinds{\akizumi@barkinds\ifx\akizumi@barkinds\@empty\else,\fi#1}}{}}
\def\akizumi@wrapbar#1{%
  \expandafter\let\csname akizumi@orig@#1\expandafter\endcsname\csname #1\endcsname
  \expandafter\let\csname akizumi@origend@#1\expandafter\endcsname\csname end#1\endcsname
  \@namedef{#1}{\def\akizumi@tmp{#1}%
    \ifx\@currenvir\akizumi@tmp\akizumi@ownbarfalse\else
      \akizumi@ownbartrue
      \expandafter\expandafter\expandafter\akizumi@openbar\csname akizumi@bar@#1\endcsname\fi
    \csname akizumi@orig@#1\endcsname}%
  \@namedef{end#1}{\csname akizumi@origend@#1\endcsname
    \ifakizumi@ownbar\end{tcolorbox}\fi}}
\def\akizumi@openbar#1#2{\akizumi@afteritem\Needspace{4\baselineskip}\begin{tcolorbox}[akizumi/bar={#1}{#2}]}
\AtBeginDocument{\@for\akizumi@k:=\akizumi@barkinds\do{%
  \@ifundefined{\akizumi@k}{}{\@ifundefined{akizumi@bar@\akizumi@k}{}%
    {\expandafter\akizumi@wrapbar\expandafter{\akizumi@k}}}}}
\def\akizumi@barenv#1#2#3{\akizumi@onebar{#1}{#2}{#3}\akizumi@onebar{#1*}{#2}{#3}}
\akizumi@barenv{theorem}{1.6pt}{accent}
\akizumi@barenv{lemma}{1.6pt}{accent}
\akizumi@barenv{proposition}{1.6pt}{accent}
\akizumi@barenv{corollary}{1.6pt}{accent}
\akizumi@barenv{claim}{1.6pt}{accent}
\akizumi@barenv{definition}{1.6pt}{accentsoft}
\akizumi@barenv{assumption}{1.6pt}{accentsoft}
\akizumi@barenv{example}{1pt}{asidebar}
\akizumi@barenv{remark}{1pt}{asidebar}
\akizumi@onebar{proof}{0.8pt}{rule}

% ---------- restated theorems, proofs elsewhere ----------
%   \begin{restatable}{theorem}{mainthm}\label{thm:main} ... \end{restatable}
%   \mainthm*                      repeat it later (appendix) with the same number
%   \begin{proofof}{thm:main} ...  "Proof of Theorem 1.2." linking back
\newenvironment{proofof}[1]{\begin{proof}[\akizumi@str{proofof-b}\cref{#1}\akizumi@str{proofof-a}]}{\end{proof}}

% ---------- list of theorems ----------
%   \listoftheorems                           everything
%   \listoftheorems[onlynamed]                only ones with a name, e.g. [Cramér--Wold]
%   \listoftheorems[ignoreall, show={definition}]
\renewcommand{\listtheoremname}{\akizumi@str{listtheorems}}
% A restated copy (\mainthm*) is not listed again: thmtools swaps \label for
% \thmt@gobble@label inside the copy, which is how we recognise it.
\newcommand{\akizumi@noloe}[3]{}
\addtotheorempreheadhook{\ifx\label\thmt@gobble@label\let\addcontentsline\akizumi@noloe\fi}
% A body that opens with a list starts it on the line after the heading
% (not on the heading's line, where a long note ran into the margin). The
% first list in the body clears the flag, so \item\begin{enumerate} further
% in keeps both labels on one line.
\newif\ifakizumi@thmhead
\addtotheorempostheadhook{\akizumi@thmheadtrue}
\def\akizumi@listafterhead{\if@inlabel\ifakizumi@thmhead\leavevmode\fi\fi\akizumi@thmheadfalse}
\AddToHook{env/itemize/before}{\akizumi@listafterhead}
\AddToHook{env/enumerate/before}{\akizumi@listafterhead}
\AddToHook{env/description/before}{\akizumi@listafterhead}
% \begin{theorem}[] is a theorem without a note (thmtools leaves the short
% note undefined and stops in the list of theorems)
\ExplSyntaxOn
\addtotheorempreheadhook
  { \tl_if_blank:VT \thmt@optarg { \cs_set_eq:NN \thmt@optarg \@empty \cs_set_eq:NN \thmt@shortoptarg \@empty } }
\ExplSyntaxOff

% \akizumi@thmwithin{section}: number theorems per section/chapter. The kinds
% sharing the counter copied the old format when defined, so reset theirs too
% (the \theH... forms keep hyperref anchors unique).
\newcommand{\akizumi@thmwithin}[1]{%
  \counterwithin{theorem}{#1}%
  \@for\akizumi@t:=lemma,proposition,corollary,claim,definition,assumption,example,remark\do{%
    \expandafter\def\csname the\akizumi@t\endcsname{\thetheorem}%
    \expandafter\def\csname theH\akizumi@t\endcsname{\theHtheorem}}}

% ---------- algorithms ----------
%   \begin{algorithm}[t] \caption{...}\label{alg:x}
%     \begin{algorithmic}[1] \Require ... \State ... \end{algorithmic}
%   \end{algorithm}
\RequirePackage{algorithm}
\RequirePackage{algpseudocodex}
\floatname{algorithm}{\akizumi@str{algorithm}}
\ifakizumi@cjklabels\crefname{algorithm}{\akizumi@str{algorithm}}{\akizumi@str{algorithm}}%
\else\crefname{algorithm}{Algorithm}{Algorithms}\fi
\algrenewcommand{\algorithmicrequire}{\textsf{\textbf{\akizumi@str{alg-input}}}}
\algrenewcommand{\algorithmicensure}{\textsf{\textbf{\akizumi@str{alg-output}}}}

% ---------- notation table ----------
%   \begin{notation}
%     \notn{$\vb{z}_t$}{latent state at time $t$}
%   \end{notation}
% Headers in the main language. \leavevmode: a \color first in a p cell
% would sit above the cell's paragraph and add a \parskip to the row.
\newenvironment{notation}
  {\par\noindent\tabularx{\linewidth}{@{}>{\raggedright\arraybackslash}p{0.24\linewidth}Y@{}}
   \toprule
   \leavevmode{\sffamily\small\color{mute}\akizumi@str{symbol}} &
   \leavevmode{\sffamily\small\color{mute}\akizumi@str{meaning}}\\\midrule}
  {\bottomrule\endtabularx\par}
\newcommand{\notn}[2]{#1 & #2\\}

% ---------- title block (same layout as the title slide) ----------
% "Aaron Lin · B12345678 · 2026 年 10 月 25 日"
\newcommand{\akizumi@byline}{%
  \ifx\@author\@empty\else
    \@author\ifx\akizumi@id\@empty\else\akizumisep\akizumi@id\fi
    \ifx\@date\@empty\else\akizumisep\fi
  \fi
  \@date}
% Title block, centred:
%   LECTURE 9                       kicker: spaced capitals, accent colour
%   The Title                       (+ subtitle from \akizumisetup{subtitle=})
%   COURSE    AUTHOR    ID    DATE  titleinfo=row: labelled details, four to
%   Lin. Alg. Aaron Lin B123  Oct   a row; hw shows Due instead of the date;
%                                   info={Label=value, ...} adds columns
% titleinfo=line puts "author · ID · date" on one muted line instead.
\akizumi@s{label-course}{Course}{課程}{科目}{과목}
\akizumi@s{label-author}{Author}{作者}{著者}{저자}
\akizumi@s{label-date}{Date}{日期}{日付}{날짜}
\newfontfamily\akizumi@spaced{Lato}[Extension=.ttf, UprightFont=*-Bold,
  BoldFont=*-Bold, ItalicFont=*-BoldItalic, BoldItalicFont=*-BoldItalic,
  LetterSpace=8, Ligatures=NoCommon]
\ExplSyntaxOn
% spaced capitals for Latin text; CJK keeps the sans face
\cs_new_protected:Npn \akizumi@spacedcaps #1
  { { \sffamily \akizumi@spaced \text_uppercase:n {#1} } }
\seq_new:N \l__akizumi_title_fields_seq
% #1 the value (skipped when empty), #2 its label; stored as {label}{value}
\cs_new_protected:Npn \__akizumi_title_field:nn #1#2
  { \tl_if_blank:nF {#1} { \seq_put_right:Nn \l__akizumi_title_fields_seq { {#2} {#1} } } }
\cs_new_protected:Npn \__akizumi_title_cell:nn #1#2
  {
    \tl_if_blank:nF {#1}
      % CJK labels need a size more to stay legible
      { { \ifakizumi@cjk \scriptsize \else \tiny \fi \color{mute} \akizumi@spacedcaps {#1} } \\[-0.15em] }
    { \small \color{ink} #2 }
  }
\int_new:N \l__akizumi_title_cols_int
\cs_new_protected:Npn \akizumi@titlerow
  {
    \seq_clear:N \l__akizumi_title_fields_seq
    \__akizumi_title_field:Vn \akizumi@course { \akizumi@str{label-course} }
    \__akizumi_title_field:Vn \@author { \akizumi@str{label-author} }
    \__akizumi_title_field:Vn \akizumi@id { \akizumi@str{id} }
    \tl_if_blank:VTF \akizumi@due
      { \__akizumi_title_field:Vn \@date { \akizumi@str{label-date} } }
      { \__akizumi_title_field:Vn \akizumi@due { \akizumi@str{due} } }
    \cs_if_exist:NT \l__akizumi_info_seq
      { \seq_map_inline:Nn \l__akizumi_info_seq { \seq_put_right:Nn \l__akizumi_title_fields_seq {##1} } }
    \seq_if_empty:NF \l__akizumi_title_fields_seq
      {
        \vspace{1.1em}
        \normalsize  % the same on a book cover, which is set \Large
        % rows of at most four cells, each centred on the page
        \int_zero:N \l__akizumi_title_cols_int
        \seq_map_inline:Nn \l__akizumi_title_fields_seq
          {
            \int_compare:nNnT { \l__akizumi_title_cols_int } = { 4 }
              { \__akizumi_title_flush: \par \vspace{0.6em} }
            \int_incr:N \l__akizumi_title_cols_int
            \tl_set:cn { l__akizumi_title_cell_ \int_use:N \l__akizumi_title_cols_int _tl } {##1}
            \hbox_set:cn { l__akizumi_title_cell_ \int_use:N \l__akizumi_title_cols_int _box }
              { \begin{tabular}[t]{@{}c@{}} \__akizumi_title_cell:nn ##1 \end{tabular} }
          }
        \__akizumi_title_flush: \par
      }
  }
\int_step_inline:nn { 4 }
  { \box_new:c { l__akizumi_title_cell_#1_box } \tl_new:c { l__akizumi_title_cell_#1_tl } }
\dim_new:N \l__akizumi_title_cap_dim
\dim_new:N \l__akizumi_title_fixed_dim
\int_new:N \l__akizumi_title_wide_int
\cs_new:Npn \__akizumi_title_wd:n #1 { \box_wd:c { l__akizumi_title_cell_#1_box } }
% Set the row and start a new one. Cells too wide for the line share what
% the others leave and wrap: no cell is wider than \l__akizumi_title_cap_dim.
\cs_new_protected:Npn \__akizumi_title_flush:
  {
    \dim_set:Nn \l__akizumi_title_cap_dim
      { ( \linewidth - 2.4em * ( \l__akizumi_title_cols_int - 1 ) ) / \l__akizumi_title_cols_int }
    \prg_replicate:nn { \l__akizumi_title_cols_int }
      {
        \dim_zero:N \l__akizumi_title_fixed_dim
        \int_zero:N \l__akizumi_title_wide_int
        \int_step_inline:nn { \l__akizumi_title_cols_int }
          {
            \dim_compare:nNnTF { \__akizumi_title_wd:n {##1} } > { \l__akizumi_title_cap_dim }
              { \int_incr:N \l__akizumi_title_wide_int }
              { \dim_add:Nn \l__akizumi_title_fixed_dim { \__akizumi_title_wd:n {##1} } }
          }
        \int_compare:nNnT { \l__akizumi_title_wide_int } > { 0 }
          {
            \dim_set:Nn \l__akizumi_title_cap_dim
              {
                ( \linewidth - 2.4em * ( \l__akizumi_title_cols_int - 1 ) - \l__akizumi_title_fixed_dim )
                / \l__akizumi_title_wide_int
              }
          }
      }
    \mbox
      {
        \int_step_inline:nn { \l__akizumi_title_cols_int }
          {
            \int_compare:nNnT {##1} > { 1 } { \hspace{2.4em} }
            \dim_compare:nNnTF { \__akizumi_title_wd:n {##1} } > { \l__akizumi_title_cap_dim + 0.1pt }
              {
                \parbox[t]{ \l__akizumi_title_cap_dim }
                  { \centering \exp_last_unbraced:Nv \__akizumi_title_cell:nn { l__akizumi_title_cell_##1_tl } }
              }
              { \box_use:c { l__akizumi_title_cell_##1_box } }
          }
      }
    \int_zero:N \l__akizumi_title_cols_int
  }
\cs_generate_variant:Nn \__akizumi_title_field:nn { Vn }
\cs_generate_variant:Nn \tl_if_blank:nTF { V }
\cs_new_protected:Npn \akizumi@titleinfopart
  {
    \str_case:Vn \akizumi@titleinfo
      {
        { row }  { \akizumi@titlerow }
        { line } { \vspace{0.8em} { \color{mute} \akizumi@byline \par } \akizumi@infoline }
      }
  }
\cs_generate_variant:Nn \str_case:nn { V }
\providecommand \akizumi@infoline { }
\ExplSyntaxOff
\newcommand{\akizumi@titleblock}{%
  \begingroup\sffamily\centering
  \ifx\akizumi@kicker\@empty\else
    {\footnotesize\color{accent}\akizumi@spacedcaps{\akizumi@kicker}}\par\vspace{0.7em}\fi
  {\huge\bfseries\@title\par}%
  \akizumi@aftertitle  % subtitle (akizumi-zhlayout)
  \akizumi@titleinfopart
  \vspace{2em}%
  \endgroup}

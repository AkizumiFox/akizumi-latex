% ---------- notation table ----------
%   \begin{notation}
%     \notn{$\vb{z}_t$}{latent state at time $t$}
%   \end{notation}
% Headers in the main language. \leavevmode: a \color first in a p cell
% would sit above the cell's paragraph and add a \parskip to the row.
\newenvironment{notation}
  {\par\noindent\tabularx{\linewidth}{@{}>{\raggedright\arraybackslash}p{0.24\linewidth}Y@{}}
   \toprule
   \leavevmode{\sffamily\small\color{mute}\akizumi@str{symbol}} &
   \leavevmode{\sffamily\small\color{mute}\akizumi@str{meaning}}\\\midrule}
  {\bottomrule\endtabularx\par}
\newcommand{\notn}[2]{#1 & #2\\}

% ---------- title block (same layout as the title slide) ----------

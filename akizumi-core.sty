\AtBeginDocument{\sbox{\akizumi@hookbox}{\color{mute}$\hookrightarrow$}}
\lstdefinestyle{akizumi}{
  basicstyle=\ttfamily\small, columns=fullflexible, keepspaces=true,
  upquote=true, tabsize=4, showstringspaces=false, extendedchars=true,
  breaklines=true,
  postbreak=\usebox{\akizumi@hookbox}\space,
  numbers=left, numberstyle=\scriptsize\ttfamily\color{codenumber}, numbersep=1em,
  keywordstyle=\color{accent}, commentstyle=\color{mute}\itshape,
  stringstyle=\color{warn},
  aboveskip=0pt, belowskip=0pt}
\lstset{style=akizumi}
\tcbset{
  akizumi/code/.style={
    enhanced jigsaw, breakable, listing only,
    listing options={style=akizumi},
    colback=wash, colframe=rule, frame hidden, arc=0pt, boxrule=0pt,
    left=2.4em, right=0.8em, top=0.55em, bottom=0.55em,
    before skip=0.8em, after skip=0.8em,
    coltitle=mute, colbacktitle=rule!45!wash, fonttitle=\ttfamily\footnotesize,
    titlerule=0pt, toptitle=0.3em, bottomtitle=0.3em, lefttitle=0.8em,
    overlay middle and last={\node[anchor=north east, inner sep=0.35em,
      font=\ttfamily\scriptsize, text=codenumber] at (frame.north east) {cont.};}},
  lang/.style={listing options app={language=#1}},
  numbers/.is choice,
  numbers/true/.style={left=2.4em, listing options app={numbers=left}},
  numbers/false/.style={left=0.8em, listing options app={numbers=none}},
}
\DeclareTCBListing{codeblock}{ O{} }{akizumi/code, #1}
\DeclareTCBInputListing{\inputcode}{ O{} m }{akizumi/code, listing file={#2}, #1}
\AddToHook{env/codeblock/before}{\Needspace{6\baselineskip}}

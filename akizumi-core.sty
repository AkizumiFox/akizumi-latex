\newcommand{\akizumi@byline}{%
  \ifx\@author\@empty\else
    \@author\ifx\akizumi@id\@empty\else\akizumisep\akizumi@id\fi
    \ifx\@date\@empty\else\akizumisep\fi
  \fi
  \@date}
% Centred kicker and title. The byline goes under the title with byline=true;
% otherwise the title page's header carries it (see the akizumi-title style).
\newcommand{\akizumi@titleblock}{%
  \begingroup\sffamily\centering
  \ifx\akizumi@kicker\@empty\else{\small\bfseries\color{accent}\akizumi@kicker}\par\vspace{0.35em}\fi
  {\huge\bfseries\@title\par}%
  \akizumi@aftertitle  % subtitle and info line (akizumi-zhlayout)
  \ifakizumi@byline\vspace{0.6em}{\color{mute}\akizumi@byline\par}\fi
  \vspace{1.8em}%
  \endgroup}
\renewcommand{\maketitle}{\akizumi@titleblock\akizumi@titlepagestyle}
\newcommand{\akizumi@titlepagestyle}{%

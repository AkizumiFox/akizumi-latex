  \@ifundefined{refname}{}{\renewcommand{\refname}{\akizumi@str{references}}}
  \@ifundefined{bibname}{}{\renewcommand{\bibname}{\akizumi@str{references}}}
  \@ifundefined{abstractname}{}{\renewcommand{\abstractname}{\akizumi@str{abstract}}}
  \@ifundefined{appendixname}{}{\renewcommand{\appendixname}{\akizumi@str{appendix}}}
\fi

% ---------- theorem-like environments ----------
% A left bar marks where each one starts and ends. Kinds differ by bar weight
% and tone, not by hue, so the page keeps one accent color:
%   theorem lemma proposition corollary claim  1.6pt accent      accent label
%   definition assumption                1.6pt accentsoft  accent label
%   example remark                       1pt   asidebar    ink label
%   proof, solution                      0.8pt rule        muted label + qed
% Every kind also has an unnumbered starred form (theorem*, definition*, ...).
% Bodies are upright (italic would turn whole CJK statements bold).
\newtheoremstyle{akizumi-claim}{0pt}{0pt}{}{}{\sffamily\bfseries\color{accent}}{\akizumi@thmpunct}{0.6em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{\mdseries\color{mute}\ (#3)}}
\newtheoremstyle{akizumi-aside}{0pt}{0pt}{}{}{\sffamily\bfseries}{\akizumi@thmpunct}{0.6em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{\mdseries\color{mute}\ (#3)}}
\theoremstyle{akizumi-claim}
% Names come from the language table (\akizumi@tn above).
\newtheorem{theorem}{\akizumi@str{theorem}}
\newtheorem*{theorem*}{\akizumi@str{theorem}}
% \akizumi@thm{env}{English plural}: numbered together with theorem, plus an
% unnumbered env*. Not \newtheorem{env}[theorem]: the LaTeX kernel turned that
% into a counter alias in 2026-06, which clashes with thmtools. Instead env
% gets its own counter name whose count register *is* theorem's, so the
% numbers are shared, cleveref reads the type from the counter name, and
% \theH... keeps hyperref anchors unique. Works with old and new kernels.
% CJK names have no plural form.
\def\akizumi@crefname#1#2{%
  \ifakizumi@nativethm\ifakizumi@cjk
    \crefname{#1}{\akizumi@str{#1}}{\akizumi@str{#1}}%
  \else\crefname{#1}{\akizumi@str{#1}}{#2}\fi
  \else\crefname{#1}{\akizumi@str{#1}}{#2}\fi}
\akizumi@crefname{theorem}{Theorems}
\def\akizumi@thm#1#2{%
  \newtheorem{#1}{\akizumi@str{#1}}\newtheorem*{#1*}{\akizumi@str{#1}}%
  \expandafter\let\csname c@#1\endcsname\c@theorem
  \expandafter\def\csname the#1\endcsname{\thetheorem}%
  \expandafter\def\csname theH#1\endcsname{\theHtheorem}%
  \akizumi@crefname{#1}{#2}}
\akizumi@thm{lemma}{Lemmas}
\akizumi@thm{proposition}{Propositions}
\akizumi@thm{corollary}{Corollaries}
\akizumi@thm{claim}{Claims}
\akizumi@thm{definition}{Definitions}
\akizumi@thm{assumption}{Assumptions}
\theoremstyle{akizumi-aside}
\akizumi@thm{example}{Examples}
\akizumi@thm{remark}{Remarks}
\renewcommand{\proofname}{\akizumi@str{proof}}
\renewcommand{\qedsymbol}{\textcolor{mute}{$\square$}}
\renewenvironment{proof}[1][\proofname]{%
  \par\pushQED{\qed}\normalfont\topsep\z@\relax
  \trivlist\item[\hskip\labelsep{\sffamily\bfseries\color{mute}#1\akizumi@thmpunct}]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

\def\akizumi@onebar#1#2#3{%
  \tcolorboxenvironment{#1}{akizumi/bar={#2}{#3}}%
  \AddToHook{env/#1/before}{\Needspace{4\baselineskip}}}
\def\akizumi@barenv#1#2#3{\akizumi@onebar{#1}{#2}{#3}\akizumi@onebar{#1*}{#2}{#3}}
\akizumi@barenv{theorem}{1.6pt}{accent}
\akizumi@barenv{lemma}{1.6pt}{accent}
\akizumi@barenv{proposition}{1.6pt}{accent}
\akizumi@barenv{corollary}{1.6pt}{accent}
\akizumi@barenv{claim}{1.6pt}{accent}
\akizumi@barenv{definition}{1.6pt}{accentsoft}
\akizumi@barenv{assumption}{1.6pt}{accentsoft}
\akizumi@barenv{example}{1pt}{asidebar}
\akizumi@barenv{remark}{1pt}{asidebar}
\akizumi@onebar{proof}{0.8pt}{rule}

% ---------- restated theorems, proofs elsewhere ----------
%   \begin{restatable}{theorem}{mainthm}\label{thm:main} ... \end{restatable}
%   \mainthm*                      repeat it later (appendix) with the same number
%   \begin{proofof}{thm:main} ...  "Proof of Theorem 1.2." linking back
\newenvironment{proofof}[1]{\begin{proof}[\akizumi@str{proofof-b}\cref{#1}\akizumi@str{proofof-a}]}{\end{proof}}

% ---------- list of theorems ----------
%   \listoftheorems                           everything
%   \listoftheorems[onlynamed]                only ones with a name, e.g. [Cramér--Wold]
%   \listoftheorems[ignoreall, show={definition}]
\renewcommand{\listtheoremname}{\akizumi@str{listtheorems}}
% A restated copy (\mainthm*) is not listed again: thmtools swaps \label for
% \thmt@gobble@label inside the copy, which is how we recognise it.
\newcommand{\akizumi@noloe}[3]{}
\addtotheorempreheadhook{\ifx\label\thmt@gobble@label\let\addcontentsline\akizumi@noloe\fi}

% \akizumi@thmwithin{section}: number theorems per section/chapter. The kinds
% sharing the counter copied the old format when defined, so reset theirs too
% (the \theH... forms keep hyperref anchors unique).
\newcommand{\akizumi@thmwithin}[1]{%
  \counterwithin{theorem}{#1}%
  \@for\akizumi@t:=lemma,proposition,corollary,claim,definition,assumption,example,remark\do{%
    \expandafter\def\csname the\akizumi@t\endcsname{\thetheorem}%
    \expandafter\def\csname theH\akizumi@t\endcsname{\theHtheorem}}}


% akizumi-core.sty -- shared visual identity: fonts, colors, theorem styles,
% section / title / page styling. Loaded by akizumi-hw, akizumi-note, akizumi-exam
% and beamerthemeAkizumi. Requires XeLaTeX.
%
% Options:  lang = en | zh | ja | ko   (main language; default en)
%           thmnames = english | native  (Theorem, Proof, ... or 定理, 證明, ...;
%                  default english)
%           cjk  = <font>    (CJK sans font; default picked per language)
%           cjk-bold = <font>
%           bb   = light | regular | ams  (default light: bboldx, light weight)
%           text = serif | sans | times | palatino  (body text; default serif.
%                  Headings, labels, titles and slides stay Lato either way)
%           bib  = <file.bib>[,<file2.bib>]  (loads biblatex + biber; documents only)
%           paper  = a4 | letter | pad    (pad: 3:4 page for reading on a tablet)
%           layout = normal | margin      (margin: wide right margin for sidenotes)
%           byline = false | true  (author and date under the title; default
%                  false: they go in the first page's header instead)
%           tikz = basic | full, plots  (TikZ libraries, pgfplots; see akizumi-tikz.sty)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{akizumi-core}[2026/10/26 v0.9 Aaron Lin shared style]

\RequirePackage{iftex}
\RequireXeTeX

\newif\ifakizumi@zh      % lang=zh (kept for user preambles)
\newif\ifakizumi@cjk     % lang=zh, ja or ko
\newif\ifakizumi@nativethm
\newif\ifakizumi@bboldx
\newif\ifakizumi@serif
\newif\ifakizumi@marginlayout
\newif\ifakizumi@byline
\ExplSyntaxOn
\tl_new:N \l__akizumi_bb_tl
\clist_new:N \l__akizumi_bib_clist
\int_new:N \l__akizumi_paper_int
\int_new:N \akizumi@langnum  % 0 en, 1 zh, 2 ja, 3 ko
\keys_define:nn { akizumi/core }
  {
    lang     .choices:nn = { en, zh, ja, ko }
      {
        \int_set:Nn \akizumi@langnum { \l_keys_choice_int - 1 }
        \str_if_eq:VnTF \l_keys_choice_tl { zh } { \akizumi@zhtrue } { \akizumi@zhfalse }
        \str_if_eq:VnTF \l_keys_choice_tl { en } { \akizumi@cjkfalse } { \akizumi@cjktrue }
      },
    thmnames .choices:nn = { english, native }
      { \str_if_eq:VnTF \l_keys_choice_tl { native } { \akizumi@nativethmtrue } { \akizumi@nativethmfalse } },
    cjk      .tl_set:N = \akizumi@cjkfont,
    cjk      .initial:n = ,
    cjk-bold .tl_set:N = \akizumi@cjkboldfont,
    cjk-bold .initial:n = ,
    bb       .choices:nn = { light, regular, ams }
      { \tl_set_eq:NN \l__akizumi_bb_tl \l_keys_choice_tl },
    bb       .initial:n = light,
    % times / palatino: serif body in TeX Gyre (set in akizumi-zhlayout)
    text     .choices:nn = { sans, serif, times, palatino }
      {
        \str_if_eq:VnTF \l_keys_choice_tl { sans } { \akizumi@seriffalse } { \akizumi@seriftrue }
        \tl_set_eq:NN \akizumi@textfont \l_keys_choice_tl
      },
    text     .initial:n = serif,
    bib      .clist_set:N = \l__akizumi_bib_clist,
    paper    .choices:nn = { a4, letter, pad }
      { \int_set_eq:NN \l__akizumi_paper_int \l_keys_choice_int },
    paper    .initial:n = a4,
    layout   .choices:nn = { normal, margin }
      { \str_if_eq:VnTF \l_keys_choice_tl { margin } { \akizumi@marginlayouttrue } { \akizumi@marginlayoutfalse } },
    layout   .initial:n = normal,
    byline   .choices:nn = { true, false }
      { \use:c { akizumi@byline \l_keys_choice_tl } },
    byline   .default:n = true,
  }
\ProcessKeyOptions [ akizumi/core ]
\cs_new:Npn \akizumi@paper { \int_use:N \l__akizumi_paper_int }
\str_case:Vn \l__akizumi_bb_tl
  {
    { light }   { \akizumi@bboldxtrue \PassOptionsToPackage { light } { bboldx } }
    { regular } { \akizumi@bboldxtrue }
  }
\ExplSyntaxOff

\RequirePackage{akizumi-math}

% Blackboard bold: bboldx covers upper/lowercase, digits and Greek, so
% \mathbb{1} and \mathbb{k} work; \mathbfbb is the bold weight. Kept out of
% akizumi-math so papers keep the venue's default \mathbb.
\ifakizumi@bboldx\RequirePackage{bboldx}\fi

% ---------- fonts ----------
% Lato is the structure font: headings, labels, titles, headers, slides.
% Body text is Lato too (text=sans) or New Computer Modern Book (text=serif),
% which matches the Computer Modern math. Lato ships with TeX Live but is
% invisible to fontconfig, so it is loaded by file name. Its standard
% ligatures include a stylised "ti", so common ligatures are off.
\RequirePackage{fontspec}
\setsansfont{Lato}[
  Extension      = .ttf,
  UprightFont    = *-Regular,
  BoldFont       = *-Bold,
  ItalicFont     = *-Italic,
  BoldItalicFont = *-BoldItalic,
  Ligatures      = NoCommon]
\@ifclassloaded{beamer}{\akizumi@seriffalse}{}
\ifakizumi@serif
  \setmainfont{NewCM10}[
    Extension      = .otf,
    UprightFont    = *-Book,
    BoldFont       = *-Bold,
    ItalicFont     = *-BookItalic,
    BoldItalicFont = *-BoldItalic]
\else
  \renewcommand{\familydefault}{\sfdefault}
\fi
\IfFontExistsTF{JetBrains Mono}
  {\setmonofont{JetBrains Mono}[Scale=MatchLowercase]}
  {}

\RequirePackage{xeCJK}
% CJK fonts, first one installed wins in each chain:
%   zh  sans   PingFang TC > Noto Sans CJK TC > Microsoft JhengHei > Fandol
%       serif  Songti TC > Noto Serif CJK TC > MingLiU > Fandol
%   ja  sans   Hiragino Sans > Noto Sans CJK JP > Yu Gothic > HaranoAji
%       serif  Hiragino Mincho > Noto Serif CJK JP > Yu Mincho > HaranoAji
%   ko  sans   Apple SD Gothic Neo > Noto Sans CJK KR > Malgun Gothic > Baekmuk
%       serif  AppleMyungjo > Noto Serif CJK KR > Batang > Baekmuk
% The main language's fonts set the text (en uses zh); cjk= goes first. The
% other two languages' fonts fill in characters the main one lacks, so a
% Japanese document can quote Traditional Chinese or Korean without boxes.
% The last of each chain ships with TeX Live (HaranoAji and Baekmuk only in
% its Japanese / Korean collections); a main language that falls to it gets a
% warning, as does Japanese or Korean with none of its fonts (the Chinese
% ones stand in). A face with no bold borrows the sans bold; a language with
% no serif face uses its sans one.
\ExplSyntaxOn
% \akizumi@pickfont \reg \bold { {reg}{bold}, {reg}{bold}, ... }: the first
% pair whose regular face exists; leaves \reg empty if none does.
\cs_new_protected:Npn \akizumi@pickfont #1#2#3
  {
    \tl_clear:N #1 \tl_clear:N #2
    \clist_map_inline:nn {#3} { \__akizumi_tryfont:NNnn #1 #2 ##1 }
  }
\cs_new_protected:Npn \__akizumi_tryfont:NNnn #1#2#3#4
  {
    \IfFontExistsTF {#3}
      { \tl_set:Nn #1 {#3} \tl_set:Nn #2 {#4} \clist_map_break: }
      { }
  }
\ExplSyntaxOff
\akizumi@pickfont\akizumi@zh@sans\akizumi@zh@sansbold{%
  {PingFangTC-Regular}{PingFangTC-Semibold}, {Noto Sans CJK TC}{Noto Sans CJK TC Bold},
  {Microsoft JhengHei}{Microsoft JhengHei Bold}, {FandolHei-Regular.otf}{FandolHei-Bold.otf}}
\akizumi@pickfont\akizumi@zh@serif\akizumi@zh@serifbold{%
  {STSongti-TC-Regular}{STSongti-TC-Bold}, {Noto Serif CJK TC}{Noto Serif CJK TC Bold},
  {MingLiU}{}, {FandolSong-Regular.otf}{FandolSong-Bold.otf}}
\akizumi@pickfont\akizumi@ja@sans\akizumi@ja@sansbold{%
  {HiraginoSans-W3}{HiraginoSans-W6}, {Noto Sans CJK JP}{Noto Sans CJK JP Bold},
  {Yu Gothic}{Yu Gothic Bold}, {HaranoAjiGothic-Regular.otf}{HaranoAjiGothic-Bold.otf}}
\akizumi@pickfont\akizumi@ja@serif\akizumi@ja@serifbold{%
  {HiraMinProN-W3}{HiraMinProN-W6}, {Noto Serif CJK JP}{Noto Serif CJK JP Bold},
  {Yu Mincho}{Yu Mincho Demibold}, {HaranoAjiMincho-Regular.otf}{HaranoAjiMincho-Bold.otf}}
\akizumi@pickfont\akizumi@ko@sans\akizumi@ko@sansbold{%
  {AppleSDGothicNeo-Regular}{AppleSDGothicNeo-Bold}, {Noto Sans CJK KR}{Noto Sans CJK KR Bold},
  {Malgun Gothic}{Malgun Gothic Bold}, {dotum.ttf}{}}
\akizumi@pickfont\akizumi@ko@serif\akizumi@ko@serifbold{%
  {AppleMyungjo}{}, {Noto Serif CJK KR}{Noto Serif CJK KR Bold}, {Batang}{}, {batang.ttf}{}}
% fill the gaps: bold from sans bold or regular, serif from sans
\def\akizumi@fill#1{%
  \expandafter\ifx\csname akizumi@#1@sansbold\endcsname\@empty
    \expandafter\let\csname akizumi@#1@sansbold\expandafter\endcsname\csname akizumi@#1@sans\endcsname\fi
  \expandafter\ifx\csname akizumi@#1@serif\endcsname\@empty
    \expandafter\let\csname akizumi@#1@serif\expandafter\endcsname\csname akizumi@#1@sans\endcsname\fi
  \expandafter\ifx\csname akizumi@#1@serifbold\endcsname\@empty
    \expandafter\let\csname akizumi@#1@serifbold\expandafter\endcsname\csname akizumi@#1@sansbold\endcsname\fi}
\akizumi@fill{zh}\akizumi@fill{ja}\akizumi@fill{ko}
\newcommand{\akizumi@fallbackwarning}[1]{%
  \PackageWarningNoLine{akizumi-core}{#1; install Noto CJK for full coverage}}
% main language: zh for en and zh; ja / ko when one of their fonts exists
% (\akizumi@others: the languages that fill in missing characters)
\def\akizumi@main{zh}\def\akizumi@others{ja,ko}
\ifcase\akizumi@langnum\or\or
  \ifx\akizumi@ja@sans\@empty\akizumi@fallbackwarning{No Japanese font found, using Chinese ones}%
  \else\def\akizumi@main{ja}\def\akizumi@others{zh,ko}\fi
\or
  \ifx\akizumi@ko@sans\@empty\akizumi@fallbackwarning{No Korean font found, using Chinese ones}%
  \else\def\akizumi@main{ko}\def\akizumi@others{zh,ja}\fi
\fi
\def\akizumi@lastresort{FandolHei-Regular.otf,HaranoAjiGothic-Regular.otf,dotum.ttf}
\edef\akizumi@tmp{\csname akizumi@\akizumi@main @sans\endcsname}
\@for\akizumi@f:=\akizumi@lastresort\do{%
  \ifx\akizumi@f\akizumi@tmp
    \akizumi@fallbackwarning{Using \akizumi@f, which may lack some characters}\fi}
% user's cjk= / cjk-bold= replace the main sans face
\ifx\akizumi@cjkfont\@empty
  \edef\akizumi@cjkfont{\csname akizumi@\akizumi@main @sans\endcsname}
\fi
\ifx\akizumi@cjkboldfont\@empty
  \edef\akizumi@cjkboldfont{\csname akizumi@\akizumi@main @sansbold\endcsname}
\fi
\edef\akizumi@cjkserif{\csname akizumi@\akizumi@main @serif\endcsname}
\edef\akizumi@cjkserifbold{\csname akizumi@\akizumi@main @serifbold\endcsname}
% Korean separates words with spaces: keep them, and add no extra gap
% between Hangul and Latin letters or digits (2026년, not 2026 년).
\ifnum\akizumi@langnum=3 \xeCJKsetup{CJKspace=true, CJKecglue={}}\fi
% CJK has no italic, so \emph / \textit on CJK text falls back to the bold
% weight; Latin text in the same \emph still gets Lato Italic.
% Serif body pairs with the serif face (Songti, Mincho, Myungjo); sans body
% and all structure use the sans face.
\ifakizumi@serif
  \setCJKmainfont{\akizumi@cjkserif}[BoldFont=\akizumi@cjkserifbold,
    ItalicFont=\akizumi@cjkserifbold, BoldItalicFont=\akizumi@cjkserifbold]
\else
  \setCJKmainfont{\akizumi@cjkfont}[BoldFont=\akizumi@cjkboldfont,
    ItalicFont=\akizumi@cjkboldfont, BoldItalicFont=\akizumi@cjkboldfont]
\fi
\setCJKsansfont{\akizumi@cjkfont}[BoldFont=\akizumi@cjkboldfont,
  ItalicFont=\akizumi@cjkboldfont, BoldItalicFont=\akizumi@cjkboldfont]
\setCJKmonofont{\akizumi@cjkfont}[ItalicFont=\akizumi@cjkfont]
% Fallback: the other two languages, sans or serif to match the family;
% skips a language with no font installed.
% \akizumi@fallback{\family}{sans|serif}
\def\akizumi@fallback#1#2{%
  \def\akizumi@list{}%
  \@for\akizumi@l:=\akizumi@others\do{%
    \expandafter\ifx\csname akizumi@\akizumi@l @sans\endcsname\@empty\else
      \edef\akizumi@b{\csname akizumi@\akizumi@l @#2bold\endcsname}%
      \edef\akizumi@list{\akizumi@list\ifx\akizumi@list\@empty\else,\fi
        {[BoldFont=\akizumi@b, ItalicFont=\akizumi@b, BoldItalicFont=\akizumi@b]%
         \csname akizumi@\akizumi@l @#2\endcsname}}%
    \fi}%
  \ifx\akizumi@list\@empty\else
    \edef\akizumi@tmp{\noexpand\setCJKfallbackfamilyfont{\noexpand#1}{\akizumi@list}}\akizumi@tmp
  \fi}
\akizumi@fallback\CJKsfdefault{sans}
\akizumi@fallback\CJKttdefault{sans}
\ifakizumi@serif\akizumi@fallback\CJKrmdefault{serif}\else\akizumi@fallback\CJKrmdefault{sans}\fi
\xeCJKsetup{CJKmath=true, AutoFallBack=true}
% Korean inside a zh / ja / en document keeps its word spaces: Hangul gets an
% intercharacter class of its own, set like Latin text (spaces kept, no glue
% to digits) in the Korean font. xeCJK joins the class to its own ones at the
% end of the preamble. lang=ko does this through CJKspace above.
\ifnum\akizumi@langnum=3 \else\ifx\akizumi@ko@sans\@empty\else
  \newfontfamily\akizumi@hangulsans{\akizumi@ko@sans}[BoldFont=\akizumi@ko@sansbold,
    ItalicFont=\akizumi@ko@sansbold, BoldItalicFont=\akizumi@ko@sansbold]
  \newfontfamily\akizumi@hangulserif{\akizumi@ko@serif}[BoldFont=\akizumi@ko@serifbold,
    ItalicFont=\akizumi@ko@serifbold, BoldItalicFont=\akizumi@ko@serifbold]
  \def\akizumi@hangul@begin{\begingroup
    \ifakizumi@serif\edef\akizumi@tmpa{\f@family}\edef\akizumi@tmpb{\rmdefault}%
      \ifx\akizumi@tmpa\akizumi@tmpb\akizumi@hangulserif\else\akizumi@hangulsans\fi
    \else\akizumi@hangulsans\fi}
  \def\akizumi@hangul@end{\endgroup}
  \newXeTeXintercharclass\akizumi@hangulclass
  \@tempcnta="AC00 \loop\XeTeXcharclass\@tempcnta=\akizumi@hangulclass
    \ifnum\@tempcnta<"D7A3 \advance\@tempcnta\@ne\repeat
  \@tempcnta="3131 \loop\XeTeXcharclass\@tempcnta=\akizumi@hangulclass
    \ifnum\@tempcnta<"318E \advance\@tempcnta\@ne\repeat
  % to and from Latin letters, half-width punctuation and spaces / boundaries
  \ExplSyntaxOn
  \clist_map_inline:nn { Default, HalfLeft, HalfRight, NormalSpace, Boundary }
    {
      \XeTeXinterchartoks \xeCJK_class_num:n {#1} \akizumi@hangulclass = {\akizumi@hangul@begin}
      \XeTeXinterchartoks \akizumi@hangulclass \xeCJK_class_num:n {#1} = {\akizumi@hangul@end}
    }
  \ExplSyntaxOff
\fi\fi


% ---------- page geometry ----------
% Classes call \akizumi@setgeometry{<their a4/letter margins>}. paper=pad ignores
% them for a 3:4 tablet page; layout=margin widens the right margin for notes.
\RequirePackage{geometry}
\newcommand{\akizumi@setgeometry}[1]{%
  \ifcase\akizumi@paper\relax\or
    \geometry{a4paper,#1}\or
    \geometry{letterpaper,#1}\or
    \geometry{paperwidth=15.6cm, paperheight=20.8cm, margin=1.3cm,
      top=1.9cm, bottom=1.7cm, headsep=0.6cm, headheight=15pt}%
    \ifakizumi@marginlayout
      \PackageWarningNoLine{akizumi-core}{layout=margin needs a wider page; ignored with paper=pad}%
      \akizumi@marginlayoutfalse
    \fi
  \fi
  \ifakizumi@marginlayout
    \geometry{left=2.2cm, right=7.6cm, marginparsep=0.7cm, marginparwidth=5.2cm}%
  \fi}


% akizumi-math.sty -- math macros only. Engine-agnostic: works with pdfLaTeX,
% XeLaTeX and LuaLaTeX, so it can go into conference papers (NeurIPS, ICML, ...)
% that forbid custom styling. If you use unicode-math, load it BEFORE this file.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{akizumi-math}[2026/10/25 v0.8 Aaron Lin math macros]

\RequirePackage{amsmath,amssymb,mathtools}

% Vectors / matrices in upright bold: \vb{x}, \vb{A}.
% Greek (any argument starting with a control sequence, e.g. \vb{\Lambda})
% goes through \bm, since \mathbf has no Greek in the legacy math setup:
% uppercase comes out upright bold, lowercase bold italic.
\@ifpackageloaded{unicode-math}
  {\newcommand{\vb}[1]{\symbfup{#1}}}
  {\RequirePackage{bm}%
   \newcommand{\vb}[1]{\akizumi@vb#1\@nil}%
   \def\akizumi@vb#1#2\@nil{%
     \ifcat\relax\noexpand#1\bm{#1#2}\else\mathbf{#1#2}\fi}}

% Transpose: x\T
\newcommand{\T}{^{\top}}

% Paired delimiters: \norm{x}, \norm*{x} (auto-size), \norm[\big]{x}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\inner}{\langle}{\rangle}
\DeclarePairedDelimiter{\set}{\{}{\}}

% Operators
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator{\E}{\mathbb{E}}
\DeclareMathOperator{\Var}{Var}
\DeclareMathOperator{\Cov}{Cov}
\DeclareMathOperator{\KL}{KL}
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\rank}{rank}
\DeclareMathOperator{\diag}{diag}
\DeclareMathOperator{\sg}{sg}

% Number sets
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}

% Upright differential: \int f(x) \dd x
\newcommand{\dd}{\mathop{}\!\mathrm{d}}

\endinput

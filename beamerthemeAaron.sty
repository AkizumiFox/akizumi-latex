% beamerthemeAaron.sty -- minimal slides: Lato, hairline frame titles,
% muted bullets, page counter bottom right, automatic section pages.
%   \documentclass[aspectratio=169,11pt]{beamer}
%   \usetheme[lang=zh]{Aaron}
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeAaron}[2026/10/21 v0.3 Aaron Lin beamer theme]

\ExplSyntaxOn
\bool_new:N \l__aaron_progress_bool
\keys_define:nn { aaron/beamer }
  {
    lang .code:n = \PassOptionsToPackage { lang = #1 } { aaron-core },
    cjk  .code:n = \PassOptionsToPackage { cjk = #1 } { aaron-core },
    bb   .code:n = \PassOptionsToPackage { bb = #1 } { aaron-core },
    progress .bool_set:N = \l__aaron_progress_bool,
    progress .default:n  = true,
  }
\ProcessKeyOptions [ aaron/beamer ]
\newif\ifaaron@progress
\bool_if:NT \l__aaron_progress_bool { \aaron@progresstrue }
\ExplSyntaxOff

\RequirePackage{aaron-core}
\RequirePackage{tikz}
% Slides after \appendix are numbered on their own and left out of the total.
\RequirePackage{appendixnumberbeamer}

\setbeamertemplate{navigation symbols}{}
\setbeamercolor{normal text}{fg=ink}
\setbeamercolor{frametitle}{fg=ink}
\setbeamercolor{structure}{fg=accent}
\setbeamercolor{alerted text}{fg=warn}
\setbeamercolor{block title}{fg=accent,bg=}
\setbeamercolor{block body}{bg=}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{block title}{series=\bfseries}

\setbeamertemplate{itemize items}{\textcolor{mute}{\raisebox{0.15ex}{\scriptsize$\bullet$}}}
\setbeamertemplate{itemize subitem}{\textcolor{mute}{\scriptsize--}}
\setbeamertemplate{enumerate items}[default]

\setbeamertemplate{frametitle}{%
  \vspace*{0.6em}\insertframetitle\par\vspace{-0.2em}%
  {\color{rule}\rule{\linewidth}{0.4pt}}}
% progress=true adds a hairline progress bar along the bottom edge.
\setbeamertemplate{footline}{%
  \hfill{\color{mute}\scriptsize\insertframenumber\,/\,\inserttotalframenumber}\hspace{1.2em}\vspace{0.8em}%
  \ifaaron@progress\par\nointerlineskip\noindent\aaron@progressbar\fi}
\newcommand{\aaron@progressbar}{%
  \makebox[0pt][l]{\color{rule}\rule{\paperwidth}{1.2pt}}%
  {\color{accent}\rule{\ifnum\insertframenumber<\inserttotalframenumber
    \dimexpr\paperwidth*\insertframenumber/\inserttotalframenumber\relax
    \else\paperwidth\fi}{1.2pt}}}

% \titlepage inside \begin{frame}[plain,noframenumbering]
\setbeamertemplate{title page}{%
  \vfill
  {\LARGE\bfseries\inserttitle}\par
  \ifx\insertsubtitle\@empty\else\vspace{0.4em}{\large\color{mute}\insertsubtitle}\par\fi
  \vspace{1em}
  {\large\insertauthor}\par\vspace{0.3em}
  \muted{\insertdate}
  \vfill}

\setbeamertemplate{section page}{%
  \vfill{\color{mute}\small\ifaaron@zh 第 \insertsectionnumber\ 部分\else Part \insertsectionnumber\fi}\par\vspace{0.3em}
  {\LARGE\bfseries\insertsectionhead}\par\vfill}
\AtBeginSection{\begin{frame}[plain,noframenumbering]\sectionpage\end{frame}}

% Theorems and proofs: same left bars as the documents. Kind is picked by
% environment hooks; bodies upright, numbers omitted on slides.
\newcommand{\aaron@thmbar}{1.6pt}
\newcommand{\aaron@thmcolor}{accent}
\newcommand{\aaron@thmlabel}{accent}
\def\aaron@softbar{\def\aaron@thmcolor{accentsoft}}
\def\aaron@asidebar{\def\aaron@thmbar{1pt}\def\aaron@thmcolor{asidebar}\def\aaron@thmlabel{ink}}
\AddToHook{env/definition/begin}{\aaron@softbar}
\AddToHook{env/definitions/begin}{\aaron@softbar}
\AddToHook{env/example/begin}{\aaron@asidebar}
\AddToHook{env/examples/begin}{\aaron@asidebar}
\setbeamertemplate{theorem begin}{%
  \normalfont
  \begin{tcolorbox}[aaron/bar={\aaron@thmbar}{\aaron@thmcolor}, before skip=0.6em, after skip=0.6em]%
  {\bfseries\color{\aaron@thmlabel}\inserttheoremname
   \ifx\inserttheoremaddition\@empty\else{\mdseries\color{mute}\ (\inserttheoremaddition)}\fi.}\enspace}
\setbeamertemplate{theorem end}{\end{tcolorbox}}
\setbeamertemplate{proof begin}{%
  \begin{tcolorbox}[aaron/bar={0.8pt}{rule}, before skip=0.6em, after skip=0.6em]%
  {\bfseries\color{mute}\insertproofname}\enspace}
\setbeamertemplate{proof end}{\end{tcolorbox}}
\setbeamertemplate{qed symbol}{\textcolor{mute}{$\square$}}

% Centered single-line divider, e.g. \dividerframe{Appendix}
\newcommand{\dividerframe}[1]{%
  \begin{frame}[plain,noframenumbering]\vfill\centering{\LARGE\bfseries #1}\vfill\end{frame}}

% Full-bleed accent frame for one message, e.g. \standoutframe{Questions?}
\newcommand{\standoutframe}[1]{{%
  \setbeamercolor{background canvas}{bg=accent}%
  \begin{frame}[plain,noframenumbering]\vfill\centering
    {\color{white}\LARGE\bfseries #1\par}\vfill
  \end{frame}}}

% Discussion prompt: \q{...}
\newcommand{\q}[1]{\par\vspace{0.4em}{\color{accent}\bfseries Q:\ }#1}

\endinput

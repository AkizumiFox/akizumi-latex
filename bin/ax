#!/usr/bin/env python3
"""ax -- start and build LaTeX projects on the akizumi-latex templates.

  ax new [KIND] [DIR] [opts] start a project: hw, note, exam, slides, book, paper
                             (asks for anything left out)
  ax build [FILE]            compile once; the PDF is replaced only on success
  ax watch [FILE]            recompile on every save and keep the viewer open
  ax both [FILE]             problem sheet and answer key (hw, exam)
  ax doctor                  check the toolchain, fonts and template versions
  ax freeze                  copy the pinned template files into the project
  ax upgrade                 move the project to the newest template version
  ax pack                    zip the project for Overleaf (compiler: XeLaTeX)

Each project records its template version in .ax.json. Its latexmkrc asks
`ax texinputs` for that version, so editors that call latexmk directly build
against the same files as `ax build`.
"""

import argparse
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SKELETONS = REPO / "skeletons"
WINDOWS = os.name == "nt"
MACOS = sys.platform == "darwin"


def _cache_root():
    # Must match the Perl in LATEXMKRC below.
    if MACOS:
        return Path.home() / "Library" / "Caches" / "ax"
    if WINDOWS:
        base = os.environ.get("LOCALAPPDATA") or str(Path.home() / "AppData" / "Local")
        return Path(base) / "ax" / "Cache"
    return Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "ax"


def _config_dir():
    if WINDOWS:
        base = os.environ.get("APPDATA") or str(Path.home() / "AppData" / "Roaming")
        return Path(base) / "ax"
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ax"


CACHE = _cache_root()
CONFIG_DIR = _config_dir()
USER_CONFIG = CONFIG_DIR / "config.json"
AX = Path(__file__).resolve()
# How to run this script from any shell; Windows ignores the shebang.
AX_CMD = '"%s" "%s"' % (sys.executable, AX)
PROJECT_CONFIG = ".ax.json"
# Template file names; versions before v0.6 used the aaron- prefix.
TEMPLATE_GLOBS = ("akizumi-*.sty", "akizumi-*.cls", "beamerthemeAkizumi.sty",
                  "aaron-*.sty", "aaron-*.cls", "beamerthemeAaron.sty")
TIMEOUT = 600  # seconds per latexmk run

KINDS = {
    "hw": "akizumi-hw",
    "note": "akizumi-note",
    "exam": "akizumi-exam",
    "book": "akizumi-book",
    "slides": "beamer",
    "paper": "article",
}

LATEXMKRC = r"""# Written by ax. Builds into build/; `ax build` copies the PDF out only when
# the run succeeds. No machine-specific paths: the same file works on macOS,
# Linux and Windows.
$pdf_mode = @PDF_MODE@;
$out_dir = 'build';
$aux_dir = 'build';
# SyncTeX: jump between PDF and source (Skim, SumatraPDF, Zathura, editors).
push @extra_xelatex_options, '-synctex=1';
push @extra_pdflatex_options, '-synctex=1';

# Template version pinned in .ax.json, unpacked in ax's cache.
my $ax_pin = '';
if (open(my $fh, '<', '.ax.json')) {
  local $/; my $json = <$fh>; close $fh;
  ($ax_pin) = $json =~ /"template"\s*:\s*"([^"]+)"/;
}
if ($ax_pin && $ax_pin !~ /^(latest|frozen)$/) {
  my $cache = $^O eq 'darwin'  ? "$ENV{HOME}/Library/Caches/ax"
            : $^O eq 'MSWin32' ? "$ENV{LOCALAPPDATA}/ax/Cache"
            : ($ENV{XDG_CACHE_HOME} || "$ENV{HOME}/.cache") . "/ax";
  my $dir = "$cache/$ax_pin";
  # First build of this version on this machine: ax unpacks it.
  if (!-e "$dir/akizumi-core.sty" && !-e "$dir/aaron-core.sty") { my $out = `ax texinputs`; }
  ensure_path('TEXINPUTS', "$dir//");
}

# macOS only: TeX Live's biber does not start with current Command Line Tools.
$biber = "'$ENV{HOME}/bin/biber' %O %S" if $^O eq 'darwin' && -x "$ENV{HOME}/bin/biber";
$pdf_previewer = 'open -a Skim' if $^O eq 'darwin' && -d '/Applications/Skim.app';
"""

# Cursor / VS Code (LaTeX Workshop): build with latexmk so latexmkrc decides
# the engine; a global pdflatex recipe would otherwise fail on XeLaTeX files.
EDITOR_SETTINGS = {
    "latex-workshop.latex.tools": [
        {"name": "latexmk-ax", "command": "latexmk",
         "args": ["-interaction=nonstopmode", "-file-line-error", "%DOC%"]}
    ],
    "latex-workshop.latex.recipes": [
        {"name": "latexmk (ax)", "tools": ["latexmk-ax"]}
    ],
    "latex-workshop.latex.recipe.default": "latexmk (ax)",
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
}

GITIGNORE = """\
build/
*.aux
*.log
*.fls
*.fdb_latexmk
*.xdv
*.synctex.gz
"""


# ---------- small helpers ----------

def write_build_files(target, kind):
    """latexmkrc and Cursor / VS Code settings; ax new and ax upgrade."""
    target = Path(target)
    (target / "latexmkrc").write_text(
        LATEXMKRC.replace("@PDF_MODE@", "1" if kind == "paper" else "5"))
    (target / ".vscode").mkdir(exist_ok=True)
    (target / ".vscode" / "settings.json").write_text(
        json.dumps(EDITOR_SETTINGS, indent=2) + "\n")


def copy_pdf(src, dest):
    """Replace dest with src in one step, so a viewer never sees half a file.
    Returns False when dest is locked (Windows viewers such as Acrobat)."""
    fd, tmp = tempfile.mkstemp(dir=str(Path(dest).parent), prefix=".ax-", suffix=".pdf")
    os.close(fd)
    shutil.copyfile(src, tmp)
    try:
        os.replace(tmp, dest)
        return True
    except PermissionError:
        os.unlink(tmp)
        return False


def die(msg):
    print(f"ax: {msg}", file=sys.stderr)
    sys.exit(1)


def git(*args):
    return subprocess.run(["git", "-C", str(REPO), *args],
                          capture_output=True, text=True)


def template_tags():
    """Template versions, newest first."""
    out = git("tag", "--list", "v*", "--sort=-v:refname").stdout
    return [t for t in out.split() if t]


def load_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}


def project_config():
    return load_json(PROJECT_CONFIG)


def save_project_config(cfg):
    Path(PROJECT_CONFIG).write_text(json.dumps(cfg, indent=2) + "\n")


def template_dir(pin):
    """Directory holding the template files for a pinned version, or None to
    use whatever is installed (pin 'latest') or the project's own copies
    (pin 'frozen')."""
    if not pin or pin in ("latest", "frozen"):
        return None
    target = CACHE / pin
    if (target / "akizumi-core.sty").exists() or (target / "aaron-core.sty").exists():
        return target
    if git("rev-parse", "-q", "--verify", f"refs/tags/{pin}").returncode:
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = Path(tempfile.mkdtemp(prefix=f".{pin}-", dir=CACHE))
    archive = subprocess.run(["git", "-C", str(REPO), "archive", pin],
                             capture_output=True)
    if archive.returncode:
        return None
    with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as t:
        try:
            t.extractall(tmp, filter="data")
        except TypeError:  # Python before 3.12
            t.extractall(tmp)
    if target.exists():
        shutil.rmtree(tmp)
    else:
        tmp.rename(target)
    return target


def template_files(directory):
    files = []
    for pattern in TEMPLATE_GLOBS:
        files += sorted(Path(directory).glob(pattern))
    return files


def main_file(arg):
    name = arg or project_config().get("main", "main.tex")
    path = Path(name if name.endswith(".tex") else name + ".tex")
    if not path.exists():
        die(f"{path} not found (run inside a project, or name the .tex file)")
    return path


# ---------- ax new ----------

KIND_HELP = {
    "hw": "homework: problems, solutions, ax both",
    "note": "lecture notes / write-up",
    "exam": "exam or quiz on the exam class",
    "slides": "beamer slides",
    "book": "thesis or long notes with chapters",
    "paper": "paper body for a venue template (pdfLaTeX, akizumi-math only)",
}


def ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        return ""


def user_preamble(kind):
    """The user's own preamble lines for a new project: preamble.tex (every
    kind except paper, which follows a venue template) and preamble-KIND.tex,
    both in the config directory. Copied into main.tex, so the project stays
    self-contained."""
    parts = []
    names = ([] if kind == "paper" else ["preamble.tex"]) + [f"preamble-{kind}.tex"]
    for name in names:
        f = CONFIG_DIR / name
        if f.exists():
            text = f.read_text().strip()
            if text:
                parts.append(f"% --- from {name} ---\n{text}")
    return "\n".join(parts)


def cmd_new(a):
    user = load_json(USER_CONFIG)
    interactive = sys.stdin.isatty()
    if a.kind is None:
        if not interactive:
            die("ax new needs a KIND: " + ", ".join(KINDS))
        names = list(KINDS)
        for i, k in enumerate(names, 1):
            print(f"  {i}. {k:<7} {KIND_HELP[k]}")
        choice = ask("Kind [1-6]: ")
        if choice.isdigit() and 1 <= int(choice) <= len(names):
            a.kind = names[int(choice) - 1]
        elif choice in KINDS:
            a.kind = choice
        else:
            die(f"unknown kind {choice!r}")
    if a.kind not in KINDS:
        die(f"unknown kind {a.kind!r}; choose from " + ", ".join(KINDS))
    # config.json "defaults": {"slides": {"progress": true}, "note": {"layout": "margin"}}
    for key, value in user.get("defaults", {}).get(a.kind, {}).items():
        if key in ("lang", "text", "paper", "layout", "course", "author", "id"):
            if getattr(a, key, None) is None:
                setattr(a, key, value)
        elif key in ("bib", "progress", "git") and value and not getattr(a, key):
            setattr(a, key, True)
    if a.dir is None:
        if not interactive:
            die("ax new needs a DIR")
        a.dir = ask("Directory: ") or die("no directory given")
    target = Path(a.dir)
    if target.exists() and any(target.iterdir()) and not a.force:
        die(f"{target} exists and is not empty (use --force)")

    title = a.title
    if title is None and a.kind != "hw" and interactive:
        title = ask("Title: ") or None
    if a.kind == "hw" and a.course is None and interactive:
        a.course = ask("Course (optional): ") or None
    author = a.author or user.get("author") or git("config", "user.name").stdout.strip()
    student_id = a.id or user.get("id")
    lang = a.lang or user.get("lang", "en")
    tags = template_tags()
    pin = a.pin or (tags[0] if tags else "latest")

    if a.bib and a.kind in ("hw", "exam"):
        print("ax: --bib is ignored for hw and exam", file=sys.stderr)
        a.bib = False

    # class options
    opts = []
    if a.kind == "slides":
        opts = ["aspectratio=169", "11pt"]
    elif a.kind != "paper":
        if lang != "en":
            opts.append(f"lang={lang}")
        for key in ("text", "paper", "layout"):
            value = getattr(a, key)
            if value:
                opts.append(f"{key}={value}")
        if a.bib:
            opts.append("bib=refs.bib")

    lines = ["% !TEX program = " + ("pdflatex" if a.kind == "paper" else "xelatex")]
    cls = KINDS[a.kind]
    lines.append(f"\\documentclass{'[' + ', '.join(opts) + ']' if opts else ''}{{{cls}}}")

    if a.kind == "slides":
        theme_opts = [f"lang={lang}"] if lang != "en" else []
        if a.progress:
            theme_opts.append("progress")
        lines.append(f"\\usetheme{'[' + ', '.join(theme_opts) + ']' if theme_opts else ''}{{Akizumi}}")
        if a.bib:
            lines += ["\\usepackage[backend=biber, style=numeric-comp, sorting=none]{biblatex}",
                      "\\addbibresource{refs.bib}"]
    elif a.kind == "paper":
        lines += ["\\usepackage{akizumi-math}",
                  "\\usepackage{hyperref}",
                  "\\usepackage[capitalise, noabbrev]{cleveref}"]
        if a.bib:
            lines.append("\\usepackage[numbers]{natbib}")

    setup = []
    if a.course:
        setup.append(f"kicker={{{a.course}}}" if a.kind == "book" else f"course={{{a.course}}}")
    if a.kind == "hw":
        if a.number:
            setup.append(f"number={a.number}")
        if a.due:
            setup.append(f"due={a.due}")
        if student_id:
            setup.append(f"id={student_id}")
    if a.kind == "slides":
        setup = [f"kicker={{{a.course}}}"] if a.course else []
    if setup and a.kind != "paper":
        lines.append("\\akizumisetup{" + ", ".join(setup) + "}")
    if title:
        lines.append(f"\\title{{{title}}}")
    if author:
        lines.append(f"\\author{{{author}}}")
    extra = "" if a.no_preamble else user_preamble(a.kind)
    if extra:
        lines += ["", extra]

    body = (SKELETONS / f"{a.kind}.tex").read_text()
    bibend = ""
    if a.bib:
        bibend = {
            "slides": "\\begin{frame}[allowframebreaks]{References}\n"
                      "  \\printbibliography\n\\end{frame}\n",
            "paper": "\\bibliographystyle{plainnat}\n\\bibliography{refs}\n\n",
        }.get(a.kind, "\\printbibliography\n\n")
    body = body.replace("<<BIBEND>>", bibend)

    target.mkdir(parents=True, exist_ok=True)
    (target / "figures").mkdir(exist_ok=True)
    (target / "figures" / ".gitkeep").touch()
    (target / "main.tex").write_text("\n".join(lines) + "\n\n" + body)
    write_build_files(target, a.kind)
    (target / ".gitignore").write_text(GITIGNORE)
    if a.bib:
        (target / "refs.bib").write_text("% BibTeX entries go here.\n")
    (target / PROJECT_CONFIG).write_text(json.dumps(
        {"kind": a.kind, "main": "main.tex", "template": pin}, indent=2) + "\n")
    template_dir(pin)  # fetch the pinned version now, while the repo is at hand
    if a.git:
        run = lambda *c: subprocess.run(["git", "-C", str(target), *c], capture_output=True)
        run("init", "-q")
        run("add", "-A")
        run("commit", "-q", "-m", f"Start {a.kind} project")

    print(f"created {target}/ ({a.kind}, templates {pin})")
    print(f"  cd {target} && ax watch")


# ---------- building ----------

ERROR_LINE = re.compile(r"^(?P<file>[^\s:][^:]*\.(?:tex|sty|cls|bib)):(?P<line>\d+): (?P<msg>.*)$")


def first_error(log_path):
    """First error in a LaTeX log as (location, message, context lines)."""
    try:
        lines = Path(log_path).read_text(errors="replace").splitlines()
    except OSError:
        return None
    for i, line in enumerate(lines):
        m = ERROR_LINE.match(line)
        if m or line.startswith("! "):
            location = f"{m['file']}:{m['line']}" if m else ""
            message = m["msg"] if m else line[2:]
            # TeX shows the offending source line split at the error point:
            # "l.11 \undefinedmacro" then the rest of the line. Keep those two
            # and drop the help text that follows.
            context = []
            for j in range(i + 1, min(i + 15, len(lines))):
                if lines[j].startswith("l."):
                    context = [lines[j]]
                    if j + 1 < len(lines) and lines[j + 1].strip():
                        context.append(lines[j + 1])
                    break
            if not location:
                for c in context:
                    lm = re.match(r"l\.(\d+)", c)
                    if lm:
                        location = f"line {lm.group(1)}"
            return location, message, context
    return None


def warnings_summary(log_path):
    try:
        log = Path(log_path).read_text(errors="replace")
    except OSError:
        return []
    found = []
    refs = len(re.findall(r"Reference `[^']*' on page \d+ undefined", log))
    cites = len(re.findall(r"Citation `[^']*' on page \d+ undefined", log)) + \
        len(re.findall(r"Citation '[^']*' on page \d+ undefined", log))
    overfull = len(re.findall(r"^Overfull \\hbox", log, re.M))
    if refs:
        found.append(f"{refs} undefined reference(s)")
    if cites:
        found.append(f"{cites} undefined citation(s)")
    if overfull:
        found.append(f"{overfull} overfull line(s)")
    return found


def latexmk(main, jobname=None, pretex=None, clean_first=False):
    base = ["latexmk", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error"]
    if jobname:
        base.append(f"-jobname={jobname}")
    if pretex:
        base.append(f"-usepretex={pretex}")
    if clean_first:
        subprocess.run(base[:1] + ["-C"] + base[4:] + [str(main)], capture_output=True)
    try:
        return subprocess.run(base + [str(main)], capture_output=True, text=True,
                              errors="replace", timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        die(f"gave up after {TIMEOUT} s; is something waiting for input?")


def safe_build(main, jobname=None, pretex=None, quiet=False):
    """Compile into build/ and copy the PDF next to the source only on success.
    Returns True on success."""
    job = jobname or main.stem
    result = latexmk(main, jobname, pretex)
    output = result.stdout + result.stderr
    if result.returncode and "error in previous invocation" in output:
        # latexmk remembers a failed run (biber, say) and refuses to retry
        result = latexmk(main, jobname, pretex, clean_first=True)
        output = result.stdout + result.stderr

    built = Path("build") / f"{job}.pdf"
    log = Path("build") / f"{job}.log"
    if result.returncode == 0 and built.exists():
        dest = Path(f"{job}.pdf")
        if not copy_pdf(built, dest):
            print(f"ok  {built}  ({dest} is open in a viewer that locks it; "
                  f"close it or open {built} instead)")
            return True
        if not quiet:
            notes = warnings_summary(log)
            print(f"ok  {dest}" + (f"  ({'; '.join(notes)})" if notes else ""))
        return True

    print(f"failed  {main}" + (f" ({job})" if jobname else ""), file=sys.stderr)
    if not print_error(log):
        tail = [l for l in output.splitlines() if re.search(r"error|failed", l, re.I)]
        for l in tail[-5:]:
            print(f"  {l.strip()}", file=sys.stderr)
    if Path(f"{job}.pdf").exists():
        print(f"  kept the previous {job}.pdf", file=sys.stderr)
    return False


def print_error(log):
    err = first_error(log)
    if not err:
        return False
    location, message, context = err
    print(f"  {location}: {message}" if location else f"  {message}", file=sys.stderr)
    for c in context:
        print(f"    {c}", file=sys.stderr)
    return True


def cmd_explain(a):
    """Called by latexmk after a failed run in ax watch."""
    if not print_error(Path("build") / f"{a.job}.log"):
        print("  no LaTeX error in the log; see the latexmk output above", file=sys.stderr)


def cmd_copypdf(a):
    """Called by latexmk after a successful run in ax watch."""
    if not copy_pdf(a.src, a.dest):
        print(f"  {a.dest} is locked by a viewer; the new PDF is {a.src}", file=sys.stderr)


def cmd_build(a):
    sys.exit(0 if safe_build(main_file(a.file)) else 1)


def cmd_watch(a):
    main = main_file(a.file)
    print("watching; Ctrl-C to stop")
    cmd = ["latexmk", "-pvc", "-interaction=nonstopmode", "-file-line-error",
           "-e", f"$success_cmd = q({AX_CMD} copypdf %D %R.pdf);",
           "-e", f"$failure_cmd = q({AX_CMD} explain %R);", str(main)]
    try:
        sys.exit(subprocess.call(cmd))
    except KeyboardInterrupt:
        pass


def cmd_both(a):
    main = main_file(a.file)
    kind = project_config().get("kind")
    if kind and kind not in ("hw", "exam"):
        die("ax both is for hw and exam projects")
    ok = safe_build(main, pretex=r"\def\akizumisolutions{false}")
    ok = safe_build(main, jobname=f"{main.stem}-solutions",
                    pretex=r"\def\akizumisolutions{true}") and ok
    sys.exit(0 if ok else 1)


# ---------- versions ----------

def cmd_texinputs(a):
    d = template_dir(project_config().get("template"))
    if d:
        print(d)


def cmd_freeze(a):
    cfg = project_config()
    if not cfg:
        die("not in an ax project (no .ax.json)")
    if cfg.get("template") == "frozen":
        die("already frozen")
    source = template_dir(cfg.get("template")) or REPO
    for f in template_files(source):
        shutil.copy2(f, f.name)
        print(f"  copied {f.name}")
    cfg["frozen_from"] = cfg.get("template")
    cfg["template"] = "frozen"
    save_project_config(cfg)
    print("frozen: this project now builds from its own copies")


def cmd_upgrade(a):
    cfg = project_config()
    if not cfg:
        die("not in an ax project (no .ax.json)")
    tags = template_tags()
    if not tags:
        die("the template repo has no version tags")
    if cfg.get("template") == "frozen":
        for f in template_files("."):
            f.unlink()
            print(f"  removed copy {f.name}")
        cfg.pop("frozen_from", None)
    old = cfg.get("template")
    cfg["template"] = tags[0]
    save_project_config(cfg)
    new_dir = template_dir(tags[0])
    if new_dir and (new_dir / "akizumi-core.sty").exists():
        rename_aaron(Path(cfg.get("main", "main.tex")).parent)
    rc = Path("latexmkrc")
    if not rc.exists() or rc.read_text().startswith("# Written by ax"):
        write_build_files(".", cfg.get("kind"))
        print("  refreshed latexmkrc and .vscode/settings.json")
    print(f"templates {old} -> {tags[0]}; check with ax build")


def rename_aaron(root):
    """v0.6 renamed the package from aaron to akizumi: rewrite the old names
    in the project's .tex files. 'Aaron Lin' in \\author is left alone."""
    swaps = [(re.compile(r"(\\usetheme(?:\[[^\]]*\])?)\{Aaron\}"), r"\1{Akizumi}"),
             (re.compile(r"beamerthemeAaron"), "beamerthemeAkizumi"),
             (re.compile(r"aaron(?=[-/@a-z])"), "akizumi")]
    for tex in sorted(Path(root).rglob("*.tex")):
        if "build" in tex.parts:
            continue
        text = tex.read_text()
        new = text
        for pattern, repl in swaps:
            new = pattern.sub(repl, new)
        if new != text:
            tex.write_text(new)
            print(f"  renamed aaron -> akizumi in {tex}")


# ---------- ax pack ----------

def cmd_pack(a):
    cfg = project_config()
    if not cfg:
        die("not in an ax project (no .ax.json)")
    name = Path.cwd().name
    out = Path(f"{name}-overleaf.zip")
    skip_dirs = {"build", ".git", ".vscode"}
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        for path in sorted(Path(".").rglob("*")):
            if path.is_dir() or skip_dirs & set(path.parts) or path == out:
                continue
            if path.suffix == ".pdf" or path.name in (PROJECT_CONFIG, "latexmkrc"):
                continue
            z.write(path)
        if cfg.get("template") != "frozen":
            for f in template_files(template_dir(cfg.get("template")) or REPO):
                z.write(f, f.name)
        engine = 1 if cfg.get("kind") == "paper" else 5
        z.writestr("latexmkrc", f"$pdf_mode = {engine};\n")
    print(f"wrote {out}; on Overleaf set the compiler to "
          f"{'pdfLaTeX' if cfg.get('kind') == 'paper' else 'XeLaTeX'}")


# ---------- ax doctor ----------

def cmd_doctor(a):
    problems = 0

    def report(ok, label, detail=""):
        nonlocal problems
        problems += not ok
        print(f"  {'ok ' if ok else 'BAD'}  {label}" + (f"  {detail}" if detail else ""))

    def run(*cmd):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired):
            return None

    print("tools")
    for tool in ("xelatex", "latexmk", "pdflatex"):
        report(bool(shutil.which(tool)), tool, shutil.which(tool) or "not on PATH")
    r = run("biber", "--version")
    biber_ok = bool(r) and r.returncode == 0
    report(biber_ok, "biber", (r.stdout.strip().splitlines() or [""])[-1] if biber_ok else
           "fails to start; see docs/reference.md, troubleshooting")
    report(bool(shutil.which("ax")), "ax on PATH",
           "" if shutil.which("ax") else "run install.py, then open a new terminal")
    report(bool(shutil.which("git")), "git", "" if shutil.which("git") else "needed for template versions")

    print("templates")
    r = run("kpsewhich", "akizumi-core.sty")
    found = r.stdout.strip() if r else ""
    report(bool(found), "akizumi-core.sty installed", found or "run install.py")
    tags = template_tags()
    report(bool(tags), "version tags", ", ".join(tags[:5]) or "none: git tag the repo")

    print("fonts")
    for f in ("Lato-Regular.ttf", "NewCM10-Book.otf", "bboldx.sty"):
        r = run("kpsewhich", f)
        report(bool(r and r.stdout.strip()), f)
    # First choice per system; akizumi-core falls back along the same chain.
    if MACOS:
        families = ("PingFang TC", "Songti TC")
    elif WINDOWS:
        families = ("Microsoft JhengHei", "MingLiU")
    else:
        families = ("Noto Sans CJK TC", "Noto Serif CJK TC")
    if shutil.which("fc-list"):
        for family in families + ("JetBrains Mono",):
            r = run("fc-list", family, "family")
            ok = bool(r and r.stdout.strip())
            print(f"  {'ok ' if ok else '-- '}  {family}" + ("" if ok else
                  "  not installed; falls back (see docs/reference.md)"))
    else:
        print("  --   system fonts not checked (no fc-list); CJK falls back automatically")

    cfg = project_config()
    if cfg:
        print("this project")
        pin = cfg.get("template")
        if pin == "frozen":
            report(bool(template_files(".")), "frozen copies present",
                   f"from {cfg.get('frozen_from')}")
        else:
            d = template_dir(pin)
            report(pin == "latest" or bool(d), f"templates {pin}", str(d or "installed version"))
            if tags and pin not in ("latest", tags[0]):
                print(f"       newer templates: {tags[0]} (ax upgrade)")
    sys.exit(1 if problems else 0)


def cmd_config(a):
    print(f"config directory  {CONFIG_DIR}")
    print(f"  config.json     {'present' if USER_CONFIG.exists() else 'not created'}")
    for name in ["preamble.tex"] + [f"preamble-{k}.tex" for k in KINDS]:
        if (CONFIG_DIR / name).exists():
            print(f"  {name:<20} used by ax new")
    print(f"template cache    {CACHE}")
    print(f"template repo     {REPO}")


def cmd_selftest(a):
    """Rebuild the examples and build one fresh project of each kind."""
    failed = []
    if a.part in ("all", "examples"):
        ex = REPO / "examples"
        shutil.rmtree(ex / "build", ignore_errors=True)
        for name in ("hw", "note", "exam", "slides", "book"):
            r = subprocess.run(["latexmk", "-r", "latexmkrc", "-halt-on-error",
                                "-interaction=nonstopmode", f"{name}.tex"],
                               cwd=ex, capture_output=True)
            ok = r.returncode == 0
            print(f"example {name:<7} {'ok' if ok else 'FAILED'}", flush=True)
            if not ok:
                failed.append(name)
                print_error(ex / "build" / f"{name}.log")
    if a.part in ("all", "projects"):
        tmp = Path(tempfile.mkdtemp(prefix="ax-selftest-"))
        ax = [sys.executable, str(AX)]
        for kind in KINDS:
            d = tmp / f"t-{kind}"
            r = subprocess.run(ax + ["new", kind, str(d), "--title", "Test", "--no-preamble"],
                               stdin=subprocess.DEVNULL, capture_output=True, text=True)
            if r.returncode == 0:
                r = subprocess.run(ax + ["build"], cwd=d, capture_output=True, text=True)
            ok = r.returncode == 0
            print(f"project {kind:<7} {'ok' if ok else 'FAILED'}", flush=True)
            if not ok:
                failed.append(kind)
                print(r.stdout + r.stderr)
        r = subprocess.run(ax + ["both"], cwd=tmp / "t-hw", capture_output=True, text=True)
        ok = r.returncode == 0 and (tmp / "t-hw" / "main-solutions.pdf").exists()
        print(f"project both    {'ok' if ok else 'FAILED'}", flush=True)
        if not ok:
            failed.append("both")
            print(r.stdout + r.stderr)
        shutil.rmtree(tmp, ignore_errors=True)
    sys.exit(1 if failed else 0)


# ---------- command line ----------

HELP_COMMANDS = """\
指令（new、doctor 以外都在專案資料夾裡執行）：
  new       建立新專案（ax new --help 看選項）
  watch     存檔就重編
  build     編譯一次；失敗時指出錯在哪一行，保留上一份 PDF
  both      作業／考卷：題目卷和解答各一份
  doctor    檢查工具、字型、模板版本
  upgrade   改用最新的模板版本
  freeze    把模板檔複製進專案，從此不依賴模板 repo
  pack      打包成 zip 上傳 Overleaf
  config    顯示設定檔、preamble、快取的位置
  selftest  重編所有範例、建立並編譯每種專案（改模板後用）

"""

HELP_EXAMPLES = """\
範例：
  ax new                                  用選單選種類、資料夾、標題
  ax new hw ode-hw3 --course 常微分方程 --number 3
  ax new note rl4 --title "Self-Predictive Representations" --bib
  ax new slides talk --title "The JEPA Flood" --course "ELSA Lab" --progress
  cd ode-hw3 && ax watch                  存檔就重編

說明文件：README.md、docs/reference.md（在模板 repo 裡）
"""


def main():
    p = argparse.ArgumentParser(
        prog="ax", usage="ax [-h] [--version] 指令 ...", description="建立與編譯 akizumi-latex 專案。",
        epilog=HELP_COMMANDS + HELP_EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version",
                   version=f"ax（模板 {', '.join(template_tags()[:1]) or '未打版本'}）")
    # The command list is written out in HELP_COMMANDS; argparse's own list
    # would also show the internal ones (texinputs, explain).
    sub = p.add_subparsers(dest="command", required=True, metavar="指令",
                           help=argparse.SUPPRESS)

    n = sub.add_parser("new", help="建立新專案",
                       description="建立新專案。沒給的種類、資料夾、標題會互動式詢問。",
                       epilog=HELP_EXAMPLES, formatter_class=argparse.RawDescriptionHelpFormatter)
    n.add_argument("kind", nargs="?", metavar="種類", help=" / ".join(KINDS))
    n.add_argument("dir", nargs="?", metavar="資料夾")
    n.add_argument("--title", help="標題（作業不用，會寫成「作業 N」）")
    n.add_argument("--author", help="作者，預設取自 ~/.config/ax/config.json")
    n.add_argument("--course", help="課名；書和簡報放在標題上方")
    n.add_argument("--number", help="作業編號")
    n.add_argument("--due", help="作業繳交期限")
    n.add_argument("--id", help="學號，預設取自 config.json")
    n.add_argument("--lang", choices=["en", "zh"], help="主語言，預設取自 config.json")
    n.add_argument("--text", choices=["serif", "sans"], help="內文字型（預設 serif）")
    n.add_argument("--paper", choices=["a4", "letter", "pad"], help="紙張；pad 是平板閱讀版面")
    n.add_argument("--layout", choices=["normal", "margin"], help="margin：右側寬邊欄放 sidenote")
    n.add_argument("--bib", action="store_true", help="加上 refs.bib 和參考文獻")
    n.add_argument("--progress", action="store_true", help="簡報底部加進度條")
    n.add_argument("--pin", help="模板版本，預設最新的 tag")
    n.add_argument("--git", action="store_true", help="建立 git repo 並做第一個 commit")
    n.add_argument("--no-preamble", action="store_true",
                   help="不加入設定資料夾裡的 preamble.tex / preamble-種類.tex")
    n.add_argument("--force", action="store_true", help="資料夾已存在且不是空的也照樣建立")
    n.set_defaults(func=cmd_new)

    for name, func, text in (("build", cmd_build, "編譯一次；失敗時保留上一份 PDF"),
                             ("watch", cmd_watch, "存檔就重編"),
                             ("both", cmd_both, "作業／考卷：題目卷和解答各一份")):
        c = sub.add_parser(name, help=text, description=text)
        c.add_argument("file", nargs="?", metavar="檔案", help="預設是 main.tex")
        c.set_defaults(func=func)
    for name, func, text in (("doctor", cmd_doctor, "檢查工具、字型、模板版本"),
                             ("upgrade", cmd_upgrade, "改用最新的模板版本"),
                             ("freeze", cmd_freeze, "把模板檔複製進專案，從此不依賴模板 repo"),
                             ("pack", cmd_pack, "打包成 zip 上傳 Overleaf")):
        sub.add_parser(name, help=text, description=text).set_defaults(func=func)

    sub.add_parser("config", help="設定檔位置", description="顯示設定檔、preamble、快取的位置").set_defaults(func=cmd_config)
    t = sub.add_parser("selftest", help="測試模板與 ax", description="重編所有範例、建立並編譯每種專案")
    t.add_argument("part", nargs="?", choices=["all", "examples", "projects"], default="all")
    t.set_defaults(func=cmd_selftest)

    # internal: latexmkrc asks for the pinned template path; ax watch explains
    # failures and copies the PDF out after successful runs
    sub.add_parser("texinputs").set_defaults(func=cmd_texinputs)
    c = sub.add_parser("copypdf")
    c.add_argument("src")
    c.add_argument("dest")
    c.set_defaults(func=cmd_copypdf)
    e = sub.add_parser("explain")
    e.add_argument("job")
    e.set_defaults(func=cmd_explain)

    if len(sys.argv) == 1:
        p.print_help()
        sys.exit(0)
    a = p.parse_args()
    a.func(a)


if __name__ == "__main__":
    main()

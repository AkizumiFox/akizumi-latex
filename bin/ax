#!/usr/bin/env python3
"""ax -- start and build LaTeX projects on the akizumi-latex templates.

Each project records its template version in .ax.json; its latexmkrc reads
that file and finds the version in ax's cache, so editors that call latexmk
directly build against the same files as `ax build`. Runs on macOS, Linux and
Windows (bin/ax.cmd). Messages are in Traditional Chinese or English (see
ui_language).
"""

import argparse
import difflib
import io
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
import unicodedata
import webbrowser
import zipfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SKELETONS = REPO / "skeletons"
WINDOWS = os.name == "nt"
MACOS = sys.platform == "darwin"


def _cache_root():
    # Must match the Perl in LATEXMKRC below.
    if MACOS:
        return Path.home() / "Library" / "Caches" / "ax"
    if WINDOWS:
        base = os.environ.get("LOCALAPPDATA") or str(Path.home() / "AppData" / "Local")
        return Path(base) / "ax" / "Cache"
    return Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "ax"


def _config_dir():
    if WINDOWS:
        base = os.environ.get("APPDATA") or str(Path.home() / "AppData" / "Roaming")
        return Path(base) / "ax"
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ax"


CACHE = _cache_root()
CONFIG_DIR = _config_dir()
USER_CONFIG = CONFIG_DIR / "config.json"
AX = Path(__file__).resolve()
# How to run this script from any shell; Windows ignores the shebang.
AX_CMD = '"%s" "%s"' % (sys.executable, AX)
PROJECT_CONFIG = ".ax.json"
# Template file names; versions before v0.6 used the aaron- prefix.
TEMPLATE_GLOBS = ("akizumi-*.sty", "akizumi-*.cls", "beamerthemeAkizumi.sty",
                  "aaron-*.sty", "aaron-*.cls", "beamerthemeAaron.sty")
TIMEOUT = 600  # seconds per latexmk run

KINDS = {
    "hw": "akizumi-hw",
    "note": "akizumi-note",
    "exam": "akizumi-exam",
    "book": "akizumi-book",
    "slides": "beamer",
    "paper": "article",
}


def _system_language():
    """'zh' if the system's language is Chinese, else 'en'."""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var, "")
        if value:
            if value.lower().startswith("zh"):
                return "zh"
            if not value.upper().startswith(("C", "POSIX", "EN")):
                return "en"
            break
    try:
        if MACOS:
            # Terminal often sets LANG=en_US even when the Mac is in Chinese;
            # the first entry of the system's preferred languages decides.
            out = subprocess.run(["defaults", "read", "-g", "AppleLanguages"],
                                 capture_output=True, text=True, timeout=2).stdout
            first = re.search(r'"?([A-Za-z-]+)"?', out.strip("()\n \t"))
            return "zh" if first and first.group(1).lower().startswith("zh") else "en"
        if WINDOWS:
            import ctypes
            lang_id = ctypes.windll.kernel32.GetUserDefaultUILanguage()
            return "zh" if lang_id & 0x3FF == 0x04 else "en"
    except Exception:
        pass
    return "en"


def ui_language():
    """Language for ax's messages, and where the choice came from:
    AX_LANG, then config.json "ui", then the system language."""
    env = os.environ.get("AX_LANG", "").lower()
    if env in ("zh", "en"):
        return env, "AX_LANG"
    try:
        ui = json.loads(USER_CONFIG.read_text(encoding="utf-8")).get("ui")
    except (OSError, ValueError, AttributeError):
        ui = None
    if ui in ("zh", "en"):
        return ui, 'config.json "ui"'
    return _system_language(), "system"


UI, UI_SOURCE = ui_language()


def T(zh, en):
    """The message in the interface language."""
    return zh if UI == "zh" else en


KIND_NAME = {"hw": T("作業", "homework"), "note": T("講義", "notes"), "exam": T("考卷", "exam"),
             "book": T("論文／書", "thesis / book"), "slides": T("簡報", "slides"),
             "paper": T("投稿論文", "paper")}
KIND_HELP = {
    "hw": T("作業：題目、解答，ax both 一次產生題目卷和解答",
            "homework: problems and solutions; ax both makes both PDFs at once"),
    "note": T("講義、筆記、報告", "lecture notes, handouts, write-ups"),
    "exam": T("考卷、小考：配分、評分表", "exams and quizzes: points, grade table"),
    "slides": T("簡報", "slides"),
    "book": T("論文、長篇講義：章、封面、每章目錄",
              "thesis, long notes: chapters, cover page, per-chapter contents"),
    "paper": T("投稿論文：會議模板（--venue）加數學巨集和寫作小工具（pdfLaTeX）",
               "paper on a venue template (--venue), with math macros and writing helpers (pdfLaTeX)"),
}
# commands shown to people; the rest are called by latexmk
PUBLIC_COMMANDS = ["new", "build", "watch", "open", "both", "count", "doctor", "upgrade",
                   "freeze", "pack", "config", "completion", "selftest", "migrate", "docs"]
NEW_OPTIONS = ["--title", "--author", "--course", "--number", "--due", "--id", "--lang", "--thmnames",
               "--text", "--paper", "--layout", "--bib", "--code", "--progress", "--venue", "--split",
               "--anonymous", "--no-anonymous", "--pin", "--git",
               "--no-preamble", "--force", "--problems"]

LATEXMKRC = r"""# Written by ax. Builds into build/; `ax build` copies the PDF out only when
# the run succeeds. No machine-specific paths: the same file works on macOS,
# Linux and Windows.
$pdf_mode = @PDF_MODE@;
$out_dir = 'build';
$aux_dir = 'build';
# SyncTeX: jump between PDF and source (Skim, SumatraPDF, Zathura, editors).
push @extra_xelatex_options, '-synctex=1';
push @extra_pdflatex_options, '-synctex=1';

# Template version pinned in .ax.json, unpacked in ax's cache.
my ($ax_pin, $ax_json) = ('', '');
if (open(my $fh, '<', '.ax.json')) {
  local $/; $ax_json = <$fh>; close $fh;
  ($ax_pin) = $ax_json =~ /"template"\s*:\s*"([^"]+)"/;
}
# "shell_escape": true in .ax.json lets LaTeX run programs (minted, svg, ...;
# ax new --code minted sets it on TeX older than 2024, whose restricted shell
# escape cannot run minted's latexminted).
if ($ax_json =~ /"shell_escape"\s*:\s*true/) {
  push @extra_xelatex_options, '-shell-escape';
  push @extra_pdflatex_options, '-shell-escape';
  push @extra_lualatex_options, '-shell-escape';
}
# "pdf": "report.pdf" in .ax.json: after a successful build the main file's
# PDF is also copied to that name (<stem>-solutions.pdf for ax both's
# solutions), as ax build and ax watch do. Editors keep showing build/main.pdf.
my ($ax_main) = $ax_json =~ /"main"\s*:\s*"([^"]+)"/;
my ($ax_pdf) = $ax_json =~ /"pdf"\s*:\s*"((?:[^"\\]|\\.)+)"/;
if ($ax_pdf) {
  $ax_pdf = eval { require JSON::PP; JSON::PP->new->utf8->allow_nonref->decode(qq("$ax_pdf")) };
  utf8::encode($ax_pdf) if defined $ax_pdf;
  $success_cmd = 'internal ax_copy_pdf %Z %R' if $ax_pdf && $ax_pdf !~ m{[/\\]};
}
sub ax_copy_pdf {
  my ($dir, $job) = @_;
  (my $stem = $ax_main || 'main.tex') =~ s/\.tex$//;
  (my $name = $ax_pdf) =~ s/\.pdf$//i;
  my $dest = $job eq $stem ? "$name.pdf" : $job eq "$stem-solutions" ? "$name-solutions.pdf" : '';
  return 0 unless $dest && -f "$dir$job.pdf";
  if ($^O eq 'MSWin32') {
    # Perl cannot name non-ASCII files there; ax copypdf can
    system('ax', 'copypdf', "$dir$job.pdf", "$job.pdf");
  } elsif (File::Copy::copy("$dir$job.pdf", "$dest.ax-tmp")) {
    rename("$dest.ax-tmp", $dest);
  }
  return 0;
}
if ($ax_pin && $ax_pin !~ /^(latest|frozen)$/) {
  my $cache = $^O eq 'darwin'  ? "$ENV{HOME}/Library/Caches/ax"
            : $^O eq 'MSWin32' ? "$ENV{LOCALAPPDATA}/ax/Cache"
            : ($ENV{XDG_CACHE_HOME} || "$ENV{HOME}/.cache") . "/ax";
  my $dir = "$cache/$ax_pin";
  # First build of this version on this machine: ax unpacks it.
  if (!-e "$dir/akizumi-core.sty" && !-e "$dir/aaron-core.sty") { my $out = `ax texinputs`; }
  ensure_path('TEXINPUTS', "$dir//");
}

# macOS only: TeX Live's biber does not start with current Command Line Tools.
$biber = "'$ENV{HOME}/bin/biber' %O %S" if $^O eq 'darwin' && -x "$ENV{HOME}/bin/biber";
$pdf_previewer = 'open -a Skim' if $^O eq 'darwin' && -d '/Applications/Skim.app';

# ---------- index (index=true) ----------
# latexmk runs the indexer for every .idx: upmendex, which sorts Chinese,
# Japanese and Korean, when installed, else makeindex. akizumi-index writes
# <name>.ist next to <name>.idx with the collation for the main language.
use File::Spec;
use File::Copy ();
$makeindex = 'internal ax_makeindex %O -o %D %S';
sub ax_makeindex {
  (my $ist = $_[-1]) =~ s/\.idx$/.ist/;
  # An index with no entries (\index but no \nota, or the other way round):
  # the indexers exit with an error on it, so write an empty .ind instead.
  if (-z $_[-1]) {
    my ($ind) = map { $_[$_ + 1] } grep { $_[$_] eq '-o' } 0 .. $#_ - 1;
    ($ind = $_[-1]) =~ s/\.idx$/.ind/ unless $ind;
    if (open(my $fh, '>', $ind)) { print $fh "\\begin{theindex}\n\n\\end{theindex}\n"; close $fh; }
    return 0;
  }
  if (grep { -f "$_/upmendex" || -f "$_/upmendex.exe" } File::Spec->path()) {
    return system('upmendex', (-f $ist ? ('-s', $ist) : ()), @_);
  }
  return system('makeindex', @_);
}
"""

# Cursor / VS Code (LaTeX Workshop): build with latexmk so latexmkrc decides
# the engine; a global pdflatex recipe would otherwise fail on XeLaTeX files.
EDITOR_SETTINGS = {
    "latex-workshop.latex.tools": [
        {"name": "latexmk-ax", "command": "latexmk",
         "args": ["-interaction=nonstopmode", "-file-line-error", "%DOC%"]}
    ],
    "latex-workshop.latex.recipes": [
        {"name": "latexmk (ax)", "tools": ["latexmk-ax"]}
    ],
    "latex-workshop.latex.recipe.default": "latexmk (ax)",
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
}


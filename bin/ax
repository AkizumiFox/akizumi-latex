# ---------- terminal output ----------
# Colour and the spinner only when writing to a terminal; NO_COLOR turns
# colour off (https://no-color.org).

for _stream in (sys.stdout, sys.stderr):
    try:
        # Windows pipes and files default to the ANSI code page, which cannot
        # hold Chinese; a console handles Unicode by itself.
        if WINDOWS and not _stream.isatty():
            _stream.reconfigure(encoding="utf-8", errors="replace")
        else:
            _stream.reconfigure(errors="replace")
    except (AttributeError, ValueError):
        pass

# Templates, skeletons, preambles and projects are UTF-8 on every system;
# Windows would otherwise read and write text files in its ANSI code page.
_read_text, _write_text = Path.read_text, Path.write_text
Path.read_text = lambda self, encoding="utf-8", errors=None: _read_text(
    self, encoding=encoding, errors=errors)
Path.write_text = lambda self, data, encoding="utf-8", errors=None, newline=None: _write_text(
    self, data, encoding=encoding, errors=errors, newline=newline)


def _enable_windows_ansi():
    try:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        handle = kernel32.GetStdHandle(-11)
        mode = ctypes.c_ulong()
        if kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
            return bool(kernel32.SetConsoleMode(handle, mode.value | 0x0004))
    except (AttributeError, OSError):
        pass
    return False


def _color_on(stream):
    if os.environ.get("NO_COLOR") or not stream.isatty():
        return False
    return _enable_windows_ansi() if WINDOWS else True


def _unicode_ok(stream):
    enc = (getattr(stream, "encoding", "") or "").lower()
    return "utf" in enc


COLOR = {"out": _color_on(sys.stdout), "err": _color_on(sys.stderr)}
MARK = ({"ok": "✓", "fail": "✗", "warn": "!", "dot": "·"} if _unicode_ok(sys.stdout)
        else {"ok": "ok", "fail": "x", "warn": "!", "dot": "-"})


def _paint(text, code, err=False):
    return f"\033[{code}m{text}\033[0m" if COLOR["err" if err else "out"] else text


def ok(msg):
    print(f"{_paint(MARK['ok'], '32')} {msg}", flush=True)


def fail(msg):
    print(f"{_paint(MARK['fail'], '31', err=True)} {msg}", file=sys.stderr, flush=True)


def warn(msg):
    print(f"{_paint(MARK['warn'], '33')} {msg}", flush=True)


def note(msg, err=False):
    print(_paint(msg, "2", err=err), file=sys.stderr if err else sys.stdout, flush=True)


def cmd_text(text):
    """A command the reader should type, in bold."""
    return _paint(text, "1")


def die(msg, hint=None):
    fail(msg)
    if hint:
        note(f"  {hint}", err=True)
    sys.exit(1)


def elapsed(seconds):
    if seconds < 60:
        return T(f"{seconds:.1f} 秒", f"{seconds:.1f} s")
    return T(f"{int(seconds // 60)} 分 {int(seconds % 60)} 秒",
             f"{int(seconds // 60)} min {int(seconds % 60)} s")


def kill_tree(proc):
    """Kill proc and everything it started (latexmk and its xelatex): a
    leftover child would keep the output pipe open and hang communicate()."""
    if WINDOWS:
        subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"], capture_output=True)
    else:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()


def run_with_spinner(cmd, label, cwd=None, timeout=TIMEOUT, fatal=True):
    """Run cmd, showing 'label … 3.2 s' on a terminal while it works. On
    timeout: stop with a message, or (fatal=False) return code 124."""
    start = time.time()
    proc = subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, encoding="utf-8", errors="replace",
                            start_new_session=not WINDOWS)
    spin = sys.stderr.isatty()
    frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏" if _unicode_ok(sys.stderr) else "|/-\\"
    i = 0
    while True:
        try:
            out, _ = proc.communicate(timeout=0.12)
            break
        except KeyboardInterrupt:  # its own session, so Ctrl-C did not reach it
            kill_tree(proc)
            raise
        except subprocess.TimeoutExpired:
            if time.time() - start > timeout:
                kill_tree(proc)
                out, _ = proc.communicate()
                if spin:
                    sys.stderr.write("\r\033[K")
                if not fatal:
                    return 124, out, time.time() - start
                die(T(f"超過 {timeout // 60} 分鐘還沒結束，已停止",
                      f"Still running after {timeout // 60} minutes; stopped"),
                    T("通常是 LaTeX 在等輸入；看 build/ 裡的 .log 找原因",
                      "LaTeX is usually waiting for input; see the .log in build/"))
            if spin:
                sys.stderr.write(f"\r{frames[i % len(frames)]} {label} {time.time() - start:4.1f} {T('秒', 's')}")
                sys.stderr.flush()
                i += 1
    if spin:
        sys.stderr.write("\r\033[K")
        sys.stderr.flush()
    return proc.returncode, out, time.time() - start


def need_tool(name, hint):
    if not shutil.which(name):
        die(T(f"找不到 {name}", f"{name} not found"), hint)


# ---------- small helpers ----------

def write_build_files(target, kind):
    """latexmkrc and Cursor / VS Code settings; ax new and ax upgrade."""
    target = Path(target)
    (target / "latexmkrc").write_text(
        LATEXMKRC.replace("@PDF_MODE@", "1" if kind == "paper" else "5"))
    (target / ".vscode").mkdir(exist_ok=True)
    (target / ".vscode" / "settings.json").write_text(
        json.dumps(EDITOR_SETTINGS, indent=2) + "\n")


def copy_pdf(src, dest):
    """Replace dest with src in one step, so a viewer never sees half a file.
    Returns False when dest is locked (Windows viewers such as Acrobat)."""
    fd, tmp = tempfile.mkstemp(dir=str(Path(dest).parent), prefix=".ax-", suffix=".pdf")
    os.close(fd)
    shutil.copyfile(src, tmp)
    # mkstemp makes the file owner-only; give it the usual permissions
    umask = os.umask(0)
    os.umask(umask)
    os.chmod(tmp, 0o666 & ~umask)
    try:
        os.replace(tmp, dest)
        return True
    except PermissionError:
        os.unlink(tmp)
        return False


def git(*args):
    try:
        return subprocess.run(["git", "-C", str(REPO), *args], capture_output=True, text=True)
    except OSError:
        return subprocess.CompletedProcess(args, 1, "", "")


def template_tags():
    """Template versions, newest first."""
    out = git("tag", "--list", "v*", "--sort=-v:refname").stdout
    return [t for t in out.split() if t]


def unreleased_changes():
    """True when CHANGELOG.md has entries under "Unreleased": the templates
    here (and the manual) are newer than the newest tag."""
    try:
        text = (REPO / "CHANGELOG.md").read_text(errors="replace")
    except OSError:
        return False
    m = re.search(r"^## Unreleased[^\n]*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return bool(m and m.group(1).strip())


def pin_behind_manual(pin):
    """The pinned tag when the manual (the working tree) describes features
    that tag does not have; None for latest, frozen or an up-to-date pin."""
    if not pin or pin in ("latest", "frozen"):
        return None
    tags = template_tags()
    if pin not in tags:
        return None
    return pin if pin != tags[0] or unreleased_changes() else None


def behind_note(pin, err=False):
    """Tell the user that the manual is ahead of their template version."""
    note("\n".join(wrap_cols(T(f"注意：ax docs 的手冊寫的是模板目前的內容，比 {pin} 新；CHANGELOG.md 裡"
           f"「Unreleased」和 {pin} 之後的功能（選項、環境）在 {pin} 還沒有。要用它們，"
           f"把 .ax.json 的 \"template\" 改成 \"latest\"（新專案：ax new --pin latest）",
           f"Note: the manual (ax docs) describes the templates as they are now, newer than {pin}; "
           f"features listed under \"Unreleased\" (or after {pin}) in CHANGELOG.md are not in {pin} yet. "
           f"To use them, set \"template\" to \"latest\" in .ax.json (new projects: ax new --pin latest)"),
                                _doc_width(), "    ", "  ")), err=err)


def load_json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return {}


def project_config():
    """The project's .ax.json; {} when there is none. A file that is not valid
    JSON stops ax with the line at fault, instead of passing for no project."""
    try:
        text = Path(PROJECT_CONFIG).read_text()
    except OSError:
        return {}
    try:
        cfg = json.loads(text)
    except ValueError as e:
        die(T(f"{Path(PROJECT_CONFIG).resolve()} 不是有效的 JSON（第 {getattr(e, 'lineno', '?')} 行：{getattr(e, 'msg', e)}）",
              f"{Path(PROJECT_CONFIG).resolve()} is not valid JSON (line {getattr(e, 'lineno', '?')}: {getattr(e, 'msg', e)})"),
            T("修正這個檔案；格式見 docs/reference.md 的 .ax.json 一節",
              "Fix the file; its format is in the .ax.json section of docs/reference.md"))
    if not isinstance(cfg, dict):
        die(T(f"{PROJECT_CONFIG} 要是一個 JSON 物件（{{...}}）", f"{PROJECT_CONFIG} must be a JSON object ({{...}})"))
    return cfg


def save_project_config(cfg):
    Path(PROJECT_CONFIG).write_text(json.dumps(cfg, indent=2) + "\n")


def find_project(quiet=False):
    """Like git: use the nearest folder upwards that has .ax.json, and work
    from there. Returns its config, or {} outside a project."""
    here = Path.cwd()
    for folder in (here, *here.parents):
        if (folder / PROJECT_CONFIG).exists():
            if folder != here:
                os.chdir(folder)
                if not quiet:
                    note(T(f"（在專案資料夾 {folder} 執行）", f"(running in project folder {folder})"))
            return project_config()
    return {}


def require_project():
    cfg = find_project()
    if not cfg:
        die(T("這裡不是 ax 專案（往上找也找不到 .ax.json）",
              "Not in an ax project (no .ax.json here or in any parent folder)"),
            T(f"建立新專案：{cmd_text('ax new')}；或先 cd 到專案資料夾",
              f"Start one with {cmd_text('ax new')}, or cd into a project folder"))
    return cfg


def template_dir(pin):
    """Directory holding the template files for a pinned version, or None to
    use whatever is installed (pin 'latest') or the project's own copies
    (pin 'frozen')."""
    if not pin or pin in ("latest", "frozen"):
        return None
    target = CACHE / pin
    if (target / "akizumi-core.sty").exists() or (target / "aaron-core.sty").exists():
        return target
    if git("rev-parse", "-q", "--verify", f"refs/tags/{pin}").returncode:
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = Path(tempfile.mkdtemp(prefix=f".{pin}-", dir=CACHE))
    archive = subprocess.run(["git", "-C", str(REPO), "archive", pin], capture_output=True)
    if archive.returncode:
        return None
    with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as t:
        try:
            t.extractall(tmp, filter="data")
        except TypeError:  # Python before 3.12
            t.extractall(tmp)
    if target.exists():
        shutil.rmtree(tmp)
    else:
        tmp.rename(target)
    return target


def template_files(directory):
    files = []
    for pattern in TEMPLATE_GLOBS:
        files += sorted(Path(directory).glob(pattern))
    return files


def main_file(arg):
    """The .tex file to build: the argument, else the project's main file."""
    if arg:
        path = Path(arg if arg.endswith(".tex") else arg + ".tex")
        if not path.exists():
            die(T(f"找不到 {path}", f"{path} not found"))
        return path
    cfg = require_project()
    path = Path(cfg.get("main", "main.tex"))
    if not path.exists():
        die(T(f"找不到專案的主檔 {path}", f"The project's main file {path} is missing"),
            T("檢查 .ax.json 裡的 main", 'Check "main" in .ax.json'))
    return path


def suggest(word, choices):
    match = difflib.get_close_matches(word, choices, n=1, cutoff=0.5)
    return match[0] if match else None


# ---------- ax new ----------

def stdin_is_terminal():
    """Whether someone can answer questions. On Windows isatty() is also true
    for NUL, so ask the console directly."""
    if not sys.stdin.isatty():
        return False
    if WINDOWS:
        try:
            import ctypes
            import msvcrt
            mode = ctypes.c_ulong()
            handle = msvcrt.get_osfhandle(sys.stdin.fileno())
            return bool(ctypes.windll.kernel32.GetConsoleMode(handle, ctypes.byref(mode)))
        except (AttributeError, OSError, ValueError):
            return False
    return True


def ask(prompt):
    """Read an answer; end of input counts as leaving it blank."""
    try:
        return input(prompt).strip()
    except EOFError:
        print()
        return ""
    except KeyboardInterrupt:
        print()
        sys.exit(130)


def ask_default(prompt, default):
    """Ask with the default shown in brackets; Enter keeps it."""
    shown = _paint(f" [{default}]", "2") if default else ""
    return ask(f"{prompt}{shown}{T('：', ': ')}") or default


def confirm(prompt, default=True):
    hint = _paint("[Y/n]" if default else "[y/N]", "2")
    answer = ask(f"{prompt} {hint} ").lower()
    return default if not answer else answer in ("y", "yes", "是", "好", "要")


def _width(text):
    """Terminal columns: CJK characters take two."""
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def _read_key():
    """One key press: 'up', 'down', 'enter', 'quit', a digit, or ''."""
    if WINDOWS:
        import msvcrt
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):
            return {"H": "up", "P": "down"}.get(msvcrt.getwch(), "")
    else:
        import termios
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            ch = os.read(fd, 1).decode(errors="ignore")
            if ch == "\x1b":  # arrows send ESC [ A / ESC [ B; a lone ESC quits
                import select as _select
                if _select.select([fd], [], [], 0.05)[0]:
                    rest = os.read(fd, 2).decode(errors="ignore")
                    return {"[A": "up", "[B": "down", "OA": "up", "OB": "down"}.get(rest, "")
                return "quit"
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
    if ch in ("\r", "\n"):
        return "enter"
    if ch in ("\x03", "\x1b", "q", "Q"):
        return "quit"
    if ch in ("k", "K"):
        return "up"
    if ch in ("j", "J"):
        return "down"
    return ch if ch.isdigit() else ""


def menu_keys_ok():
    """Arrow-key menus need a terminal that understands cursor movement."""
    if not (stdin_is_terminal() and sys.stdout.isatty()):
        return False
    return _enable_windows_ansi() if WINDOWS else os.environ.get("TERM") != "dumb"


def select(title, options, default=0):
    """Pick one of options [(label, hint), ...]; returns its index, or None
    when the user quits. Arrow keys, j/k or a digit, then Enter, on a
    terminal; a numbered prompt otherwise."""
    if title:
        print(title)
    if not menu_keys_ok():
        for i, (label, hint) in enumerate(options, 1):
            print(f"  {cmd_text(str(i))}. {label}  {_paint(hint, '2') if hint else ''}")
        for _ in range(3):
            choice = ask(T(f"選擇 [1-{len(options)}，Enter = {default + 1}]：",
                           f"Choose [1-{len(options)}, Enter = {default + 1}]: "))
            if not choice:
                return default
            if choice.isdigit() and 1 <= int(choice) <= len(options):
                return int(choice) - 1
            warn(T(f"請輸入 1–{len(options)}", f"Type 1-{len(options)}"))
        return None
    pointer = "❯" if _unicode_ok(sys.stdout) else ">"
    width = max(_width(label) for label, _ in options)
    current = default

    def draw(first):
        if not first:
            sys.stdout.write(f"\033[{len(options) + 1}A")
        for i, (label, hint) in enumerate(options):
            mark = _paint(pointer, "36") if i == current else " "
            text = _paint(label, "1") if i == current else label
            pad = " " * (width - _width(label))
            sys.stdout.write(f"\r\033[K  {mark} {text}{pad}  {_paint(hint, '2') if hint else ''}\n")
        sys.stdout.write("\r\033[K" + _paint(T("  ↑↓ 選擇 · Enter 確認 · q 離開",
                                                "  ↑↓ move · Enter choose · q quit"), "2") + "\n")
        sys.stdout.flush()

    draw(True)
    while True:
        key = _read_key()
        if key == "up":
            current = (current - 1) % len(options)
        elif key == "down":
            current = (current + 1) % len(options)
        elif key.isdigit() and 1 <= int(key) <= len(options):
            current = int(key) - 1
        elif key in ("enter", "quit"):
            # collapse the menu into one line with the choice
            sys.stdout.write(f"\033[{len(options) + 1}A\r\033[J")
            if key == "enter":
                sys.stdout.write(f"  {_paint(pointer, '36')} {options[current][0]}\n")
            sys.stdout.flush()
            return current if key == "enter" else None
        draw(False)


def folder_name(kind, title, course, number):
    """A folder name suggested from what was typed: "self-predictive-reps",
    "ode-hw3"; falls back to "note-1026" when the title is not Latin."""
    def slug(text):
        words = re.findall(r"[A-Za-z0-9]+", text or "")
        return "-".join(words[:5]).lower()
    if kind == "hw":
        base = "-".join(filter(None, [slug(course), f"hw{number}" if number else "hw"]))
        return base
    return slug(title) or f"{kind}-{time.strftime('%m%d')}"


def choose_kind():
    names = list(KINDS)
    if menu_keys_ok():
        i = select(T("要建立哪一種文件？", "What do you want to make?"),
                   [(k, KIND_HELP[k]) for k in names])
        if i is None:
            sys.exit(0)
        return names[i]
    print(T("要建立哪一種文件？", "What do you want to make?"))
    for i, k in enumerate(names, 1):
        print(f"  {cmd_text(str(i))}. {k:<7} {_paint(KIND_HELP[k], '2')}")
    for _ in range(3):
        choice = ask(T(f"種類 [1-{len(names)}]：", f"Kind [1-{len(names)}]: "))
        if choice.isdigit() and 1 <= int(choice) <= len(names):
            return names[int(choice) - 1]
        if choice in KINDS:
            return choice
        guess = suggest(choice, names)
        warn(T(f"沒有「{choice}」這種文件" + (f"，你是不是要選 {guess}？" if guess else "")
               + f" 請輸入 1–{len(names)} 或種類名稱",
               f"There is no kind \"{choice}\"." + (f" Did you mean {guess}?" if guess else "")
               + f" Type 1-{len(names)} or a kind name"))
    die(T("沒有選到種類", "No kind chosen"))


def user_preamble(kind):
    """The user's own preamble lines for a new project: preamble.tex (every
    kind except paper, which follows a venue template) and preamble-KIND.tex,
    both in the config directory. Copied into main.tex, so the project stays
    self-contained."""
    parts, used = [], []
    names = ([] if kind == "paper" else ["preamble.tex"]) + [f"preamble-{kind}.tex"]
    for name in names:
        f = CONFIG_DIR / name
        if f.exists():
            text = f.read_text().strip()
            if text:
                parts.append(f"% --- from {name} ---\n{text}")
                used.append(name)
    return "\n".join(parts), used


# ---------- ax new hw --problems ----------

def parse_problems(spec, kind):
    """'5' -> [('', 5)]; 'B4,C2' -> [('B', 4), ('C', 2)]."""
    if kind != "hw":
        warn(T(f"--problems 只用於作業，{KIND_NAME[kind]}已略過",
               f"--problems is for homework only; skipped for {KIND_NAME[kind]}"))
        return []
    groups = []
    if not spec.strip():
        die(T("--problems 是空的", "--problems is empty"),
            T("寫題數，例如 --problems 5；或分組，例如 --problems B4,C2",
              "Give a count, e.g. --problems 5, or groups, e.g. --problems B4,C2"))
    for item in spec.replace(" ", "").split(","):
        m = re.fullmatch(r"([A-Za-z]*)(\d+)", item)
        if not m or int(m.group(2)) < 1 or int(m.group(2)) > 99:
            die(T(f"看不懂 --problems {spec}", f"Cannot read --problems {spec}"),
                T("寫題數，例如 --problems 5；或分組，例如 --problems B4,C2",
                  "Give a count, e.g. --problems 5, or groups, e.g. --problems B4,C2"))
        if any(m.group(1) == g for g, _ in groups):
            die(T(f"--problems 的 {m.group(1) or '題數'} 重複了", f"--problems repeats {m.group(1) or 'the count'}"))
        # file names: no prefix means p1, p2, ...; B1 and b1 are the same file
        # on macOS and Windows
        stem = (m.group(1) or "p").lower()
        clash = [g for g, _ in groups if (g or "p").lower() == stem]
        if clash:
            die(T(f"--problems 的 {clash[0] or '題數'} 和 {m.group(1) or '題數'} 會用到同樣的檔名（{stem}1.tex …）",
                  f"--problems {clash[0] or 'count'} and {m.group(1) or 'count'} would use the same files "
                  f"({stem}1.tex, ...)"),
                T("每組用不同的字母；只寫題數時檔名是 p1、p2 …",
                  "Give each group its own letter; a bare count uses p1, p2, ..."))
        groups.append((m.group(1), int(m.group(2))))
    return groups


def problem_files(problems):
    """(prefix, file stem) for each problem, in order."""
    return [(prefix, f"{prefix or 'p'}{i}") for prefix, n in problems for i in range(1, n + 1)]


def problems_body(problems):
    out, current = ["\\begin{document}", "\\maketitle", ""], ""
    for prefix, stem in problem_files(problems):
        if prefix != current:
            out += ([""] if out[-1] else []) + [f"\\problemset{{{prefix}}}"]
            current = prefix
        out.append(f"\\inputproblem{{problems/{stem}}}")
    return "\n".join(out + ["", "\\end{document}", ""])


def write_problem_files(target, problems):
    (target / "problems").mkdir(exist_ok=True)
    for _, stem in problem_files(problems):
        f = target / "problems" / f"{stem}.tex"
        if not f.exists():
            f.write_text("% Problem statement.\n\\begin{solution}\n% Solution.\n\\end{solution}\n")
# ---------- ax new paper: venue scaffolds ----------
# Venue style files are not shipped (each venue publishes new ones every
# year); main.tex names the file and says where to get it. The venue's file
# loads natbib and decides about hyperref, so the scaffold adds neither.
PAPER_VENUES = {
    "plain": {},
    "neurips": {"sty": "neurips_2026", "where": "neurips.cc (Call for Papers → style files)"},
    "icml": {"sty": "icml2026", "where": "icml.cc (Call for Papers → style files)"},
    "iclr": {"sty": "iclr2026_conference", "where": "github.com/ICLR/Master-Template"},
    "aaai": {"sty": "aaai2026", "where": "aaai.org (AAAI-26 Author Kit)"},
}
PAPER_SECTIONS = [("introduction", "Introduction", "sec:intro"),
                  ("related", "Related Work", "sec:related"),
                  ("method", "Method", "sec:method"),
                  ("experiments", "Experiments", "sec:experiments"),
                  ("conclusion", "Conclusion", "sec:conclusion")]


def paper_scaffold(a, title, author, pin, extra):
    """main.tex for ax new paper, and the other files to write ({path: text})."""
    venue = a.venue or "plain"
    v = PAPER_VENUES[venue]
    sty = v.get("sty", "")
    anonymous = a.anonymous if a.anonymous is not None else venue != "plain"
    title = title or "Title"
    author = author or "Author"
    files = {}
    # akizumi-paper exists from the version after v0.8 on; older pins get cleveref only
    has_helpers = ((template_dir(pin) or REPO) / "akizumi-paper.sty").exists()

    L = ["% !TEX program = pdflatex",
         "\\documentclass[letterpaper]{article}  % DO NOT CHANGE THIS" if venue == "aaai"
         else "\\documentclass{article}"]
    if venue == "plain":
        L += ["% \\anonymoustrue hides the author names (blind review).",
              f"\\newif\\ifanonymous \\anonymous{'true' if anonymous else 'false'}"]
    else:
        L += ["% \\anonymoustrue: anonymous submission; \\anonymousfalse: camera-ready.",
              f"\\newif\\ifanonymous \\anonymous{'true' if anonymous else 'false'}",
              "",
              f"% {sty}.sty is not included: download the style files from",
              f"% {v['where']} into this folder.",
              "% For another year, change the name here and in \\bibliographystyle."]
    if venue == "plain":
        if a.bib:
            L.append("\\usepackage[numbers]{natbib}")
        # links without the red / green boxes; the venue templates keep theirs
        L.append("\\usepackage[hidelinks]{hyperref}")
    elif venue == "neurips":
        L += ["% It loads natbib (author-year); for numeric citations [1, 2] uncomment:",
              "% \\PassOptionsToPackage{numbers, compress}{natbib}",
              f"\\ifanonymous\\usepackage{{{sty}}}\\else\\usepackage[final]{{{sty}}}\\fi  % [preprint]: arXiv",
              "\\usepackage[utf8]{inputenc}", "\\usepackage[T1]{fontenc}",
              "\\usepackage{hyperref}", "\\usepackage{url}",
              "\\usepackage{microtype}", "\\usepackage{graphicx}"]
    elif venue == "icml":
        L += ["\\usepackage{microtype}", "\\usepackage{graphicx}", "\\usepackage{booktabs}",
              "\\usepackage{hyperref}",
              "\\newcommand{\\theHalgorithm}{\\arabic{algorithm}}",
              f"\\ifanonymous\\usepackage{{{sty}}}\\else\\usepackage[accepted]{{{sty}}}\\fi"]
    elif venue == "iclr":
        L += [f"\\usepackage{{{sty},times}}",
              "% ICLR's math_commands.tex defines \\E, \\R, \\Var, ... as akizumi-math does;",
              "% use one of the two.",
              "\\usepackage{hyperref}", "\\usepackage{url}"]
    elif venue == "aaai":
        L += [f"\\ifanonymous\\usepackage[submission]{{{sty}}}\\else\\usepackage{{{sty}}}\\fi",
              "\\usepackage{times}  % DO NOT CHANGE THIS",
              "\\usepackage{helvet}  % DO NOT CHANGE THIS",
              "\\usepackage{courier}  % DO NOT CHANGE THIS",
              "\\usepackage[hyphens]{url}  % DO NOT CHANGE THIS",
              "\\usepackage{graphicx}  % DO NOT CHANGE THIS",
              "\\urlstyle{rm}  % DO NOT CHANGE THIS",
              "\\def\\UrlFont{\\rm}  % DO NOT CHANGE THIS",
              "\\usepackage{natbib}  % DO NOT ADD OPTIONS",
              "\\usepackage{caption}  % DO NOT ADD OPTIONS",
              "\\frenchspacing  % DO NOT CHANGE THIS",
              "\\setlength{\\pdfpagewidth}{8.5in}  % DO NOT CHANGE THIS",
              "\\setlength{\\pdfpageheight}{11in}  % DO NOT CHANGE THIS",
              "% AAAI forbids hyperref; akizumi-paper does not load it."]
    L.append("")
    L.append("\\usepackage{akizumi-math}")
    if has_helpers:
        L += ["\\usepackage[refstyle=short]{akizumi-paper}  % [final] hides the comments below",
              "\\ifanonymous\\akizumipapersetup{anonymous}\\fi",
              "% \\newcommenter{jun}{Jun}{teal}  % \\jun{comment}, \\jun*{edited text}"]
    else:
        L.append("\\usepackage[capitalise, noabbrev]{cleveref}")
    if extra:
        L += ["", extra]
    L.append("")

    # title and authors
    if venue == "icml":
        L.append(f"\\icmltitlerunning{{{title}}}")
    else:
        L.append(f"\\title{{{title}}}")
    if venue == "plain":
        L.append(f"\\ifanonymous\\author{{Anonymous}}\\else\\author{{{author}}}\\fi")
    elif venue == "iclr":
        L += [f"\\author{{{author} \\\\ Institution \\\\ \\texttt{{email@example.com}}}}",
              "\\ifanonymous\\else\\iclrfinalcopy\\fi"]
    elif venue == "aaai":
        L += [f"\\author{{{author}}}", "\\affiliations{Institution\\\\ email@example.com}"]
    elif venue == "neurips":
        L.append(f"\\author{{{author} \\\\ Institution \\\\ \\texttt{{email@example.com}}}}")
    L += ["", "\\begin{document}"]
    if venue == "icml":
        L += ["\\twocolumn[",
              f"  \\icmltitle{{{title}}}",
              "  \\begin{icmlauthorlist}",
              f"    \\icmlauthor{{{author}}}{{inst}}",
              "  \\end{icmlauthorlist}",
              "  \\icmlaffiliation{inst}{Institution, City, Country}",
              f"  \\icmlcorrespondingauthor{{{author}}}{{email@example.com}}",
              "  \\icmlkeywords{Machine Learning}",
              "  \\vskip 0.3in",
              "]",
              "\\printAffiliationsAndNotice{}"]
    else:
        L.append("\\maketitle")
    L += ["", "\\begin{abstract}", "\\end{abstract}", ""]

    # body: one file per section with --split
    if a.split:
        for name, heading, label in PAPER_SECTIONS:
            files[f"sections/{name}.tex"] = f"\\section{{{heading}}}\\label{{{label}}}\n\n"
            L.append(f"\\input{{sections/{name}}}")
        files["sections/appendix.tex"] = "\\section{Additional Results}\\label{app:results}\n\n"
    else:
        L += ["\\section{Introduction}\\label{sec:intro}", ""]
    L.append("")

    if venue == "plain":
        if a.bib:
            L += ["\\bibliographystyle{plainnat}", "\\bibliography{refs}"]
    elif venue == "neurips":
        L += ["\\bibliographystyle{plainnat}", "\\bibliography{refs}"]
    elif venue in ("icml", "iclr"):
        L += ["\\bibliography{refs}", f"\\bibliographystyle{{{sty}}}"]
    else:  # aaai: the style file sets the bibliography style
        L.append("\\bibliography{refs}")
    if a.split or venue in ("neurips", "icml", "iclr"):
        L += ["", "\\newpage", "\\appendix"]
        if venue == "icml":
            L.append("\\onecolumn")
        if a.split:
            L.append("\\input{sections/appendix}")
    if venue == "neurips":
        L += ["", "% NeurIPS paper checklist: checklist.tex from the style files",
              "% \\input{checklist}"]
    L += ["", "\\end{document}"]
    return "\n".join(L) + "\n", files


def cmd_new(a):
    user = load_json(USER_CONFIG)
    interactive = stdin_is_terminal()
    # Guided mode: bare `ax new` (or the ax menu) on a terminal asks step by
    # step with defaults and a summary; with arguments it creates at once.
    guided = interactive and a.kind is None and a.dir is None
    if guided:
        print(T("建立新文件。每一步按 Enter 用預設值，Ctrl-C 隨時取消。\n",
                "New document. Press Enter to keep a default; Ctrl-C cancels at any step.\n"))
    if a.kind is None:
        if not interactive:
            die(T("ax new 需要種類", "ax new needs a kind"),
                T("例如 ax new note 資料夾名稱；種類：" + "、".join(KINDS),
                  "For example ax new note my-notes; kinds: " + ", ".join(KINDS)))
        a.kind = choose_kind()
    if a.kind not in KINDS:
        guess = suggest(a.kind, list(KINDS))
        die(T(f"沒有「{a.kind}」這種文件" + (f"，你是不是要打 {cmd_text(guess)}？" if guess else ""),
              f"There is no kind \"{a.kind}\"" + (f"; did you mean {cmd_text(guess)}?" if guess else "")),
            T("可用的種類：" + "、".join(f"{k}（{KIND_NAME[k]}）" for k in KINDS),
              "Kinds: " + ", ".join(f"{k} ({KIND_NAME[k]})" for k in KINDS)))
    # config.json "defaults": {"slides": {"progress": true}, "note": {"layout": "margin"}}
    for key, value in user.get("defaults", {}).get(a.kind, {}).items():
        if key in ("lang", "thmnames", "text", "paper", "layout", "course", "author", "id", "venue"):
            if getattr(a, key, None) is None:
                setattr(a, key, value)
        elif key in ("bib", "progress", "git", "split") and value and not getattr(a, key):
            setattr(a, key, True)
        elif key == "byline":
            a.byline = bool(value)
        elif key == "code" and a.code is None:
            a.code = value
    if a.dir is None and not guided:
        if not interactive:
            die(T("ax new 需要資料夾名稱", "ax new needs a folder name"),
                T(f"例如 ax new {a.kind} my-{a.kind}", f"For example ax new {a.kind} my-{a.kind}"))
        a.dir = ask(T("資料夾名稱：", "Folder name: ")) or die(T("沒有給資料夾名稱", "No folder name given"))

    title = a.title
    if title is None and a.kind != "hw" and interactive:
        title = ask(T("標題：", "Title: ")) or None
    if a.kind == "hw" and a.course is None and interactive:
        a.course = ask(T("課名（可留白）：", "Course (optional): ")) or None
    if guided and a.kind == "hw" and a.number is None:
        a.number = ask(T("第幾次作業（可留白）：", "Homework number (optional): ")) or None
    if guided:
        print()
        if a.lang is None and a.kind != "paper":
            langs = ["en", "zh", "ja", "ko"]
            names = {"en": T("英文", "English"), "zh": T("中文", "Chinese"),
                     "ja": T("日文", "Japanese"), "ko": T("韓文", "Korean")}
            start = user.get("lang", "en")
            i = select(T("主語言？", "Main language?"),
                       [(names[l], l) for l in langs], langs.index(start) if start in langs else 0)
            if i is None:
                sys.exit(0)
            a.lang = langs[i]
        if a.kind == "paper" and a.venue is None:
            venues = ["plain", "neurips", "icml", "iclr", "aaai"]
            i = select(T("投稿哪裡？", "Which venue?"),
                       [(v, T("一般論文（article）", "plain article") if v == "plain" else
                         T("會議的 .sty 要自己下載", "download the venue's .sty yourself")) for v in venues])
            if i is None:
                sys.exit(0)
            a.venue = venues[i]
        if not a.bib and a.kind in ("note", "book", "slides"):
            a.bib = confirm(T("要參考文獻（refs.bib）嗎？", "Add a bibliography (refs.bib)?"), False)
        a.dir = ask_default(T("資料夾名稱", "Folder name"), folder_name(a.kind, title, a.course, a.number))
        if not a.dir:
            die(T("沒有給資料夾名稱", "No folder name given"))
        target = Path(a.dir)
        if target.exists() and any(target.iterdir()) and not a.force:
            die(T(f"{target} 已經存在而且不是空的", f"{target} already exists and is not empty"),
                T("換一個名字，或加 --force 照樣建立", "Pick another name, or add --force to use it anyway"))
        lang_name = {"en": T("英文", "English"), "zh": T("中文", "Chinese"),
                     "ja": T("日文", "Japanese"), "ko": T("韓文", "Korean")}.get(a.lang or "en", a.lang)
        parts = [KIND_NAME[a.kind]]
        if title:
            parts.append(f"「{title}」" if UI == "zh" else f'"{title}"')
        if a.course:
            parts.append(a.course)
        if a.kind != "paper":
            parts.append(lang_name)
        if a.bib:
            parts.append(T("參考文獻", "bibliography"))
        print()
        if not confirm(T(f"建立 {cmd_text(a.dir + '/')}：{' · '.join(parts)}？",
                         f"Create {cmd_text(a.dir + '/')}: {' · '.join(parts)}?")):
            note(T("已取消", "Cancelled"))
            sys.exit(0)
    target = Path(a.dir)
    if target.exists() and any(target.iterdir()) and not a.force:
        die(T(f"{target} 已經存在而且不是空的", f"{target} already exists and is not empty"),
            T("換一個名字，或加 --force 照樣建立", "Pick another name, or add --force to use it anyway"))
    author = a.author or user.get("author") or git("config", "user.name").stdout.strip()
    student_id = a.id or user.get("id")
    lang = a.lang or user.get("lang", "en")
    native = (a.thmnames or user.get("thmnames")) == "native"
    tags = template_tags()
    pin = a.pin or (tags[0] if tags else "latest")
    if a.pin and a.pin != "latest" and a.pin not in tags:
        die(T(f"沒有模板版本 {a.pin}", f"There is no template version {a.pin}"),
            T("現有版本：" + ("、".join(tags) or "（尚未打版本）"),
              "Versions: " + (", ".join(tags) or "(none tagged yet)")))

    if a.code == "minted" and a.kind == "paper":
        warn(T("論文不支援 --code minted，已略過", "--code minted is not available for papers; skipped"))
        a.code = None
    if a.kind == "paper":
        # a venue template on pdfLaTeX: these akizumi options do not apply
        ignored = [f"--{k}" for k in ("thmnames", "text", "paper", "layout") if getattr(a, k, None)]
        ignored += ["--progress"] if a.progress else []
        ignored += [f"--lang {a.lang}"] if a.lang and a.lang != "en" else []
        if ignored:
            warn(T(f"論文用會議的模板（pdfLaTeX），{'、'.join(ignored)} 已略過",
                   f"Papers use the venue's template (pdfLaTeX); {', '.join(ignored)} skipped"))
        if (a.lang and a.lang != "en") or CJK_CHAR.search(a.title or ""):
            note(T("  pdfLaTeX 排不了中日韓文字：中日韓文的論文或報告請改用 ax new note（XeLaTeX）",
                   "  pdfLaTeX cannot set Chinese, Japanese or Korean text: for a paper or report "
                   "in those languages use ax new note (XeLaTeX)"))
    if a.bib and a.kind in ("hw", "exam"):
        warn(T(f"{KIND_NAME[a.kind]}不支援 --bib，已略過", f"--bib is not available for {KIND_NAME[a.kind]}; skipped"))
        a.bib = False
    if a.kind != "paper" and (a.venue or a.split or a.anonymous is not None):
        warn(T("--venue、--split、--anonymous 只用在 paper，已略過",
               "--venue, --split and --anonymous are for paper only; skipped"))
    if a.kind == "paper" and (a.venue or "plain") != "plain":
        a.bib = True  # the venue's style loads natbib; refs.bib is expected

    # --- ax new hw --problems: one file per problem ---
    problems = parse_problems(a.problems, a.kind) if a.problems is not None else []
    if problems and pin != "latest":
        pinned = template_dir(pin)
        if pinned is not None and not (pinned / "akizumi-problems.sty").exists():
            note(T(f"模板 {pin} 還沒有 \\inputproblem，改用 latest",
                   f"Template {pin} has no \\inputproblem yet; using latest"))
            pin = "latest"
    # --- end --problems ---

    # class options
    opts = []
    if a.kind == "slides":
        opts = ["aspectratio=169", "11pt"]
    elif a.kind != "paper":
        if lang != "en":
            opts.append(f"lang={lang}")
        if native:
            opts.append("thmnames=native")
        for key in ("text", "paper", "layout"):
            value = getattr(a, key)
            if value:
                opts.append(f"{key}={value}")
        if getattr(a, "byline", False) and a.kind != "book":
            opts.append("byline")
        if a.bib:
            opts.append("bib=refs.bib")
        if a.code == "minted" and a.kind != "slides":
            opts.append("code=minted")

    lines = ["% !TEX program = " + ("pdflatex" if a.kind == "paper" else "xelatex")]
    cls = KINDS[a.kind]
    lines.append(f"\\documentclass{'[' + ', '.join(opts) + ']' if opts else ''}{{{cls}}}")

    if a.kind == "slides":
        theme_opts = [f"lang={lang}"] if lang != "en" else []
        if native:
            theme_opts.append("thmnames=native")
        if a.progress:
            theme_opts.append("progress")
        if a.code == "minted":
            theme_opts.append("code=minted")
        lines.append(f"\\usetheme{'[' + ', '.join(theme_opts) + ']' if theme_opts else ''}{{Akizumi}}")
        if a.bib:
            lines += ["\\usepackage[backend=biber, style=numeric-comp, sorting=none]{biblatex}",
                      "\\addbibresource{refs.bib}"]

    setup = []
    if a.course:
        setup.append(f"kicker={{{a.course}}}" if a.kind == "book" else f"course={{{a.course}}}")
    if a.kind == "hw":
        if a.number:
            setup.append(f"number={a.number}")
        if a.due:
            setup.append(f"due={a.due}")
        if student_id:
            setup.append(f"id={student_id}")
    if a.kind == "slides":
        setup = [f"kicker={{{a.course}}}"] if a.course else []
    if setup and a.kind != "paper":
        lines.append("\\akizumisetup{" + ", ".join(setup) + "}")
    if title:
        lines.append(f"\\title{{{title}}}")
    if author:
        lines.append(f"\\author{{{author}}}")
    extra, used_preambles = ("", []) if a.no_preamble else user_preamble(a.kind)
    if extra:
        lines += ["", extra]

    body = (SKELETONS / f"{a.kind}.tex").read_text()
    if problems:
        body = problems_body(problems)
    bibend = ""
    if a.bib:
        bibend = {
            "slides": "\\begin{frame}[allowframebreaks]{References}\n"
                      "  \\printbibliography\n\\end{frame}\n",
        }.get(a.kind, "\\printbibliography\n\n")
    body = body.replace("<<BIBEND>>", bibend)

    target.mkdir(parents=True, exist_ok=True)
    (target / "figures").mkdir(exist_ok=True)
    (target / "figures" / ".gitkeep").touch()
    main_text, other_files = "\n".join(lines) + "\n\n" + body, {}
    if a.kind == "paper":
        main_text, other_files = paper_scaffold(a, title, author, pin, extra)
    (target / "main.tex").write_text(main_text)
    for name, text in other_files.items():
        (target / name).parent.mkdir(parents=True, exist_ok=True)
        (target / name).write_text(text)
    if problems:
        write_problem_files(target, problems)
    write_build_files(target, a.kind)
    (target / ".gitignore").write_text(GITIGNORE)
    if a.bib:
        (target / "refs.bib").write_text("% BibTeX entries go here.\n")
    project = {"kind": a.kind, "main": "main.tex", "template": pin}
    if a.code == "minted" and not restricted_minted():
        # TeX before 2024 runs Pygments only with full shell escape
        project["shell_escape"] = True  # latexmkrc and ax build pass -shell-escape
    (target / PROJECT_CONFIG).write_text(json.dumps(project, indent=2) + "\n")
    template_dir(pin)  # fetch the pinned version now, while the repo is at hand
    if a.git:
        run = lambda *c: subprocess.run(["git", "-C", str(target), *c], capture_output=True)
        run("init", "-q")
        run("add", "-A")
        run("commit", "-q", "-m", f"Start {a.kind} project")

    print()
    remember_project(target)
    ok(T(f"已建立 {cmd_text(str(target))}（{KIND_NAME[a.kind]}，模板 {pin}）",
         f"Created {cmd_text(str(target))} ({KIND_NAME[a.kind]}, template {pin})"))
    dot = MARK['dot']
    note(T(f"  main.tex 寫內容 {dot} figures/ 放圖"
           + (f" {dot} problems/ 每題一個檔" if problems else "")
           + (f" {dot} refs.bib 放參考文獻" if a.bib else "")
           + (f" {dot} 已建立 git repo" if a.git else ""),
           f"  main.tex for your text {dot} figures/ for images"
           + (f" {dot} problems/ one file per problem" if problems else "")
           + (f" {dot} refs.bib for references" if a.bib else "")
           + (f" {dot} git repo created" if a.git else "")))
    if used_preambles:
        note(T("  已加入你的 " + "、".join(used_preambles), "  Added your " + ", ".join(used_preambles)))
    shared = shared_preamble(target) if a.kind != "paper" else None
    if shared:
        note(T(f"  編譯時會讀共用 preamble {shared}", f"  Builds read the shared preamble {shared}"))
    if a.kind == "paper" and (a.venue or "plain") != "plain":
        v = PAPER_VENUES[a.venue]
        warn(T(f"{v['sty']}.sty 沒有附上：從 {v['where']} 下載到 {target}",
               f"{v['sty']}.sty is not included: download it from {v['where']} into {target}"))
    if pin_behind_manual(pin):
        behind_note(pin)
    print(T("\n下一步：", "\nNext:"))
    print(f"  {cmd_text(f'cd {target}')}")
    keys = 'Cmd+Option+V' if MACOS else 'Ctrl+Alt+V'
    # Cursor compiles on save, so ax watch is only the alternative to it
    if shutil.which("cursor"):
        print(f"  {cmd_text('cursor .'):<24} "
              + T(f"用 Cursor 開啟，{keys} 看 PDF，存檔就重編",
                  f"open in Cursor; {keys} shows the PDF, saving rebuilds"))
        print(f"  {cmd_text('ax watch'):<24} "
              + T("不用 Cursor 時：存檔就重編，PDF 自動更新",
                  "without Cursor: rebuild on save, PDF updates itself"))
    else:
        print(f"  {cmd_text('ax watch'):<24} "
              + T("存檔就重編，PDF 自動更新", "rebuild on save, PDF updates itself"))
    if a.kind in ("hw", "exam"):
        print(f"  {cmd_text('ax both'):<24} " + T("題目卷和解答各一份", "problems and solutions as two PDFs"))


# ---------- building ----------

ERROR_LINE = re.compile(r"^(?P<file>[^\s:][^:]*\.(?:tex|sty|cls|bib)):(?P<line>\d+): (?P<msg>.*)$")

# Plain-language hints for the errors people meet most often.
ERROR_HINTS = [
    ("Command \\c@lemma", T("這個專案的模板版本太舊，跟新版 LaTeX 不相容；在專案裡跑 ax upgrade",
                            "This project's template version is too old for your LaTeX; run ax upgrade in it")),
    ("Undefined control sequence", T("指令拼錯，或用到的套件沒有載入",
                                     "A command is misspelt, or its package is not loaded")),
    ("Missing $ inserted", T("數學符號（_、^、\\alpha 等）要放在 $...$ 裡",
                             "Math symbols (_, ^, \\alpha, ...) must be inside $...$")),
    ("Missing } inserted", T("大括號沒有成對", "Braces do not match")),
    ("Extra }", T("多了一個 }", "There is one } too many")),
    ("Environment", T("環境名稱拼錯，或 \\begin 和 \\end 沒有成對",
                      "An environment name is misspelt, or \\begin and \\end do not match")),
    ("File `", T("找不到檔案或套件；檢查檔名，或用 tlmgr 安裝套件",
                 "A file or package is missing; check the name, or install it with tlmgr")),
    ("XeTeX is required", T("這份文件要用 XeLaTeX 編譯；用 ax build，或檢查編輯器的編譯設定",
                            "This document needs XeLaTeX; use ax build, or check your editor's build settings")),
    ("Emergency stop", T("LaTeX 中途停止，通常是前面某個錯誤造成的",
                         "LaTeX stopped early, usually because of an earlier error")),
    ("Runaway argument", T("某個指令的參數沒有結束，常見是少了 }",
                           "A command's argument never ends; often a missing }")),
]


def first_error(log_path):
    """First error in a LaTeX log as (location, message, context lines)."""
    try:
        lines = Path(log_path).read_text(errors="replace").splitlines()
    except OSError:
        return None
    for i, line in enumerate(lines):
        m = ERROR_LINE.match(line)
        if m or line.startswith("! "):
            location = f"{m['file']}:{m['line']}" if m else ""
            message = m["msg"] if m else line[2:]
            # TeX shows the offending source line split at the error point:
            # "l.11 \undefinedmacro" then the rest of the line. Keep those two
            # and drop the help text that follows.
            context = []
            for j in range(i + 1, min(i + 15, len(lines))):
                if lines[j].startswith("l."):
                    context = [lines[j]]
                    if j + 1 < len(lines) and lines[j + 1].strip():
                        context.append(lines[j + 1])
                    break
            if not location:
                for c in context:
                    lm = re.match(r"l\.(\d+)", c)
                    if lm:
                        location = T(f"第 {lm.group(1)} 行", f"line {lm.group(1)}")
            return location, message, context
    return None


def print_error(log):
    err = first_error(log)
    if not err:
        return False
    location, message, context = err
    print(f"  {_paint(location, '1', err=True) + T('：', ': ') if location else ''}{message}", file=sys.stderr)
    for c in context:
        print(f"    {c}", file=sys.stderr)
    for key, hint in ERROR_HINTS:
        if key in message:
            note(T(f"  提示：{hint}", f"  Hint: {hint}"), err=True)
            break
    return True


def warnings_summary(log_path):
    try:
        log = Path(log_path).read_text(errors="replace")
    except OSError:
        return []
    found = []
    refs = len(re.findall(r"Reference `[^']*' on page \d+ undefined", log))
    cites = len(re.findall(r"Citation [`'][^']*' on page \d+ undefined", log))
    overfull = len(re.findall(r"^Overfull \\hbox", log, re.M))
    if refs:
        found.append(T(f"{refs} 個 \\ref 找不到對應的 \\label",
                       f"{refs} \\ref without a matching \\label"))
    if cites:
        found.append(T(f"{cites} 個 \\cite 找不到文獻", f"{cites} \\cite without a bibliography entry"))
    if overfull:
        found.append(T(f"{overfull} 行超出版面", f"{overfull} line(s) run into the margin"))
    # options the class does not know (often: newer than the pinned version)
    m = re.search(r"Unused global option\(s\):\s*\[([^\]]*)\]", log)
    if m:
        unused = ", ".join(o.strip() for o in re.sub(r"\s+", "", m.group(1)).split(",") if o.strip())
        found.append(T(f"文件選項沒有作用（模板不認得）：{unused}",
                       f"Document option(s) with no effect (the template does not know them): {unused}"))
    return found


# ---------- shell escape for minted (code=minted) ----------
MINTED_RE = re.compile(r"\\(?:documentclass|usetheme)\[[^\]]*\bcode\s*=\s*minted"
                       r"|\\usepackage(?:\[[^\]]*\])?\{[^}]*\bminted\b"
                       r"|\\tcbuselibrary\{[^}]*\bminted\b")


def fallback_latexmkrc(main):
    """Outside a project, with no latexmkrc written by ax here: ax's own
    settings (build/, XeLaTeX unless "% !TEX program" says otherwise), written
    to the cache and given to latexmk with -r, which overrides a .latexmkrc."""
    if Path(PROJECT_CONFIG).exists():
        return []
    rc = Path("latexmkrc")
    try:
        if rc.exists() and rc.read_text(errors="replace").startswith("# Written by ax"):
            return []
    except OSError:
        pass
    try:
        first = Path(main).read_text(errors="replace").split("\n", 1)[0]
    except OSError:
        first = ""
    mode = "1" if "pdflatex" in first else "4" if "lualatex" in first else "5"
    path = CACHE / f"latexmkrc-{mode}"
    text = LATEXMKRC.replace("@PDF_MODE@", mode)
    try:
        if not path.exists() or path.read_text() != text:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
    except OSError:
        return []
    return ["-r", str(path)]


def latexmk(main, label, jobname=None, pretex=None, clean_first=False):
    need_tool("latexmk", T("請先安裝 TeX Live，再執行 ax doctor", "Install TeX Live, then run ax doctor"))
    base = ["latexmk", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error"]
    if jobname:
        base.append(f"-jobname={jobname}")
    if pretex:
        base.append(f"-usepretex={pretex}")
    flags = latexmk_flags(main=main)
    base += flags + fallback_latexmkrc(main)
    # latexmk only looks at the sources: when the template version, the
    # options (shell_escape) or the pretex (ax both's solutions switch)
    # changed since the last build, rebuild in full
    job = jobname or Path(main).stem
    stamp_file = Path("build") / f".{job}.ax-stamp"
    stamp = json.dumps({"template": project_config().get("template"), "flags": flags,
                        "pretex": pretex})
    try:
        old_stamp = stamp_file.read_text() if stamp_file.exists() else None
    except OSError:
        old_stamp = None
    if (old_stamp is not None and old_stamp != stamp) or \
            (old_stamp is None and (Path("build") / f"{job}.fdb_latexmk").exists()):
        base.append("-g")
    if clean_first:
        subprocess.run(base[:1] + ["-C"] + base[4:] + [str(main)], capture_output=True)
    code, output, secs = run_with_spinner(base + [str(main)], label)
    if code == 0 and Path("build").is_dir():
        try:
            stamp_file.write_text(stamp)
        except OSError:
            pass
    return code, output, secs


def output_pdf(job, main=None, cfg=None):
    """Where a finished build/<job>.pdf goes, relative to the project folder:
    <job>.pdf, except that "pdf" in .ax.json names the main file's PDF (and
    ax both's solutions, <stem>-solutions.pdf)."""
    cfg = project_config() if cfg is None else cfg
    name = cfg.get("pdf")
    plain = Path(f"{job}.pdf")
    if name is None:
        return plain
    if not isinstance(name, str) or not name.strip() or Path(name.strip()).name != name.strip():
        warn(T(f'.ax.json 的 "pdf" 要是一個檔名（例如 "報告.pdf"），現在是 {json.dumps(name, ensure_ascii=False)}，不使用',
               f'"pdf" in .ax.json must be a file name (such as "report.pdf"); it is '
               f'{json.dumps(name, ensure_ascii=False)}, ignored'))
        return plain
    project_main = Path(cfg.get("main", "main.tex"))
    if main is not None and Path(main).resolve() != project_main.resolve():
        return plain  # ax build other.tex
    name = Path(name.strip())
    if name.suffix.lower() != ".pdf":
        name = Path(name.name + ".pdf")
    if job == project_main.stem:
        return name
    if job == f"{project_main.stem}-solutions":
        return Path(f"{name.stem}-solutions.pdf")
    return plain


def safe_build(main, jobname=None, pretex=None, label=None):
    """Compile into build/ and copy the PDF next to the source only on success.
    Returns True on success."""
    job = jobname or main.stem
    label = label or T(f"編譯 {main}", f"Building {main}")
    code, output, secs = latexmk(main, label, jobname, pretex)
    if code and "error in previous invocation" in output:
        # latexmk remembers a failed run (biber, say) and refuses to retry
        code, output, more = latexmk(main, label, jobname, pretex, clean_first=True)
        secs += more

    built = Path("build") / f"{job}.pdf"
    log = Path("build") / f"{job}.log"
    dest = output_pdf(job, main)
    if code == 0 and built.exists():
        if not copy_pdf(built, dest):
            ok(T(f"{built}（{elapsed(secs)}）", f"{built} ({elapsed(secs)})"))
            warn(T(f"{dest} 正被閱讀器鎖住，沒辦法更新；關掉它，或改開 {built}",
                   f"{dest} is locked by a PDF viewer and could not be updated; close it, or open {built}"))
            return True
        ok(T(f"{dest}（{elapsed(secs)}）", f"{dest} ({elapsed(secs)})"))
        warnings = warnings_summary(log)
        for w in warnings:
            warn(w)
        behind = pin_behind_manual(project_config().get("template"))
        if behind and log.exists() and "Unused global option" in log.read_text(errors="replace"):
            behind_note(behind)
        return True

    fail(T(f"編譯失敗：{main}" + (f"（{job}）" if jobname else ""),
           f"Build failed: {main}" + (f" ({job})" if jobname else "")))
    if not print_error(log):
        tail = [l for l in output.splitlines() if re.search(r"error|failed", l, re.I)]
        for l in tail[-5:]:
            print(f"  {l.strip()}", file=sys.stderr)
    behind = pin_behind_manual(project_config().get("template"))
    err = first_error(log)
    if behind and err and re.search(r"Undefined control sequence|Environment \S+ undefined|"
                                    r"Unknown option|Key .* unknown|not defined", err[1]):
        behind_note(behind, err=True)
    if dest.exists():
        note(T(f"  上一份 {dest} 保留著，沒有被覆蓋", f"  The previous {dest} is kept"), err=True)
    if log.exists():
        note(T(f"  完整紀錄：{log}", f"  Full log: {log}"), err=True)
    return False


def cmd_explain(a):
    """Called by latexmk after a failed run in ax watch."""
    a.job = a.job.replace('"', "")  # latexmk on Windows quotes %R
    record_watch_result(False, a.job)
    fail(T(f"編譯失敗（{time.strftime('%H:%M:%S')}），PDF 保留上一份",
           f"Build failed ({time.strftime('%H:%M:%S')}); the PDF stays as it was"))
    if not print_error(Path("build") / f"{a.job}.log"):
        note(T("  log 裡沒有 LaTeX 錯誤；看上面 latexmk 的輸出",
               "  No LaTeX error in the log; see latexmk's output above"), err=True)


def cmd_copypdf(a):
    """Called by latexmk after a successful run in ax watch."""
    # latexmk on Windows quotes the parts of %Z%R.pdf ("build/"main.pdf")
    a.src, a.dest = a.src.replace('"', ""), a.dest.replace('"', "")
    job = Path(a.dest).stem
    record_watch_result(True, job)
    if Path(a.dest).parent == Path("."):
        a.dest = str(output_pdf(job))  # "pdf" in .ax.json
    if copy_pdf(a.src, a.dest):
        ok(T(f"已更新 {a.dest}（{time.strftime('%H:%M:%S')}）",
             f"Updated {a.dest} ({time.strftime('%H:%M:%S')})"))
    else:
        warn(T(f"{a.dest} 正被閱讀器鎖住；新的 PDF 在 {a.src}",
               f"{a.dest} is locked by a PDF viewer; the new PDF is {a.src}"))


def cmd_build(a):
    main = main_file(a.file)
    remember_project()
    warn_if_watching()
    run_prebuild(a)
    if a.chapter:
        sys.exit(0 if build_chapters(main, a.chapter) else 1)
    sys.exit(0 if safe_build(main) else 1)


# ---------- build pipeline: prebuild, shell_escape, --chapter, ax count ----------
# .ax.json may hold
#   "prebuild": ["python make_figures.py", "stata -b do main.do"]
#       run in the project folder before ax build / both / watch, in order;
#       the first failure stops the build and the PDF stays as it was. An item
#       may also be a list (program and arguments, no shell).
#   "shell_escape": true
#       lets LaTeX run programs (minted, svg, texdoc, ...). latexmk_flags()
#       passes it to every latexmk ax starts; the latexmkrc ax writes reads it
#       too, so editors that call latexmk directly get the same.

SHELL_BUILTINS = {"cd", "echo", "set", "export", "test", "[", "true", "false", "exit",
                  "source", ".", "call", "if", "for", "env"}


def latexmk_flags(cfg=None, main=None):
    """latexmk options that .ax.json asks for; shared by build, both and watch.
    -shell-escape when "shell_escape" is true or the main file uses code=minted
    on a TeX whose restricted shell escape cannot run latexminted; with
    minted, warns if Pygments is not found."""
    cfg = project_config() if cfg is None else cfg
    if "shell_escape" in cfg and not isinstance(cfg["shell_escape"], bool):
        warn(T(f'.ax.json 的 "shell_escape" 要寫 true 或 false（不加引號），現在是 {json.dumps(cfg["shell_escape"])}，當成 false',
               f'"shell_escape" in .ax.json must be true or false (no quotes); it is '
               f'{json.dumps(cfg["shell_escape"])}, read as false'))
    text = ""
    if main is not None:
        try:
            text = re.sub(r"(?<!\\)%.*", "", Path(main).read_text(errors="replace"))
        except OSError:
            pass
    minted = bool(MINTED_RE.search(text))
    if not (cfg.get("shell_escape") is True or minted):
        return []
    if minted and WINDOWS:
        warn(T("Windows 上暫時不支援 minted；程式碼改用 listings",
               "minted is not supported on Windows yet; code falls back to listings"))
    elif minted and not (shutil.which("latexminted") or shutil.which("pygmentize")):
        warn(T("minted 需要 Pygments（latexminted 或 pygmentize），找不到；程式碼改用 listings",
               "minted needs Pygments (latexminted or pygmentize), which is not found; code falls back to listings"))
    elif cfg.get("shell_escape") is not True and restricted_minted():
        return []  # TeX Live 2024+: the default restricted shell escape runs latexminted
    return ["-shell-escape"]


_RESTRICTED_MINTED = []


def restricted_minted():
    """True when TeX's default restricted shell escape may run latexminted
    (TeX Live 2024 and later), so minted needs no -shell-escape."""
    if not _RESTRICTED_MINTED:
        good = False
        if shutil.which("latexminted") and shutil.which("kpsewhich"):
            try:
                var = lambda name: subprocess.run(["kpsewhich", "-var-value", name], capture_output=True,
                                                  text=True, timeout=20).stdout.strip()
                good = var("shell_escape") == "p" and "latexminted" in var("shell_escape_commands").split(",")
            except (OSError, subprocess.SubprocessError):
                pass
        _RESTRICTED_MINTED.append(good)
    return _RESTRICTED_MINTED[0]


# Lines that only a current latexmkrc has: "shell_escape", the indexer, the
# indexer's handling of an index with no entries, and "pdf".
LATEXMKRC_MARKERS = ("shell_escape", "ax_makeindex", "-z $_[-1]", "ax_copy_pdf")


def refresh_latexmkrc(cfg):
    """A latexmkrc written by an older ax lacks newer parts (it does not read
    "shell_escape", or fails on an empty index); rewrite it (it is ax's own
    file) so ax build and editors build the same way."""
    rc = Path("latexmkrc")
    if not rc.exists():
        return
    try:
        text = rc.read_text()
    except OSError:
        return
    if text.startswith("# Written by ax") and not all(m in text for m in LATEXMKRC_MARKERS):
        rc.write_text(LATEXMKRC.replace("@PDF_MODE@", "1" if cfg.get("kind") == "paper" else "5"))
        note(T("  已更新 latexmkrc（舊版 ax 寫的）", "  Updated latexmkrc (written by an older ax)"))


def prebuild_steps(cfg):
    steps = cfg.get("prebuild") or []
    if isinstance(steps, str):
        steps = [steps]
    if not isinstance(steps, list) or not all(
            isinstance(s, str) or (isinstance(s, list) and s) for s in steps):
        die(T('.ax.json 的 "prebuild" 要是指令清單', '"prebuild" in .ax.json must be a list of commands'),
            T('例如 "prebuild": ["python make_figures.py"]', 'For example "prebuild": ["python make_figures.py"]'))
    return steps


def step_text(step):
    return step if isinstance(step, str) else " ".join(str(s) for s in step)


def step_programs(step):
    """The programs a prebuild step starts, for ax doctor (best effort)."""
    import shlex
    if isinstance(step, list):
        return [str(step[0])]
    progs = []
    for part in re.split(r"&&|\|\||[;|]", step):
        try:
            words = shlex.split(part, posix=not WINDOWS)
        except ValueError:
            continue
        for w in words:
            if "=" in w and not w.startswith(("-", "/", ".", '"')):
                continue  # FOO=1 python ...
            w = w.strip('"')
            if w not in SHELL_BUILTINS and w not in progs:
                progs.append(w)
            break
    return progs


def run_prebuild(a=None):
    """Run .ax.json "prebuild" in the project folder; exit on the first failure.
    Also keeps the latexmkrc in step with "shell_escape"."""
    cfg = project_config()
    refresh_latexmkrc(cfg)
    steps = prebuild_steps(cfg)
    if steps and getattr(a, "no_prebuild", False):
        note(T(f"  略過 {len(steps)} 個前置步驟（--no-prebuild）",
               f"  Skipped {len(steps)} prebuild step(s) (--no-prebuild)"))
        return
    for step in steps:
        shown = step_text(step)
        if isinstance(step, list):
            cmd = [str(s) for s in step]
        elif WINDOWS:
            cmd = f'"{os.environ.get("COMSPEC", "cmd.exe")}" /d /s /c "{step}"'
        else:
            cmd = ["/bin/sh", "-c", step]
        try:
            # no time limit: scripts that make figures or run Stata may be slow
            code, out, secs = run_with_spinner(cmd, T(f"前置步驟 {shown}", f"Prebuild {shown}"),
                                               timeout=float("inf"))
        except OSError as e:
            code, out, secs = 127, str(e), 0
        if code == 0:
            ok(T(f"前置步驟 {shown}（{elapsed(secs)}）", f"Prebuild {shown} ({elapsed(secs)})"))
            continue
        fail(T(f"前置步驟失敗（結束碼 {code}）：{shown}", f"Prebuild step failed (exit code {code}): {shown}"))
        for line in out.rstrip().splitlines()[-12:]:
            print(f"    {line}", file=sys.stderr)
        if code in (127, 9009):
            note(T("  提示：找不到這個程式；檢查拼字或 PATH，ax doctor 會列出前置步驟要的程式",
                   "  Hint: the program was not found; check the spelling or PATH. "
                   "ax doctor lists the programs prebuild needs"), err=True)
        note(T("  沒有編譯，PDF 保留上一份。步驟寫在 .ax.json 的 \"prebuild\"；"
               "ax build --no-prebuild 可以先跳過",
               "  Nothing was compiled; the PDF stays as it was. The steps are \"prebuild\" "
               "in .ax.json; ax build --no-prebuild skips them"), err=True)
        sys.exit(1)


# --- ax build --chapter N: one chapter of a book, with its real number ---
# Chapters must be \include'd. \includeonly{...} is given on latexmk's command
# line under the job name main-chN, so main.pdf is left alone; the .aux files
# of the other chapters (from the last full build) keep chapter and page
# numbers and cross-references right.

CHAPTER_TOKEN = re.compile(r"\\(frontmatter|mainmatter|backmatter|appendix)(?![A-Za-z])"
                           r"|\\chapter(\*?)\s*[\[{]"
                           r"|\\(input|include|subfile)\s*\{([^}]+)\}"
                           r"|\\chapterdir\s*(?:\[[^\]]*\])?\s*\{([^}]*)\}")


def strip_tex_comments(text):
    return re.sub(r"(?<!\\)%.*", "", text)


def tex_body(text):
    """The part between \\begin{document} and \\end{document}, if there is one."""
    m = re.search(r"\\begin\s*\{document\}", text)
    if m:
        text = text[m.end():]
    m = re.search(r"\\end\s*\{document\}", text)
    return text[:m.start()] if m else text


def find_tex(name, dirs):
    for d in dirs:
        for candidate in (d / name, d / f"{name}.tex"):
            if candidate.is_file():
                return candidate
    return None


def chapter_map(main):
    """The \\include'd files of main in order, as [name, labels], where labels
    are the numbers (or appendix letters) of the \\chapter commands inside,
    counted the way LaTeX numbers them; plus the labels of chapters written in
    main.tex itself or in \\input files, which cannot be built alone."""
    entries, inline = [], []
    state = {"numbered": True, "appendix": False, "n": 0, "letter": 0, "dirs": [main.parent]}

    def walk(path, entry, depth):
        try:
            text = strip_tex_comments(Path(path).read_text(errors="replace"))
        except OSError:
            return
        if depth == 0 or "\\begin{document}" in text:
            text = tex_body(text)
        for m in CHAPTER_TOKEN.finditer(text):
            if m.group(1):
                if m.group(1) == "appendix":
                    state["appendix"] = True
                else:  # \frontmatter and \backmatter chapters get no number
                    state["numbered"] = m.group(1) == "mainmatter"
            elif m.group(5) is not None:
                d = m.group(5).strip().rstrip("/")
                state["dirs"] = [main.parent / d, main.parent] if d else [main.parent]
            elif m.group(3):
                name = m.group(4).strip()
                found = find_tex(name, state["dirs"])
                if m.group(3) == "include" and entry is None:
                    e = [name, []]
                    entries.append(e)
                    if found and depth < 8:
                        walk(found, e, depth + 1)
                elif found and depth < 8:
                    walk(found, entry, depth + 1)
            elif m.group(2) == "" and state["numbered"]:
                if state["appendix"]:
                    state["letter"] += 1
                    label = chr(ord("A") + state["letter"] - 1)
                else:
                    state["n"] += 1
                    label = str(state["n"])
                (entry[1] if entry is not None else inline).append(label)

    walk(main, None, 0)
    return entries, inline


def pick_chapters(main, tokens):
    entries, inline = chapter_map(main)
    if not entries:
        die(T(f"{main} 裡沒有用 \\include{{...}} 載入的章", f"{main} has no chapters loaded with \\include{{...}}"),
            T("--chapter 只能編譯用 \\include 載入的章：把 \\input{chapters/x} 改成 \\include{chapters/x}",
              "--chapter builds only \\include'd chapters: change \\input{chapters/x} to \\include{chapters/x}"))
    listing = T("、", ", ").join(
        f"{'/'.join(e[1]) or '-'} {e[0]}" for e in entries)
    chosen = []
    for token in (t.strip() for raw in tokens for t in raw.split(",")):
        if not token:
            continue
        label = token.upper() if re.fullmatch(r"[A-Za-z]", token) else token.lstrip("0") or "0"
        numeric = bool(re.fullmatch(r"\d+|[A-Za-z]", token))
        hits = [e for e in entries if label in e[1]] if numeric else []
        if not numeric:
            plain = token[:-4] if token.endswith(".tex") else token
            hits = [e for e in entries if e[0] == plain or plain in Path(e[0]).parts]
            hits = hits or [e for e in entries if plain.lower() in e[0].lower()]
        if not hits and label in inline:
            die(T(f"第 {token} 章直接寫在 {main} 或 \\input 的檔案裡，沒辦法單獨編譯",
                  f"Chapter {token} is written in {main} or an \\input file and cannot be built alone"),
                T("把它移到自己的檔案，用 \\include 載入", "Move it into a file of its own and \\include it"))
        if len(hits) != 1:
            die(T(f"找不到第 {token} 章" if not hits else f"「{token}」對到不只一章",
                  f"No chapter {token}" if not hits else f'"{token}" matches more than one chapter'),
                T(f"\\include 的章：{listing}", f"\\include'd chapters: {listing}"))
        if hits[0] not in chosen:
            chosen.append(hits[0])
    if not chosen:
        die(T("--chapter 沒有給章號", "--chapter needs a chapter number"))
    return entries, chosen


WATCH_CHAPTER = []  # latexmk options for ax watch --chapter
WATCH_WHAT = []     # how ax watch --chapter names what it watches


def chapter_job(main, tokens):
    """(job name, pretex, label) for building the chosen chapters alone."""
    entries, chosen = pick_chapters(main, tokens)
    tags = [e[1][0] if e[1] else re.sub(r"[^\w-]+", "_", Path(e[0]).parent.name or Path(e[0]).name)
            for e in chosen]
    # main-ch2, main-ch1+3 (a dash would read as a range)
    job = f"{main.stem}-ch{'+'.join(tags)}"
    build = Path("build")
    build.mkdir(exist_ok=True)
    others = [e for e in entries if e not in chosen]
    if any(not (build / f"{e[0]}.aux").exists() for e in others):
        warn(T("還沒有完整編譯過：其他章的章號、頁碼和交叉引用可能不對；先跑一次 ax build",
               "No full build yet: numbers and cross-references from other chapters may be "
               "wrong; run ax build once first"))
    # Start from the full build's aux: saves a LaTeX run and keeps references.
    if (build / f"{main.stem}.aux").exists() and not (build / f"{job}.aux").exists():
        shutil.copyfile(build / f"{main.stem}.aux", build / f"{job}.aux")
    names = ",".join(e[0] for e in chosen)
    what = T("、".join(tags), ", ".join(tags))
    return job, f"\\includeonly{{{names}}}", T(f"編譯第 {what} 章", f"Building chapter {what}")


def build_chapters(main, tokens):
    job, pretex, label = chapter_job(main, tokens)
    return safe_build(main, jobname=job, pretex=pretex, label=label)


# --- ax count: English words and CJK characters in the text ---

CJK_CHAR = re.compile("[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff"
                      "\uac00-\ud7af\U00020000-\U0003134f]")
WORD_RE = re.compile(r"[^\W_]+(?:['\u2019-][^\W_]+)*")
SKIP_ENVS = ("equation|align|gather|multline|flalign|alignat|eqnarray|math|displaymath|"
             "verbatim|Verbatim|lstlisting|minted|codeblock|comment|tikzpicture|tikzcd|"
             "algorithmic|thebibliography|filecontents")
# commands whose arguments are not prose: name -> how many {...} to drop
DROP_ARGS = {
    "label": 1, "ref": 1, "eqref": 1, "cref": 1, "Cref": 1, "pageref": 1, "cpageref": 1,
    "autoref": 1, "nameref": 1, "cite": 1, "citep": 1, "citet": 1, "parencite": 1,
    "textcite": 1, "autocite": 1, "footcite": 1, "nocite": 1, "includegraphics": 1,
    "includesvg": 1, "inputcode": 1, "lstinputlisting": 1, "input": 1, "include": 1,
    "subfile": 1, "includeonly": 1, "usepackage": 1, "RequirePackage": 1, "documentclass": 1,
    "begin": 1, "end": 1, "bibliography": 1, "bibliographystyle": 1, "addbibresource": 1,
    "printbibliography": 0, "url": 1, "href": 1, "hspace": 1, "vspace": 1, "setlength": 2,
    "setcounter": 2, "addtocounter": 2, "chapterdir": 1, "graphicspath": 1, "newcommand": 2,
    "renewcommand": 2, "providecommand": 2, "DeclareMathOperator": 2, "akizumisetup": 1,
    "hypersetup": 1, "color": 1, "textcolor": 1, "colorbox": 1, "code": 1, "path": 1,
    "typeout": 1, "pagestyle": 1, "thispagestyle": 1, "bibitem": 1, "newtheorem": 2,
    "numberwithin": 2, "captionsetup": 1, "tikzset": 1, "pgfplotsset": 1, "lstset": 1,
    "SI": 2, "si": 1, "num": 1,
}


def _drop_command(text, name, nargs):
    """Remove every \\name[*][opt]{arg}... (nargs brace groups, nested braces ok)."""
    pat = re.compile(r"\\" + re.escape(name) + r"(?![A-Za-z@])\*?")
    out, pos = [], 0
    for m in pat.finditer(text):
        if m.start() < pos:
            continue
        out.append(text[pos:m.start()])
        i, taken = m.end(), 0
        while i < len(text):
            j = i
            while j < len(text) and text[j] in " \t\n":
                j += 1
            if j < len(text) and text[j] == "[":
                close = text.find("]", j)
                if close < 0:
                    break
                i = close + 1
                continue
            if taken < nargs and j < len(text) and text[j] == "{":
                depth, k = 0, j
                while k < len(text):
                    if text[k] == "\\":
                        k += 2
                        continue
                    depth += {"{": 1, "}": -1}.get(text[k], 0)
                    k += 1
                    if depth == 0:
                        break
                i, taken = k, taken + 1
                continue
            break
        out.append(" ")
        pos = i
    out.append(text[pos:])
    return "".join(out)


def count_words(text):
    """(English words, CJK characters) in a piece of LaTeX, leaving out
    commands, math, code, labels and references."""
    text = strip_tex_comments(text)
    text = re.sub(r"\\verb\*?([^A-Za-z\s])(.*?)\1", " ", text)
    text = re.sub(r"\\begin\s*\{(?P<env>(?:%s)\*?)\}.*?\\end\s*\{(?P=env)\}" % SKIP_ENVS, " ", text, flags=re.S)
    text = re.sub(r"\\[$%&#_{}]", " ", text)  # escaped specials are not math or groups
    text = re.sub(r"\$\$.*?\$\$|\\\[.*?\\\]|\\\(.*?\\\)|\$.*?\$", " ", text, flags=re.S)
    for name, nargs in DROP_ARGS.items():
        if "\\" + name in text:
            text = _drop_command(text, name, nargs)
    text = re.sub(r"\\[A-Za-z@]+\*?(\s*\[[^\]]*\])?", " ", text)
    text = re.sub(r"\\.|[{}~^&#_]", " ", text)
    cjk = len(CJK_CHAR.findall(text))
    words = len(WORD_RE.findall(CJK_CHAR.sub(" ", text)))
    return words, cjk


def count_files(main):
    """[(file, words, cjk)] for main's body and every file it \\input's,
    \\include's or \\subfile's, in order."""
    rows, seen = [], set()
    dirs = [main.parent]

    def visit(path, depth):
        key = path.resolve()
        if key in seen or depth > 8:
            return
        seen.add(key)
        text = path.read_text(errors="replace")
        if depth == 0 or "\\begin{document}" in text:
            text = tex_body(text)
        text = strip_tex_comments(text)
        rows.append((path, *count_words(text)))
        for m in CHAPTER_TOKEN.finditer(text):
            if m.group(5) is not None:
                d = m.group(5).strip().rstrip("/")
                dirs[:] = [main.parent / d, main.parent] if d else [main.parent]
            elif m.group(3):
                found = find_tex(m.group(4).strip(), dirs + [path.parent])
                if found:
                    visit(found, depth + 1)

    visit(main, 0)
    return rows


def cmd_count(a):
    if a.limit is not None and a.limit < 1:
        die(T(f"--limit 要是正整數，不是 {a.limit}", f"--limit must be a positive number, not {a.limit}"))
    main = main_file(a.file)
    rows = count_files(main)
    words = sum(r[1] for r in rows)
    cjk = sum(r[2] for r in rows)
    total = words + cjk
    if len(rows) > 1:
        width = min(48, max(len(str(r[0])) for r in rows))
        head = lambda t: " " * (8 - len(t) - len(CJK_CHAR.findall(t))) + t  # CJK is double width
        print(f"  {'':<{width}}  {head(T('英文字', 'words'))}  {head(T('中日韓字', 'CJK'))}")
        for path, w, c in rows:
            print(f"  {str(path):<{width}}  {w:>8,}  {c:>8,}")
        print()
    ok(T(f"英文 {words:,} 字、中日韓 {cjk:,} 字，共 {total:,}",
         f"{words:,} English word{'' if words == 1 else 's'} + "
         f"{cjk:,} CJK character{'' if cjk == 1 else 's'} = {total:,}"))
    note(T("  不算指令、數學、程式碼、\\label／\\ref／\\cite 和註解",
           "  Commands, math, code, \\label / \\ref / \\cite and comments are not counted"))
    if a.limit is not None:
        if total > a.limit:
            warn(T(f"超過上限 {a.limit:,}：多了 {total - a.limit:,}",
                   f"Over the limit of {a.limit:,} by {total - a.limit:,}"))
        else:
            ok(T(f"在上限 {a.limit:,} 以內，還剩 {a.limit - total:,}",
                 f"Within the limit of {a.limit:,}; {a.limit - total:,} to spare"))


# --- ax doctor: what this project's build needs ---

def doctor_build_checks(cfg, report, optional):
    missing = T("找不到", "not found")
    for step in prebuild_steps(cfg):
        for prog in step_programs(step):
            where = shutil.which(prog)
            report(bool(where), T(f"前置步驟用的 {prog}", f"{prog} (used by prebuild)"), where or missing,
                   T('安裝它或把它加進 PATH；步驟寫在 .ax.json 的 "prebuild"',
                     'Install it or add it to PATH; the steps are "prebuild" in .ax.json'))
    sources = []
    for p in Path(".").rglob("*"):
        if p.suffix in (".tex", ".sty", ".cls") and not {"build", ".git"} & set(p.parts):
            try:
                sources.append((p, strip_tex_comments(p.read_text(errors="replace"))))
            except OSError:
                pass
    text = "\n".join(t for _, t in sources)
    shell = cfg.get("shell_escape") is True
    if shell:
        optional(True, "shell_escape", T("LaTeX 可以執行外部程式", "LaTeX may run programs"))
    if "\\includesvg" in text or re.search(r"\\usepackage\s*(\[[^\]]*\])?\s*\{[^}]*\bsvg\b", text):
        where = shutil.which("inkscape")
        detail = where or missing
        if not where and MACOS and Path("/Applications/Inkscape.app").exists():
            detail = T("裝了但不在 PATH 上：ln -s /Applications/Inkscape.app/Contents/MacOS/inkscape ~/bin/",
                       "installed but not on PATH: ln -s /Applications/Inkscape.app/Contents/MacOS/inkscape ~/bin/")
        report(bool(where), T("inkscape（svg 圖）", "inkscape (svg figures)"), detail,
               T("安裝 Inkscape（https://inkscape.org）並放到 PATH；svg 套件靠它把 .svg 轉成 PDF",
                 "Install Inkscape (https://inkscape.org) and put it on PATH; the svg package "
                 "converts .svg to PDF with it"))
        if not shell:
            optional(False, T("svg 套件要 shell_escape 才能轉檔", "the svg package needs shell_escape to convert"),
                     T('在 .ax.json 加 "shell_escape": true', 'add "shell_escape": true to .ax.json'))
    # packages outside TeX Live (stata.sty, a venue's style) must sit in the project
    names = set()
    for group in re.findall(r"\\(?:usepackage|RequirePackage)\s*(?:\[[^\]]*\])?\s*\{([^}]*)\}", text):
        names |= {n.strip() for n in group.split(",") if re.fullmatch(r"[\w.-]+", n.strip())}
    names = {n for n in names if not n.startswith(("akizumi", "aaron", "beamertheme"))}
    names -= {p.stem for p, _ in sources if p.suffix == ".sty"}
    if names and shutil.which("kpsewhich"):
        try:
            out = subprocess.run(["kpsewhich", *sorted(f"{n}.sty" for n in names)],
                                 capture_output=True, text=True, timeout=60).stdout
        except (OSError, subprocess.TimeoutExpired):
            out = None
        if out is not None:
            found = {Path(line.strip()).stem for line in out.splitlines() if line.strip()}
            lost = sorted(names - found)
            report(not lost, T("專案用到的套件", "Packages the project uses"),
                   ", ".join(f"{n}.sty" for n in lost) if lost else
                   T(f"{len(names)} 個都找得到", f"all {len(names)} found"),
                   T("不在 TeX Live 裡的套件（例如 stata.sty）放進專案資料夾；其他用 tlmgr install 安裝",
                     "Put packages that are not in TeX Live (stata.sty, say) in the project folder; "
                     "install the others with tlmgr install"))


# --- ax selftest: the build pipeline ---

def selftest_build(ax, tmp, result):
    sample = (r"Hello world, it's 2026. 你好世界 $x+y$ \cite{k} \textbf{bold}"
              "\n\\begin{equation}a = b\\end{equation} % not counted\n")
    result(count_words(sample) == (5, 4), T("ax count 字數", "ax count words"))
    d = tmp / "t-build"
    run = lambda *args: subprocess.run(ax + list(args), cwd=d, stdin=subprocess.DEVNULL,
                                       capture_output=True, encoding="utf-8", errors="replace")
    r = subprocess.run(ax + ["new", "book", str(d), "--title", "Test", "--no-preamble", "--pin", "latest"],
                       stdin=subprocess.DEVNULL, capture_output=True, encoding="utf-8", errors="replace")
    if r.returncode:
        result(False, T("專案 prebuild／shell_escape／--chapter", "project prebuild / shell_escape / --chapter"))
        print(r.stdout + r.stderr)
        return
    (d / "chapters").mkdir()
    (d / "chapters" / "two.tex").write_text(
        "\\chapter{Second}\\typeout{AXCHAPTER=\\thechapter}\n\\input{gen}\n"
        "\\typeout{AXSHELL=\\the\\shellescape}\n")
    main_tex = d / "main.tex"
    main_tex.write_text(main_tex.read_text().replace(
        "\\section{Motivation}\n", "\\section{Motivation}\n\n\\include{chapters/two}\n"))
    cfg = json.loads((d / PROJECT_CONFIG).read_text())
    py = f'"{sys.executable}"'
    cfg.update(prebuild=[py + ' -c "open(\'gen.tex\', \'w\').write(\'Generated text.\')"'],
               shell_escape=True)
    (d / PROJECT_CONFIG).write_text(json.dumps(cfg, indent=2) + "\n")
    r = run("build")
    log = (d / "build" / "main.log").read_text(errors="replace") if (d / "build" / "main.log").exists() else ""
    good = r.returncode == 0 and (d / "gen.tex").exists() and "AXSHELL=1" in log
    result(good, T("專案 prebuild + shell_escape", "project prebuild + shell_escape"))
    if not good:
        print(r.stdout + r.stderr)
    r = run("build", "--chapter", "2")
    log = d / "build" / "main-ch2.log"
    good = (r.returncode == 0 and (d / "main-ch2.pdf").exists() and log.exists()
            and "AXCHAPTER=2" in log.read_text(errors="replace"))
    result(good, T("專案 build --chapter 2（保留章號）", "project build --chapter 2 (real number)"))
    if not good:
        print(r.stdout + r.stderr)
    r = run("count", "--limit", "1")
    result(r.returncode == 0 and "1" in r.stdout, T("專案 ax count", "project ax count"))
    cfg["prebuild"] = [py + ' -c "import sys; sys.exit(3)"']
    (d / PROJECT_CONFIG).write_text(json.dumps(cfg, indent=2) + "\n")
    before = (d / "main.pdf").stat().st_mtime if (d / "main.pdf").exists() else None
    r = run("build")
    after = (d / "main.pdf").stat().st_mtime if (d / "main.pdf").exists() else None
    good = r.returncode == 1 and before is not None and before == after and "3" in r.stderr
    result(good, T("專案 prebuild 失敗時停止", "project prebuild failure stops the build"))
    if not good:
        print(r.stdout + r.stderr)


def selftest_pdfname(ax, tmp, result):
    """"pdf" in .ax.json: ax build, ax both and a plain latexmk run (Cursor)
    write the PDF under that name; ax migrate --project picks up a tracked PDF."""
    d = tmp / "t-pdfname"
    label = T('專案 .ax.json "pdf"（build、both、Cursor、migrate）',
              'project .ax.json "pdf" (build, both, Cursor, migrate)')
    run = lambda *args: subprocess.run(list(args), cwd=d, stdin=subprocess.DEVNULL, capture_output=True,
                                       encoding="utf-8", errors="replace", timeout=300)
    r = subprocess.run(ax + ["new", "hw", str(d), "--title", "Test", "--no-preamble", "--pin", "latest"],
                       stdin=subprocess.DEVNULL, capture_output=True, encoding="utf-8", errors="replace")
    out = r.stdout + r.stderr
    good = r.returncode == 0
    if good:
        cfg = load_json(d / PROJECT_CONFIG)
        cfg["pdf"] = "報告 v2.pdf"
        (d / PROJECT_CONFIG).write_text(json.dumps(cfg, indent=2) + "\n")  # \u escapes, as save_project_config
        r = run(*ax, "both")
        out = r.stdout + r.stderr
        good = (r.returncode == 0 and (d / "報告 v2.pdf").exists() and (d / "報告 v2-solutions.pdf").exists()
                and not (d / "main.pdf").exists() and not (d / "main-solutions.pdf").exists())
    if good:
        (d / "報告 v2.pdf").unlink()
        main_tex = d / "main.tex"
        main_tex.write_text(main_tex.read_text() + "\n% edited\n")
        r = run("latexmk", "-interaction=nonstopmode", "-file-line-error", "main.tex")
        out = r.stdout + r.stderr
        good = r.returncode == 0 and (d / "報告 v2.pdf").exists() and not (d / "main.pdf").exists()
    if good and shutil.which("git"):
        m = tmp / "t-pdfname-migrate"
        m.mkdir()
        shutil.copy(REPO / "tests" / "migrate" / "old-hw.tex", m / "old-hw.tex")
        shutil.copy(d / "報告 v2-solutions.pdf", m / "HW3.pdf")
        for args in (["init", "-q"], ["add", "."]):
            subprocess.run(["git", "-C", str(m)] + args, stdin=subprocess.DEVNULL, capture_output=True)
        r = subprocess.run(ax + ["migrate", "old-hw.tex", "--project"], cwd=m, stdin=subprocess.DEVNULL,
                           capture_output=True, encoding="utf-8", errors="replace")
        out = r.stdout + r.stderr
        good = r.returncode == 0 and load_json(m / PROJECT_CONFIG).get("pdf") == "HW3.pdf"
    result(good, label)
    if not good:
        print(out)


# ---------- ax watch, in the foreground or the background ----------
# A background watcher is latexmk -pvc started detached; build/watch.json
# records it, build/watch.log collects its output, and build/watch-last.json
# holds the result of its latest run (written by copypdf / explain below,
# which latexmk calls after each run).

WATCH_STATE = Path("build") / "watch.json"
WATCH_LOG = Path("build") / "watch.log"
WATCH_LAST = Path("build") / "watch-last.json"
WINDOWS_STILL_ACTIVE = 259


def record_watch_result(good, job):
    if os.environ.get("AX_WATCH_BG"):
        try:
            WATCH_LAST.write_text(json.dumps({"ok": good, "job": job, "time": time.time()}))
        except OSError:
            pass


def watch_cmd(main, background=False):
    cmd = ["latexmk", "-pvc", "-silent", "-interaction=nonstopmode", "-file-line-error"]
    pdf = "%D"  # the file latexmk would show
    if background:
        # no viewer to open, nobody to see it; %D is then empty, so name the
        # PDF as out_dir + job name
        cmd.append("-view=none")
        pdf = "%Z%R.pdf"
    cmd += latexmk_flags(main=main) + WATCH_CHAPTER  # .ax.json / minted; ax watch --chapter
    return cmd + ["-e", f"$success_cmd = q({AX_CMD} copypdf {pdf} %R.pdf);",
                  "-e", f"$failure_cmd = q({AX_CMD} explain %R);", str(main)]


def pid_alive(pid):
    if WINDOWS:
        import ctypes
        kernel32 = ctypes.windll.kernel32
        handle = kernel32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
        if not handle:
            return False
        code = ctypes.c_ulong()
        got = kernel32.GetExitCodeProcess(handle, ctypes.byref(code))
        kernel32.CloseHandle(handle)
        return bool(got) and code.value == WINDOWS_STILL_ACTIVE
    try:
        os.kill(pid, 0)
    except PermissionError:
        return True
    except OSError:
        return False
    # the pid may have been reused by an unrelated process since
    r = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True)
    return r.returncode != 0 or "latexmk" in r.stdout


def watcher():
    """The background watcher for this folder as a dict, or None. A record
    whose process has gone is removed."""
    try:
        state = json.loads(WATCH_STATE.read_text())
        pid = int(state["pid"])
    except (OSError, ValueError, KeyError, TypeError):
        return None
    if pid_alive(pid):
        return state
    try:
        WATCH_STATE.unlink()
    except OSError:
        pass
    return None


def warn_if_watching():
    if watcher():
        warn(T("背景有 ax watch 在跑，兩邊會搶 build/；需要時先 ax watch --stop",
               "A background ax watch is running and will compete for build/; "
               "run ax watch --stop first if this misbehaves"))


def clock(epoch):
    return time.strftime("%H:%M:%S" if time.time() - epoch < 86400 else "%m/%d %H:%M",
                         time.localtime(epoch))


def watch_background(main):
    running = watcher()
    if running:
        ok(T(f"背景已經在監看 {running.get('main')}（PID {running['pid']}，{clock(running['started'])} 開始）",
             f"Already watching {running.get('main')} in the background "
             f"(PID {running['pid']}, since {clock(running['started'])})"))
        note(T("  ax watch --status 看狀態，ax watch --stop 停止",
               "  ax watch --status for its state, ax watch --stop to stop it"))
        return
    Path("build").mkdir(exist_ok=True)
    for f in (WATCH_LAST,):
        try:
            f.unlink()
        except OSError:
            pass
    env = dict(os.environ, AX_WATCH_BG="1", PYTHONIOENCODING="utf-8", NO_COLOR="1")
    log = open(WATCH_LOG, "ab")
    log.write(f"\n=== ax watch --bg {time.strftime('%Y-%m-%d %H:%M:%S')} {main}\n".encode())
    log.flush()
    kwargs = dict(stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, env=env)
    if WINDOWS:
        # A hidden console of its own (not DETACHED_PROCESS, or every xelatex
        # run would flash a window), its own process group, and out of the
        # terminal's job when that is allowed, so closing the terminal
        # leaves it running.
        flags = 0x08000000 | 0x00000200  # CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP
        try:
            proc = subprocess.Popen(watch_cmd(main, True), creationflags=flags | 0x01000000, **kwargs)
        except OSError:  # the job forbids breaking away
            proc = subprocess.Popen(watch_cmd(main, True), creationflags=flags, **kwargs)
    else:
        proc = subprocess.Popen(watch_cmd(main, True), start_new_session=True, **kwargs)
    log.close()
    what = WATCH_WHAT[0] if WATCH_WHAT else str(main)
    WATCH_STATE.write_text(json.dumps({"pid": proc.pid, "started": time.time(), "main": what}))
    ok(T(f"背景開始監看 {cmd_text(what)}（PID {proc.pid}）：存檔就重編，成功才更新 PDF",
         f"Watching {cmd_text(what)} in the background (PID {proc.pid}): rebuilds on save, "
         "updates the PDF only on success"))
    note(T(f"  ax watch --status 看結果 {MARK['dot']} ax watch --log 看輸出 {MARK['dot']} ax watch --stop 停止",
           f"  ax watch --status for results {MARK['dot']} ax watch --log for output "
           f"{MARK['dot']} ax watch --stop to stop"))


def watch_status():
    running = watcher()
    if not running:
        note(T("沒有背景監看；ax watch --bg 開始", "No background watcher; start one with ax watch --bg"))
        return 1
    ok(T(f"背景監看中：{running.get('main')}（PID {running['pid']}，{clock(running['started'])} 開始）",
         f"Watching {running.get('main')} in the background "
         f"(PID {running['pid']}, since {clock(running['started'])})"))
    try:
        last = json.loads(WATCH_LAST.read_text())
    except (OSError, ValueError):
        last = None
    if not last:
        note(T("  還沒有編譯結果：第一次編譯中，或 PDF 已是最新、等你存檔",
               "  No build yet: the first one is running, or the PDF is up to date and it waits for a save"))
    elif last.get("ok"):
        ok(T(f"上次編譯成功（{clock(last['time'])}）", f"Last build succeeded ({clock(last['time'])})"))
    else:
        fail(T(f"上次編譯失敗（{clock(last['time'])}），PDF 保留上一份",
               f"Last build failed ({clock(last['time'])}); the PDF stays as it was"))
        if not print_error(Path("build") / f"{last.get('job', 'main')}.log"):
            note(T("  log 裡沒有 LaTeX 錯誤；ax watch --log 看 latexmk 的輸出",
                   "  No LaTeX error in the log; see latexmk's output with ax watch --log"), err=True)
    return 0


def watch_stop():
    running = watcher()
    if not running:
        note(T("沒有背景監看在跑", "No background watcher is running"))
        return 0
    pid = int(running["pid"])
    if WINDOWS:
        subprocess.run(["taskkill", "/PID", str(pid), "/T", "/F"], capture_output=True)
    else:
        import signal
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(pid, sig)  # latexmk and the xelatex it runs
            except ProcessLookupError:
                break
            except OSError:
                try:
                    os.kill(pid, sig)
                except OSError:
                    break
            for _ in range(50):
                if not pid_alive(pid):
                    break
                time.sleep(0.1)
            if not pid_alive(pid):
                break
    if pid_alive(pid):
        die(T(f"停不掉 PID {pid}", f"Could not stop PID {pid}"),
            T("用工作管理員或 kill 手動結束它", "End it by hand (Task Manager or kill)"))
    for f in (WATCH_STATE, WATCH_LAST):
        try:
            f.unlink()
        except OSError:
            pass
    ok(T(f"已停止背景監看（PID {pid}）", f"Stopped the background watcher (PID {pid})"))
    return 0


def watch_follow():
    """tail -f build/watch.log until Ctrl-C, or until the watcher stops."""
    if not WATCH_LOG.exists():
        note(T("還沒有 build/watch.log；ax watch --bg 開始", "No build/watch.log yet; start with ax watch --bg"))
        return 1
    with open(WATCH_LOG, "rb") as f:
        lines = f.read().decode("utf-8", "replace").splitlines()
        sys.stdout.write("\n".join(lines[-30:]) + "\n")
        sys.stdout.flush()
        if not watcher():
            note(T("（背景監看沒有在跑）", "(no background watcher is running)"))
            return 0
        note(T("（Ctrl-C 結束；監看本身繼續跑）", "(Ctrl-C to quit; the watcher keeps running)"))
        idle = 0
        while True:
            chunk = f.read()
            if chunk:
                sys.stdout.write(chunk.decode("utf-8", "replace"))
                sys.stdout.flush()
                idle = 0
                continue
            time.sleep(0.5)
            idle += 1
            if idle % 10 == 0 and not watcher():
                note(T("（背景監看已停止）", "(the background watcher stopped)"))
                return 0


def cmd_watch(a):
    if a.status or a.stop or a.log:
        if not a.file:
            find_project(quiet=True)
        sys.exit(watch_status() if a.status else watch_stop() if a.stop else watch_follow())
    main = main_file(a.file)
    remember_project()
    need_tool("latexmk", T("請先安裝 TeX Live，再執行 ax doctor", "Install TeX Live, then run ax doctor"))
    if not watcher():
        run_prebuild(a)  # once, before watching; not on every save
    if a.chapter:
        job, pretex, label = chapter_job(main, a.chapter)
        WATCH_CHAPTER[:] = [f"-jobname={job}", f"-usepretex={pretex}"]
        which = label.replace(T("編譯", "Building "), "", 1)  # 第 2 章 / chapter 2
        WATCH_WHAT[:] = [T(f"{main}（{which}，{job}.pdf）", f"{main} ({which}, {job}.pdf)")]
    if a.bg:
        watch_background(main)
        return
    if watcher():
        die(T("背景已經有 ax watch 在跑", "A background ax watch is already running"),
            T("ax watch --log 看它的輸出，或 ax watch --stop 停掉再在前景監看",
              "ax watch --log shows its output; ax watch --stop stops it so you can watch here"))
    what = WATCH_WHAT[0] if WATCH_WHAT else str(main)
    print(T(f"監看 {cmd_text(what)}：存檔就重編，成功才更新 PDF。按 Ctrl-C 停止。",
            f"Watching {cmd_text(what)}: rebuilds on save, updates the PDF only on "
            "success. Ctrl-C stops."))
    try:
        sys.exit(subprocess.call(watch_cmd(main)))
    except KeyboardInterrupt:
        print()
        note(T("已停止監看", "Stopped watching"))


def cmd_both(a):
    main = main_file(a.file)
    kind = project_config().get("kind")
    if kind and kind not in ("hw", "exam"):
        die(T(f"ax both 只用在作業和考卷；這個專案是{KIND_NAME.get(kind, kind)}",
              f"ax both is for homework and exams; this project is {KIND_NAME.get(kind, kind)}"))
    warn_if_watching()
    run_prebuild(a)
    ok1 = safe_build(main, pretex=r"\def\akizumisolutions{false}",
                     label=T("編譯題目卷", "Building the problems"))
    # the problems share build/main.* with ax build and Cursor, which build
    # with solutions: make their next build start from scratch too
    (Path("build") / f"{main.stem}.fdb_latexmk").unlink(missing_ok=True)
    ok2 = safe_build(main, jobname=f"{main.stem}-solutions",
                     pretex=r"\def\akizumisolutions{true}", label=T("編譯解答", "Building the solutions"))
    sys.exit(0 if ok1 and ok2 else 1)


def open_file(path):
    if MACOS:
        subprocess.run(["open", str(path)])
    elif WINDOWS:
        os.startfile(str(path))  # noqa: the default PDF viewer
    else:
        subprocess.run(["xdg-open", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_open(a):
    if a.file:
        tex = Path(a.file).with_suffix(".tex")
        pdf = output_pdf(tex.stem, tex) if Path(PROJECT_CONFIG).exists() else tex.with_suffix(".pdf")
    else:
        cfg = require_project()
        stem = Path(cfg.get("main", "main.tex")).stem
        pdf = output_pdf(f"{stem}-solutions" if a.solutions else stem, cfg=cfg)
    if not pdf.exists():
        die(T(f"還沒有 {pdf}", f"There is no {pdf} yet"),
            T(f"先執行 {cmd_text('ax build')}" + ("（或 ax both）" if a.solutions else ""),
              f"Run {cmd_text('ax build')}" + (" (or ax both)" if a.solutions else "") + " first"))
    open_file(pdf)
    ok(T(f"已打開 {pdf}", f"Opened {pdf}"))


# ---------- versions ----------

def cmd_texinputs(a):
    d = template_dir(find_project(quiet=True).get("template"))
    if d:
        print(d)


def cmd_freeze(a):
    cfg = require_project()
    if cfg.get("template") == "frozen":
        die(T("這個專案已經 freeze 過了", "This project is already frozen"),
            T(f"要回到版本管理：{cmd_text('ax upgrade')}", f"To go back to versions: {cmd_text('ax upgrade')}"))
    source = template_dir(cfg.get("template")) or REPO
    files = template_files(source)
    for f in files:
        shutil.copy2(f, f.name)
    cfg["frozen_from"] = cfg.get("template")
    cfg["template"] = "frozen"
    save_project_config(cfg)
    ok(T(f"已複製 {len(files)} 個模板檔進專案（來自 {cfg['frozen_from']}）",
         f"Copied {len(files)} template files into the project (from {cfg['frozen_from']})"))
    note(T("  之後這個專案只靠自己就能編譯，可以交出去或封存",
           "  The project now builds on its own; hand it in or archive it"))


def cmd_upgrade(a):
    cfg = require_project()
    tags = template_tags()
    if not tags:
        die(T("模板 repo 還沒有任何版本 tag", "The template repo has no version tags yet"))
    old = cfg.get("template")
    if old == tags[0]:
        ok(T(f"已經是最新的模板 {old}", f"Already on the newest template, {old}"))
        return
    if old == "latest":
        # latest is the repo as it is now, newer than any tag: moving to the
        # newest tag would go back to older templates
        ok(T(f"這個專案用 latest，已經跟著模板 repo 的最新內容（比最新的版本 {tags[0]} 還新），不用升級",
             f"This project uses latest, which follows the template repo as it is now "
             f"(newer than the newest version, {tags[0]}); nothing to upgrade"))
        return
    if old == "frozen":
        for f in template_files("."):
            f.unlink()
        cfg.pop("frozen_from", None)
        note(T("  已移除 freeze 時複製進來的模板檔", "  Removed the template files copied in by freeze"))
    cfg["template"] = tags[0]
    save_project_config(cfg)
    new_dir = template_dir(tags[0])
    if new_dir and (new_dir / "akizumi-core.sty").exists():
        rename_aaron(Path(cfg.get("main", "main.tex")).parent)
    rc = Path("latexmkrc")
    if not rc.exists() or rc.read_text().startswith("# Written by ax"):
        write_build_files(".", cfg.get("kind"))
        note(T("  已更新 latexmkrc 和 .vscode/settings.json", "  Updated latexmkrc and .vscode/settings.json"))
    ok(T(f"模板 {old} → {tags[0]}", f"Template {old} -> {tags[0]}"))
    print(T(f"  接著跑 {cmd_text('ax build')} 確認一切正常；改了什麼見模板 repo 的 CHANGELOG.md",
            f"  Run {cmd_text('ax build')} to check; what changed is in the template repo's CHANGELOG.md"))


AARON_SWAPS = [(re.compile(r"(\\usetheme(?:\[[^\]]*\])?)\{Aaron\}"), r"\1{Akizumi}"),
               (re.compile(r"beamerthemeAaron"), "beamerthemeAkizumi"),
               # package files (aaron-hw), macros (\\aaronsetup, \\aaron@x), styles (aaron/box);
               # not a word or URL that merely contains it (aaronlin1229.github.io)
               (re.compile(r"(?<=\\)aaron(?=[A-Za-z@])"), "akizumi"),
               (re.compile(r"(?<![\w./:@-])aaron(?=[-/@][A-Za-z])"), "akizumi")]


def rename_aaron(root):
    """v0.6 renamed the package from aaron to akizumi: rewrite the old names
    in the project's .tex files. 'Aaron Lin' in \\author is left alone."""
    swaps = AARON_SWAPS
    for tex in sorted(Path(root).rglob("*.tex")):
        if "build" in tex.parts:
            continue
        text = tex.read_text()
        new = text
        for pattern, repl in swaps:
            new = pattern.sub(repl, new)
        if new != text:
            tex.write_text(new)
            note(T(f"  {tex}：舊名稱 aaron 改成 akizumi", f"  {tex}: renamed aaron to akizumi"))


# ---------- ax pack ----------

def cmd_pack(a):
    cfg = require_project()
    name = Path.cwd().name
    out = Path(f"{name}-overleaf.zip")
    skip_dirs = {"build", ".git", ".vscode"}
    count = 0
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        for path in sorted(Path(".").rglob("*")):
            if path.is_dir() or skip_dirs & set(path.parts) or path == out:
                continue
            if path.suffix == ".pdf" or path.name in (PROJECT_CONFIG, "latexmkrc"):
                continue
            z.write(path)
            count += 1
        if cfg.get("template") != "frozen":
            for f in template_files(template_dir(cfg.get("template")) or REPO):
                z.write(f, f.name)
                count += 1
        shared = shared_preamble()
        if shared and not (Path(".") / SHARED_PREAMBLE).is_file():
            z.write(shared, SHARED_PREAMBLE.as_posix())
            count += 1
        engine = 1 if cfg.get("kind") == "paper" else 5
        z.writestr("latexmkrc", f"$pdf_mode = {engine};\n")
    ok(T(f"已打包 {out}（{count + 1} 個檔案，含模板檔）",
         f"Packed {out} ({count + 1} files, templates included)"))
    compiler = cmd_text('pdfLaTeX' if cfg.get('kind') == 'paper' else 'XeLaTeX')
    print(T(f"  上傳到 Overleaf（New Project → Upload Project），在 Menu 把 Compiler 設成 {compiler}",
            f"  Upload it to Overleaf (New Project -> Upload Project) and set Menu -> Compiler to {compiler}"))


# ---------- ax doctor ----------

CJK_FONTS = {  # sans, serif: the first choice on each system
    "zh": {"mac": ("PingFang TC", "Songti TC"), "win": ("Microsoft JhengHei", "MingLiU"),
           "linux": ("Noto Sans CJK TC", "Noto Serif CJK TC")},
    "ja": {"mac": ("Hiragino Sans", "Hiragino Mincho ProN"), "win": ("Yu Gothic", "Yu Mincho"),
           "linux": ("Noto Sans CJK JP", "Noto Serif CJK JP")},
    "ko": {"mac": ("Apple SD Gothic Neo", "AppleMyungjo"), "win": ("Malgun Gothic", "Batang"),
           "linux": ("Noto Sans CJK KR", "Noto Serif CJK KR")},
}


# --- akizumi-math: macros the project redefines (ax doctor) ---
MATH_DEF_RE = re.compile(r"\\(?:(?:re|provide)?newcommand\*?|DeclareMathOperator\*?|DeclarePairedDelimiter\w*"
                         r"|[gex]?def|let)\s*\{?\s*\\([A-Za-z]+)(?![A-Za-z])")
TEXT_LETTERS = set("abcdijklortuv")  # LaTeX's text commands (accents, \i, \l, \o) among \a..\z


def math_clashes(sty):
    """{file: (akizumi-math names it redefines, text letters it overwrites)} for the project's sources."""
    try:
        text = sty.read_text(errors="replace")
    except OSError:
        return {}
    names = set(re.findall(r"\\akizumi@(?:new|newdelim|op|oplim)\s*\\([A-Za-z]+)", text)) - {"csname"}
    found = {}
    files = [p for p in sorted(Path(".").rglob("*")) if p.suffix in (".tex", ".sty")
             and "build" not in p.parts and not p.name.startswith("akizumi-")][:200]
    for p in files:
        try:
            src = re.sub(r"(?<!\\)%.*", "", p.read_text(errors="replace"))
        except OSError:
            continue
        defined = MATH_DEF_RE.findall(src)
        ours = sorted(set(defined) & names)
        letters = sorted(set(defined) & TEXT_LETTERS)
        if ours or letters:
            found[str(p)] = (ours, letters)
    return found
# --- end akizumi-math ---


def cmd_doctor(a):
    problems = []

    def report(good, label, detail="", fix=""):
        mark = _paint(MARK["ok"], "32") if good else _paint(MARK["fail"], "31")
        print(f"  {mark} {label}" + (_paint(f"  {detail}", "2") if detail else ""))
        if not good:
            problems.append((label, fix))

    def optional(good, label, detail=""):
        mark = _paint(MARK["ok"], "32") if good else _paint("–", "2")
        print(f"  {mark} {label}" + (_paint(f"  {detail}", "2") if detail else ""))

    def run(*cmd):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired):
            return None

    missing = T("找不到", "not found")
    print(cmd_text(T("工具", "Tools")))
    for tool in ("xelatex", "latexmk", "pdflatex"):
        report(bool(shutil.which(tool)), tool, shutil.which(tool) or missing,
               T("安裝 TeX Live（https://tug.org/texlive/）後開新的終端機",
                 "Install TeX Live (https://tug.org/texlive/), then open a new terminal"))
    r = run("biber", "--version")
    biber_ok = bool(r) and r.returncode == 0
    report(biber_ok, T("biber（參考文獻）", "biber (references)"),
           (r.stdout.strip().splitlines() or [""])[-1] if biber_ok else T("啟動失敗", "does not start"),
           T("見 docs/reference.md〈疑難排解〉", "See Troubleshooting in docs/reference.md"))
    # index=true: latexmk runs upmendex when it is there, else makeindex
    optional(bool(shutil.which("upmendex")), T("upmendex（中日韓索引排序）", "upmendex (CJK index sorting)"),
             "" if shutil.which("upmendex") else T("沒裝，索引改用 makeindex，中文照字碼排",
                                                   "not installed; makeindex sorts CJK terms by code point"))
    report(bool(shutil.which("git")), "git", "" if shutil.which("git") else missing,
           T("安裝 git；模板版本靠它管理", "Install git; template versions rely on it"))
    report(bool(shutil.which("ax")), T("ax 在 PATH 上", "ax on PATH"), "" if shutil.which("ax") else missing,
           T("在模板 repo 執行 install.py，然後開新的終端機",
             "Run install.py in the template repo, then open a new terminal"))

    print(cmd_text(T("模板", "Templates")))
    r = run("kpsewhich", "akizumi-core.sty")
    found = r.stdout.strip() if r else ""
    report(bool(found), T("TeX 找得到模板", "TeX finds the templates"), found or missing,
           T("在模板 repo 執行 install.py", "Run install.py in the template repo"))
    tags = template_tags()
    report(bool(tags), T("模板版本", "Template versions"),
           T("、", ", ").join(tags[:5]) or T("沒有 tag", "no tags"),
           T("在模板 repo 打版本 tag", "Tag a version in the template repo"))

    print(cmd_text(T("字型", "Fonts")))
    for f in ("Lato-Regular.ttf", "NewCM10-Book.otf", "bboldx.sty"):
        r = run("kpsewhich", f)
        report(bool(r and r.stdout.strip()), f, "",
               T("用 tlmgr 安裝缺少的字型套件", "Install the missing font package with tlmgr"))
    # First choice per system; akizumi-core falls back along the same chain.
    # Japanese / Korean fonts are checked when config.json sets that language.
    system = "mac" if MACOS else "win" if WINDOWS else "linux"
    families = CJK_FONTS["zh"][system]
    lang = load_json(USER_CONFIG).get("lang", "en")
    if lang in ("ja", "ko"):
        families += CJK_FONTS[lang][system]
    if shutil.which("fc-list"):
        for family in families + ("JetBrains Mono",):
            r = run("fc-list", family, "family")
            good = bool(r and r.stdout.strip())
            optional(good, family, "" if good else T("沒裝，會自動改用其他字型",
                                                     "not installed; another font is used instead"))
    else:
        optional(False, T("中文字型", "CJK fonts"),
                 T("沒有 fc-list，無法檢查；缺字型時會自動改用其他字型",
                   "no fc-list to check with; missing fonts are replaced automatically"))

    cfg = find_project(quiet=True)
    if cfg:
        print(cmd_text(T("這個專案", "This project")))
        pin = cfg.get("template")
        if pin == "frozen":
            report(bool(template_files(".")), T("模板檔已複製進專案", "Template files copied into the project"),
                   T(f"來自 {cfg.get('frozen_from')}", f"from {cfg.get('frozen_from')}"),
                   T("ax upgrade 重新取得模板", "ax upgrade fetches the templates again"))
        else:
            d = template_dir(pin)
            report(pin == "latest" or bool(d), T(f"模板 {pin}", f"Template {pin}"),
                   str(d or T("使用安裝的最新版", "uses the installed files")),
                   T("這個版本不存在；ax upgrade 換到最新版",
                     "This version does not exist; ax upgrade moves to the newest"))
            if tags and pin not in ("latest", tags[0]):
                optional(False, T(f"有新版模板 {tags[0]}", f"Newer template {tags[0]}"),
                         T("想用新外觀就跑 ax upgrade", "run ax upgrade for the new look"))
        # --- akizumi-math: macros the project redefines ---
        sty = REPO / "akizumi-math.sty"
        if not sty.exists() and found:
            sty = Path(found).with_name("akizumi-math.sty")
        clashes = math_clashes(sty)
        for name, (ours, letters) in clashes.items():
            if ours:
                cs = " ".join("\\" + n for n in ours)
                optional(False, T(f"{name} 重新定義了 akizumi-math 的 {cs}",
                                  f"{name} redefines akizumi-math's {cs}"),
                         T("以你的定義為準", "yours are used"))
            if letters:
                cs = " ".join("\\" + n for n in letters)
                optional(False, T(f"{name} 蓋掉了文字指令 {cs}", f"{name} overwrites the text commands {cs}"),
                         T("內文的 ç、š 這類重音會壞；letters=single 在數學裡給粗體、內文保留重音",
                           "accents such as ç, š break in text; letters=single makes them bold in math only"))
        if not clashes:
            optional(True, T("沒有和 akizumi-math 撞名的巨集", "No macros clash with akizumi-math"))
        # --- end akizumi-math ---
        doctor_build_checks(cfg, report, optional)  # prebuild programs, inkscape, packages

    print()
    if problems:
        fail(T(f"有 {len(problems)} 個問題：", f"{len(problems)} problem(s):"))
        for label, fix in problems:
            print(f"  {label}{T('：', ': ')}{fix}", file=sys.stderr)
        sys.exit(1)
    ok(T("一切正常", "All good"))


def cmd_config(a):
    # Chinese labels are double width: 設定資料夾 lines up with "config.json   "
    def heading(zh, zh_pad, en):
        return cmd_text(T(zh, en)) + (zh_pad if UI == "zh" else " " * (17 - len(en)))
    print(f"{heading('設定資料夾', '  ', 'Config folder')}{CONFIG_DIR}")
    print(f"  config.json    {T('有', 'yes') if USER_CONFIG.exists() else T('還沒建立', 'not created yet')}")
    used = [n for n in ["preamble.tex"] + [f"preamble-{k}.tex" for k in KINDS]
            if (CONFIG_DIR / n).exists()]
    print(f"  preamble       {T('、', ', ').join(used) if used else T('沒有', 'none')}")
    shared = shared_preamble()
    print(T(f"  共用 preamble  {shared or '沒有（往上找 .akizumi/preamble.tex）'}",
            f"  shared         {shared or 'none (looks upwards for .akizumi/preamble.tex)'}"))
    print(f"{heading('模板快取', '    ', 'Template cache')}{CACHE}")
    print(f"{heading('模板 repo', '   ', 'Template repo')}{REPO}")
    source = {"AX_LANG": T("環境變數 AX_LANG", "the AX_LANG environment variable"),
              'config.json "ui"': T(' config.json 的 "ui"', 'config.json "ui"'),
              "system": T("系統語言", "the system language")}.get(UI_SOURCE, UI_SOURCE)
    print(heading('介面語言', '    ', 'Interface')
          + T(f"中文（來自{source}）", f"English (from {source})"))
    note(T('  在 config.json 寫 "ui": "zh" 或 "en" 可以指定；AX_LANG 優先',
           '  Set "ui": "zh" or "en" in config.json to choose; AX_LANG wins over it'))
    if not USER_CONFIG.exists():
        note(T(f"\n建立 {USER_CONFIG}，例如：", f"\nCreate {USER_CONFIG}, for example:"))
        note(T('  {"author": "你的名字", "lang": "zh"}', '  {"author": "Your Name", "lang": "en"}'))


# ---------- ax docs: the reference manual in the terminal ----------
# Sections of docs/reference.md (or .en.md) by heading. The two files mirror
# each other heading for heading, so a match in one maps to the other by
# position: "ax docs theorem" finds the Chinese section too.

DOCS = REPO / "docs"
DOCS_WEB = "https://github.com/AkizumiFox/akizumi-latex/blob/main/docs/"
CHEATSHEET = REPO / "examples" / "cheatsheet.pdf"


def docs_file(lang):
    return DOCS / ("reference.en.md" if lang == "en" else "reference.md")


def _plain_heading(title):
    """A heading as GitHub shows it: no backticks, links as their text."""
    title = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", title)
    return title.replace("`", "").strip()


def heading_anchor(title, seen=None):
    """GitHub's #anchor for a heading (seen counts repeats: -1, -2, ...)."""
    slug = re.sub(r"[^\w\- ]", "", _plain_heading(title).lower()).replace(" ", "-")
    if seen is not None:
        n = seen.get(slug, 0)
        seen[slug] = n + 1
        if n:
            slug = f"{slug}-{n}"
    return slug


def doc_sections(path):
    """(lines, sections); a section is a dict with level, title, line (the
    heading's index), own (end of its own text: the next heading) and end
    (the next heading of the same or a higher level). Fenced code is skipped,
    so a '# comment' in a shell example is not a heading. Lines that are only
    an HTML comment (the snippet-test hints) are blanked: GitHub hides them."""
    lines = path.read_text(errors="replace").splitlines()
    heads, fence, seen = [], False, {}
    for i, line in enumerate(lines):
        if line.lstrip().startswith("```"):
            fence = not fence
        elif not fence and re.fullmatch(r"\s*<!--.*-->\s*", line):
            lines[i] = ""
        elif not fence:
            m = re.match(r"(#{1,6})\s+(.*\S)", line)
            if m:
                heads.append({"level": len(m.group(1)), "title": m.group(2), "line": i,
                              "anchor": heading_anchor(m.group(2), seen)})
    for k, h in enumerate(heads):
        h["own"] = heads[k + 1]["line"] if k + 1 < len(heads) else len(lines)
        h["end"] = next((g["line"] for g in heads[k + 1:] if g["level"] <= h["level"]), len(lines))
    return lines, heads


def doc_blocks(lines, start, end):
    """Paragraphs, list items, tables and code blocks of lines[start:end], as
    lists of line indexes."""
    blocks, cur, kind = [], [], None
    i = start
    while i < end:
        line = lines[i]
        if line.lstrip().startswith("```"):
            if cur:
                blocks.append(cur)
            cur = [i]
            i += 1
            while i < end and not lines[i].lstrip().startswith("```"):
                cur.append(i)
                i += 1
            if i < end:
                cur.append(i)
            blocks.append(cur)
            cur, kind = [], None
        elif not line.strip():
            if cur:
                blocks.append(cur)
            cur, kind = [], None
        else:
            new = ("table" if line.lstrip().startswith("|") else
                   "item" if re.match(r"([-*]|\d+\.)\s", line) else "text")
            if cur and (new == "item" or (new == "table") != (kind == "table")):
                blocks.append(cur)
                cur = []
            if not cur:
                kind = new
            cur.append(i)
        i += 1
    if cur:
        blocks.append(cur)
    return blocks


def _is_table(lines, block):
    return lines[block[0]].lstrip().startswith("|")


def _doc_hits(lines, sec, tokens):
    """The blocks of a section's own text containing every token, as
    {block number: line indexes to show}; a table shows its header and the
    matching rows only."""
    hits = {}
    for b, block in enumerate(doc_blocks(lines, sec["line"] + 1, sec["own"])):
        if _is_table(lines, block):
            rows = [i for i in block[2:] if all(t in lines[i].lower() for t in tokens)]
            if rows:
                hits[b] = block[:2] + rows
        elif all(t in " ".join(lines[i] for i in block).lower() for t in tokens):
            hits[b] = block
    return hits


WEAK_HIT = 20


def _doc_scores(lines, heads, query):
    """{section number: (score, hits)}: 80-100 when the heading has the
    words, 60-75 when it has some and its text the rest, 30-58 when only
    paragraphs or table rows have them."""
    q = query.lower().strip()
    tokens = [t.lstrip("\\") for t in q.split()] or [q]
    out = {}
    for k, h in enumerate(heads):
        if h["level"] < 2:
            continue
        title = _plain_heading(h["title"]).lower()
        if title in (q, q.lstrip("\\")):
            score = 100
        elif all(t in title for t in tokens):
            score = 80 + 15 * len(q) / max(len(title), 1)
        elif len(title) >= 2 and title in q:  # 參考文獻格式 → 參考文獻
            score = 60 + 10 * len(title) / len(q)
        else:
            score = 0
        hits = _doc_hits(lines, h, tokens)
        named = [t for t in tokens if t in title]
        if not score and named and not hits:
            # "theorem numbering": some words in the heading, the rest in its text
            text = "\n".join(lines[h["line"]:h["own"]]).lower()
            if all(t in text for t in tokens):
                score = 60 + 15 * len(named) / len(tokens)
        if not score and hits:
            # a table row that defines it (an option, a macro) counts most
            defines = any(all(t in lines[i].split("|")[1].lower() for t in tokens)
                          for rows in hits.values() for i in rows[2:]
                          if lines[i].lstrip().startswith("|") and lines[i].count("|") > 2)
            # and so does a section that starts with it
            score = 30 + min(len(hits), 8) + 12 * defines + 2 * max(4 - min(hits), 0)
            # only in a plain ``` block (a file tree, terminal output): a last resort
            blocks = doc_blocks(lines, h["line"] + 1, h["own"])
            if all(lines[blocks[b][0]].strip() == "```" for b in hits):
                score = WEAK_HIT
        if score:
            out[k] = (score, hits)
    return out


def _same_shape(heads, oheads):
    return [h["level"] for h in heads] == [h["level"] for h in oheads]


def _map_hits(lines, mine, olines, theirs, hits):
    """Hits found in the other language's paragraphs, moved to the same
    paragraphs (and table rows) of this language's text."""
    out = {}
    for b, shown in hits.items():
        if _is_table(olines, theirs[b]) and len(mine[b]) == len(theirs[b]):
            out[b] = [mine[b][j] for j, i in enumerate(theirs[b]) if i in shown]
        else:
            out[b] = mine[b]
    return out


def _code_words(text):
    """What a paragraph says in both languages: `code`, \\macros, options."""
    spans = re.findall(r"`([^`]+)`", text)
    return set(spans) | set(re.findall(r"\\?[A-Za-z][\w=@.-]{2,}", " ".join(spans) or text))


def _match_hits(lines, mine, olines, theirs, hits):
    """Hits in the other language's paragraphs, moved to this language's
    paragraphs (and table rows) that share the most code with them, for
    sections whose paragraphs do not line up one to one."""
    out = {}
    for b, shown in hits.items():
        rows = [i for i in shown if i not in theirs[b][:2]] if _is_table(olines, theirs[b]) else []
        cand = [(c, blk) for c, blk in enumerate(mine) if _is_table(lines, blk) == _is_table(olines, theirs[b])]
        if rows:  # table rows: the row of this table with the same first cell's code
            for c, blk in cand:
                picked = []
                for i in rows:
                    want = _code_words(olines[i].split("|")[1])
                    best = max(blk[2:], key=lambda j: len(want & _code_words(lines[j].split("|")[1])), default=None)
                    if best is not None and want & _code_words(lines[best].split("|")[1]):
                        picked.append(best)
                if picked:
                    out[c] = blk[:2] + sorted(set(picked))
                    break
            continue
        want = _code_words(" ".join(olines[i] for i in theirs[b]))
        score, c = max(((len(want & _code_words(" ".join(lines[i] for i in blk))), c) for c, blk in cand),
                       default=(0, None))
        if score:
            out[c] = mine[c]
    return out or {0: mine[0]} if mine else {}


def doc_search(query, lang):
    """(lines, sections, [(score, section number, hits, lines the hits index)])
    for the language's file, best first; matches in the other language's file
    count too, shown in this language when the paragraphs line up."""
    lines, heads = doc_sections(docs_file(lang))
    found = {k: (s, hits, lines) for k, (s, hits) in _doc_scores(lines, heads, query).items()}
    other = docs_file("zh" if lang == "en" else "en")
    if other.exists():
        olines, oheads = doc_sections(other)
        if _same_shape(heads, oheads):
            for k, (s, hits) in _doc_scores(olines, oheads, query).items():
                s *= 0.95
                if s <= found.get(k, (0,))[0]:
                    continue
                mine = doc_blocks(lines, heads[k]["line"] + 1, heads[k]["own"])
                theirs = doc_blocks(olines, oheads[k]["line"] + 1, oheads[k]["own"])
                if len(mine) == len(theirs):
                    found[k] = (s, _map_hits(lines, mine, olines, theirs, hits), lines)
                else:
                    # the paragraphs do not line up: never show the other
                    # language's text; find the same paragraphs by their code
                    found[k] = (s, _match_hits(lines, mine, olines, theirs, hits), lines)
    if any(s > WEAK_HIT for s, _, _ in found.values()):
        found = {k: v for k, v in found.items() if v[0] > WEAK_HIT}
    ranked = sorted(found.items(), key=lambda kv: (-kv[1][0], len(heads[kv[0]]["title"]), kv[0]))
    return lines, heads, [(s, k, hits, src) for k, (s, hits, src) in ranked]


# Terminal rendering of the manual: paragraphs and list items reflowed to the
# terminal (CJK characters take two columns), tables as aligned columns when
# they fit and as one entry per row when they do not, links as their text.
# Inline marks travel through the wrapping as control characters: \x01..\x02
# bold, \x03..\x04 code; _marks() turns them into colour or backticks.

_CLOSE_PUNCT = "，。、；：？！）」』〉》】,.;:?!)]}”’…%"
_OPEN_PUNCT = "（「『〈《【([{“‘"


def _wrap_tokens(text, width):
    toks = re.findall(r"\s+|\x03[^\x04]*\x04|[\x01\x02\x21-\x7e]+|.", text)
    out = []
    for t in toks:
        if t.startswith("\x03") and _width(t) > width // 2 and " " in t:
            parts = t.split(" ")  # a long code span may break at its spaces
            for j, part in enumerate(parts):
                out += ([" "] if j else []) + [part]
            continue
        out.append(t)
    merged = []
    for t in out:  # no line starts with a closing mark or ends with an opening one
        if merged and not t.isspace() and not merged[-1].isspace() and (
                t[0] in _CLOSE_PUNCT or merged[-1][-1] in _OPEN_PUNCT or
                t.strip("\x01\x02\x03\x04") == "" or merged[-1].strip("\x01\x02\x03\x04") == ""):
            merged[-1] += t
        else:
            merged.append(t)
    return merged


def wrap_cols(text, width, indent="", first=None):
    """Lines of text no wider than width terminal columns, breaking at spaces
    and between CJK characters; first is the first line's indent."""
    first = indent if first is None else first
    lines, cur, space, empty = [], first, False, True
    for t in _wrap_tokens(text, width - _width(indent)):
        if t.isspace():
            space = True
            continue
        sep = " " if space and not empty else ""
        if not empty and _width(cur) + len(sep) + _width(t) > width:
            lines.append(cur)
            cur, sep = indent, ""
        cur += sep + t
        space, empty = False, False
    lines.append(cur)
    return lines


def _inline(text):
    """Markdown inline marks to the control characters _marks() reads."""
    text = re.sub(r"\[([^\]]*)\]\(#[^)]*\)", r"\1", text)  # links inside the manual: their text
    text = re.sub(r"\[([^\]]*)\]\(([^)]*)\)", r"\1 (\2)", text)
    text = re.sub(r"`([^`]+)`", lambda m: "\x03" + m.group(1).replace("\\|", "|") + "\x04", text)
    text = re.sub(r"\*\*([^*]+)\*\*", "\x01\\1\x02", text)
    return text.replace("\\|", "|")


def _marks(lines):
    """Paint wrapped lines: bold and code in colour (closed at each line's
    end and reopened on the next), or backticks without colour."""
    if not COLOR["out"]:
        return [l.replace("\x01", "").replace("\x02", "").replace("\x03", "`").replace("\x04", "`")
                for l in lines]
    out, bold, code = [], False, False
    for line in lines:
        text = ("\033[1m" if bold else "") + ("\033[36m" if code else "")
        for ch in line:
            if ch == "\x01":
                bold, ch = True, "\033[1m"
            elif ch == "\x02":
                bold, ch = False, "\033[22m"
            elif ch == "\x03":
                code, ch = True, "\033[36m"
            elif ch == "\x04":
                code, ch = False, "\033[39m"
            text += ch
        out.append(text + ("\033[0m" if bold or code else ""))
    return out


def _doc_width():
    return max(40, min(shutil.get_terminal_size((80, 40)).columns, 100) - 1)


def _table_cells(line):
    cells = re.split(r"(?<!\\)\|", line.strip())
    if cells and not cells[0].strip():
        cells = cells[1:]
    if cells and not cells[-1].strip():
        cells = cells[:-1]
    return [_inline(c.strip()) for c in cells]


def _render_table(rows, width):
    rows = [r for r in rows if not re.fullmatch(r"\s*\|?[\s:|-]*-[\s:|-]*", r)]
    cells = [_table_cells(r) for r in rows]
    if not cells:
        return []
    head, body = cells[0], cells[1:]
    n = max(len(c) for c in cells)
    cols = [max((_width(c[j]) for c in cells if j < len(c)), default=0) for j in range(n)]
    if sum(cols) + 2 * (n - 1) <= width:
        out = []
        for k, c in enumerate(cells):
            line = "  ".join(c[j] + " " * (cols[j] - _width(c[j])) if j < len(c) else " " * cols[j]
                             for j in range(n)).rstrip()
            out.append("\x01" + line + "\x02" if k == 0 else line)
            if k == 0:
                out.append("─" * min(width, sum(cols) + 2 * (n - 1)))
        return out
    out = []
    for c in body:  # too wide: each row as an entry, its other cells below it
        out += wrap_cols(c[0] if c else "", width, "    ", f"{MARK['dot']} ")
        for j in range(1, len(c)):
            if not c[j]:
                continue
            label = f"{head[j]}{T('：', ': ')}" if n > 2 and j < len(head) and head[j] else ""
            out += wrap_cols(label + c[j], width, "      ", "    ")
    return out


def _doc_render(text_lines):
    """Manual lines as the terminal shows them: headings coloured, text
    reflowed, tables laid out, fenced code as it is."""
    width, out = _doc_width(), []
    text_lines = list(text_lines)
    i = 0
    while i < len(text_lines):
        line = text_lines[i]
        if line.lstrip().startswith("```"):
            j = i + 1
            while j < len(text_lines) and not text_lines[j].lstrip().startswith("```"):
                j += 1
            out += ["  " + (_paint(l, "2") if COLOR["out"] else l) for l in text_lines[i + 1:j]]
            i = j + 1
            continue
        if not line.strip():
            if out and out[-1] != "":
                out.append("")
            i += 1
            continue
        m = re.match(r"(#{1,6})\s+(.*)", line)
        if m:
            out.append(_paint(m.group(1) + " " + _plain_heading(m.group(2)), "1;36"))
            i += 1
            continue
        if line.lstrip().startswith("|"):
            j = i
            while j < len(text_lines) and text_lines[j].lstrip().startswith("|"):
                j += 1
            out += _marks(_render_table(text_lines[i:j], width))
            i = j
            continue
        item = re.match(r"(\s*)([-*]|\d+\.)\s+", line)
        j = i + 1  # a paragraph or list item runs on until a blank line, a new item or a block
        while j < len(text_lines) and text_lines[j].strip() and not re.match(
                r"\s*([-*]|\d+\.)\s|\s*\||\s*```|#{1,6}\s", text_lines[j]):
            j += 1
        text = " ".join(l.strip() for l in text_lines[i:j])
        if item:
            lead = item.group(1)
            bullet = MARK["dot"] if item.group(2) in "-*" else item.group(2)
            text = text[len(item.group(0)) - len(lead):]
            out += _marks(wrap_cols(_inline(text), width, lead + " " * (_width(bullet) + 1), lead + bullet + " "))
        else:
            out += _marks(wrap_cols(_inline(text), width))
        i = j
    return out


def _doc_line(line):
    """A heading line, coloured, without its Markdown marks."""
    m = re.match(r"(#{1,6})\s+(.*)", line)
    return _paint(m.group(1) + " " + _plain_heading(m.group(2)), "1;36")


def _doc_page(text_lines):
    """Print, through less on a terminal when it does not fit; without less,
    cut it to the screen with a hint."""
    rows = shutil.get_terminal_size((80, 40)).lines
    if not sys.stdout.isatty() or len(text_lines) <= rows - 2:
        print("\n".join(text_lines))
        return
    pager = None if WINDOWS else shutil.which("less")
    if pager:
        try:
            subprocess.run([pager, "-R", "-F", "-X"], input="\n".join(text_lines) + "\n",
                           encoding="utf-8", errors="replace")
            return
        except OSError:
            pass
    keep = max(rows - 4, 10)
    print("\n".join(text_lines[:keep]))
    note(T(f"…（還有 {len(text_lines) - keep} 行；加 --web 在瀏覽器看全文）",
           f"... ({len(text_lines) - keep} more lines; add --web to read it all in the browser)"))


# Natural phrases a reader types, to the words the manual uses (whole query).
DOC_ALIASES = [
    (r"(按|依|照|每)?(一)?(節|章|小節)(來|重新)?(編號|計數)|(編號|計數)(按|依|照|跟著)(節|章)"
     r"|number(ing)? (by|per|within) (section|chapter)", "thmwithin"),
    (r"(定理|環境)?(的)?(編號|計數)(方式|規則)?|theorem number(ing|s)?", "編號方式"),
    (r".*(解答|答案).*(最後|書末|章末|文末|後面|集中|一起|另外).*|.*(書末|章末|最後).*(解答|答案).*"
     r"|solutions? (at|in) the (end|back)|collect(ed)? solutions?", "solutions"),
    (r".*(舊|以前的?|原本的?)(文件|檔案?|文檔|講義|作業|模板).*|.*(轉換|轉檔|搬過來|遷移).*"
     r"|(convert|port|move) (an )?old.*", "ax migrate"),
    (r"(程式碼|代碼|語法)?(上色|高亮|著色)|syntax highlight(ing)?|highlight(ing)? code", "minted"),
    (r"(速查表|小抄|cheat ?sheet)", "cheatsheet"),
    (r"(介面|界面)(語言)?|(英文|中文)(介面|界面|訊息)|interface language", "AX_LANG"),
]
# Little words dropped when a Chinese phrase finds nothing as a whole.
DOC_STOPWORDS = r"怎麼|怎樣|如何|可以|能不能|要|想|的|把|將|放|在|用|讓|給|嗎|呢|和|與|跟|或|到"


def doc_alias(query):
    q = query.strip().lower()
    for pattern, target in DOC_ALIASES:
        if re.fullmatch(pattern, q) and q != target.lower():
            return target
    return None


def doc_words(query):
    """A Chinese phrase cut into words at the little words: 解答放最後 →
    解答 最後; None when that changes nothing."""
    words = [w for w in re.split(rf"\s+|{DOC_STOPWORDS}", query) if w]
    split = " ".join(words)
    return split if words and split != query.strip() else None


def doc_suggestions(query, lang):
    """(headings that look like the query, True), or with none alike the
    manual's chapters and False."""
    q = query.lower().lstrip("\\")
    _, heads = doc_sections(docs_file(lang))
    other = docs_file("zh" if lang == "en" else "en")
    oheads = doc_sections(other)[1] if other.exists() else []
    if not _same_shape(heads, oheads):
        oheads = []

    def ratio(title):
        title = _plain_heading(title).lower()
        words = [w for w in re.split(r"[\s、，,（）()：:/]+", title)
                 if len(w) >= 3 or len(w) == 2 and not w.isascii()] + [title]
        return max(difflib.SequenceMatcher(None, q, w).ratio() for w in words)

    scored = [(max(ratio(h["title"]), ratio(oheads[k]["title"]) if oheads else 0), k)
              for k, h in enumerate(heads) if h["level"] >= 2]
    scored.sort(key=lambda x: -x[0])
    near = [heads[k] for r, k in scored[:6] if r >= 0.4]
    # nothing alike: the manual's chapters, to browse from
    return (near, True) if near else ([h for h in heads if h["level"] == 2], False)


def doc_vocabulary():
    """Words and macro names in either file, to correct a typo."""
    words = set()
    for lang in ("zh", "en"):
        if docs_file(lang).exists():
            text = docs_file(lang).read_text(errors="replace")
            words |= {w.lower() for w in re.findall(r"\\?[A-Za-z][A-Za-z@-]{2,}", text)}
    return words


def docs_cheatsheet():
    """examples/cheatsheet.pdf, or built from cheatsheet.tex into the cache."""
    for pdf in (CHEATSHEET, REPO / "examples" / "build" / "cheatsheet.pdf"):
        if pdf.exists():
            open_file(pdf)
            ok(T(f"已打開 {pdf}", f"Opened {pdf}"))
            return
    tex = CHEATSHEET.with_suffix(".tex")
    if not tex.exists():
        die(T("這個版本的模板還沒有速查表（examples/cheatsheet.tex）",
              "This template version has no cheat sheet yet (examples/cheatsheet.tex)"),
            T(f"先看參考手冊：{cmd_text('ax docs')}", f"Read the reference instead: {cmd_text('ax docs')}"))
    out_dir = CACHE / "docs"
    pdf = out_dir / "cheatsheet.pdf"
    if not pdf.exists() or pdf.stat().st_mtime < tex.stat().st_mtime:
        need_tool("latexmk", T("ax doctor 看怎麼裝 TeX", "ax doctor shows how to install TeX"))
        out_dir.mkdir(parents=True, exist_ok=True)
        # examples/latexmkrc: XeLaTeX with the templates at the repo root;
        # -outdir after it puts the output in the cache instead of the repo
        code, _, secs = run_with_spinner(
            ["latexmk", "-r", "latexmkrc", f"-outdir={out_dir}", "-halt-on-error",
             "-interaction=nonstopmode", tex.name], T("編譯速查表", "Building the cheat sheet"),
            cwd=tex.parent)
        if code or not pdf.exists():
            print_error(out_dir / "cheatsheet.log")
            die(T("速查表編譯失敗", "The cheat sheet did not build"),
                T(f"{cmd_text('ax doctor')} 檢查 TeX 和字型", f"{cmd_text('ax doctor')} checks TeX and fonts"))
        ok(T(f"速查表編好了（{elapsed(secs)}）", f"Built the cheat sheet ({elapsed(secs)})"))
    open_file(pdf)
    ok(T(f"已打開 {pdf}", f"Opened {pdf}"))


def cmd_docs(a):
    if a.cheatsheet:
        return docs_cheatsheet()
    lang = "en" if a.en or UI == "en" else "zh"
    path = docs_file(lang)
    url = DOCS_WEB + path.name
    if not path.exists():
        die(T(f"找不到 {path}", f"{path} not found"), T(f"線上版：{url}", f"Online: {url}"))
    query = " ".join(a.topic).strip()
    if not query:
        if a.web:
            webbrowser.open(url)
            ok(T(f"已在瀏覽器打開 {url}", f"Opened {url} in the browser"))
        else:
            open_file(path)
            ok(T(f"已打開 {path}", f"Opened {path}"))
        note(T(f"  查一段：{cmd_text('ax docs 主題')}（例如 ax docs 定理）",
               f"  Look up one section: {cmd_text('ax docs TOPIC')} (e.g. ax docs theorem)"))
        behind = docs_pin_behind()
        if behind:
            behind_note(behind)
        return
    alias = doc_alias(query)
    if alias:
        found = doc_search(alias, lang)
        if found[2]:
            note(T(f"「{query}」：顯示「{alias}」", f'"{query}": showing "{alias}"'))
            query = alias
    lines, heads, ranked = doc_search(query, lang)
    if not ranked:
        # a Chinese phrase: its words apart, then its longest word alone
        words = doc_words(query)
        for guess in ([words, max(words.split(), key=_width)] if words else []):
            found = doc_search(guess, lang)
            if found[2]:
                note(T(f"找不到「{query}」，改找「{guess}」", f'No "{query}"; showing "{guess}"'))
                query = guess
                lines, heads, ranked = found
                break
    if not ranked:
        # a typo: correct each word to one the manual uses, then the whole
        vocab = doc_vocabulary()

        def close(word):
            if word in vocab or not word.isascii():
                return word
            m = (difflib.get_close_matches(word, vocab, n=1, cutoff=0.8)
                 or difflib.get_close_matches("\\" + word.lstrip("\\"), vocab, n=1, cutoff=0.8))
            return m[0] if m else word

        q = query.lower()
        for guess in (" ".join(close(w) for w in q.split()), close(q)):
            if guess != q:
                found = doc_search(guess, lang)
                if found[2]:
                    note(T(f"找不到「{query}」，改找「{guess}」", f'No "{query}"; showing "{guess}"'))
                    query = guess
                    lines, heads, ranked = found
                    break
    if not ranked:
        fail(T(f"參考手冊裡找不到「{query}」", f'Nothing about "{query}" in the reference'))
        near, alike = doc_suggestions(query, lang)
        if near:
            print(T("你是不是要找：", "Did you mean:") if alike else T("手冊的章節：", "The manual's chapters:"))
            for h in near:
                print(f"  {MARK['dot']} {_paint(_plain_heading(h['title']), '1;36')}")
            first = _plain_heading(near[0]["title"])
            example = cmd_text(f"ax docs {first}" if " " not in first else f'ax docs "{first}"')
            note(T(f"  例如 {example}；{cmd_text('ax docs')} 打開整份手冊",
                   f"  e.g. {example}; {cmd_text('ax docs')} opens the whole manual"))
        else:
            note(T(f"  {cmd_text('ax docs')} 打開整份手冊", f"  {cmd_text('ax docs')} opens the whole manual"))
        sys.exit(1)
    best_score, best, _, _ = ranked[0]
    h = heads[best]
    if a.web:
        webbrowser.open(f"{url}#{h['anchor']}")
        ok(T(f"已在瀏覽器打開「{_plain_heading(h['title'])}」",
             f"Opened \"{_plain_heading(h['title'])}\" in the browser"))
        note(f"  {url}#{h['anchor']}")
        return
    out, shown = [], []
    if best_score >= 60:  # a heading: the whole section, subsections included
        out += _doc_render(lines[h["line"]:h["end"]])
        shown = [best]
    else:  # the paragraphs and table rows that mention it
        for score, k, hits, src in ranked[:3]:
            out.append(_doc_line("#" * heads[k]["level"] + " " + heads[k]["title"]))
            out.append("")
            for b in sorted(hits)[:6]:
                out += _doc_render(src[i] for i in hits[b]) + [""]
            if len(hits) > 6:
                out += [_paint(T(f"…（這一節還有 {len(hits) - 6} 處）",
                                 f"... ({len(hits) - 6} more in this section)"), "2"), ""]
            shown.append(k)
    while out and not out[-1].strip():
        out.pop()
    shown_query = query if " " not in query else f'"{query}"'
    out += ["", _paint(f"{path.relative_to(REPO).as_posix()}:{h['line'] + 1}  {MARK['dot']}  " +
                       T(f"ax docs {shown_query} --web 在瀏覽器看", f"ax docs {shown_query} --web opens it in the browser"),
                       "2")]
    inside = lambda k: any(heads[s]["line"] <= heads[k]["line"] < heads[s]["end"] for s in shown)
    more = [k for _, k, _, _ in ranked if not inside(k)][:5]
    if more:
        out.append(_paint(T("也有提到：", "Also mentioned in:"), "2"))
        out += [_paint(f"  {MARK['dot']} {_plain_heading(heads[k]['title'])}", "2") for k in more]
    behind = docs_pin_behind()
    if behind:
        out += [""] + [_paint(l, "33") for l in wrap_cols(
            T(f"這份手冊比你用的模板 {behind} 新：CHANGELOG.md 裡標著 Unreleased 的功能要在 .ax.json 寫 "
              f"\"template\": \"latest\" 才有（新專案：ax new --pin latest）",
              f"This manual is newer than your template {behind}: features listed as Unreleased in "
              f"CHANGELOG.md need \"template\": \"latest\" in .ax.json (new projects: ax new --pin latest)"),
            _doc_width())]
    _doc_page(out)


def docs_pin_behind():
    """The template version the user gets (the project's pin, or what ax new
    would pin) when the manual describes newer features; else None."""
    cfg = find_project(quiet=True)
    tags = template_tags()
    pin = cfg.get("template") if cfg else (tags[0] if tags else None)
    return pin_behind_manual(pin)


# ---------- shell completion ----------

PARSER = None  # set by main(); completion reads each command's options from it


def command_words():
    """{command: (options, choices of its positional, takes a file)} from the
    parser, so completion keeps up with new options."""
    sub = next(x for x in PARSER._actions if isinstance(x, argparse._SubParsersAction))
    out = {}
    for name in PUBLIC_COMMANDS:
        cp = sub.choices[name]
        opts = [o for x in cp._actions for o in x.option_strings if o.startswith("--") and o != "--help"]
        choices = [str(c) for x in cp._actions if not x.option_strings and x.choices for c in x.choices]
        takes_file = any(x.dest == "file" for x in cp._actions)
        out[name] = (opts, choices, takes_file)
    return out


def cmd_completion(a):
    cmds = " ".join(PUBLIC_COMMANDS)
    kinds = " ".join(KINDS)
    words = command_words()
    if a.shell == "zsh":
        described = " ".join(f"'{c}:{HELP_LINES.get(c, '')}'" for c in PUBLIC_COMMANDS)
        cases = []
        for c, (opts, choices, takes_file) in words.items():
            if c == "new":
                continue
            body = " ".join(opts + choices)
            line = f"compadd -- {body}" if body else ""
            if takes_file:
                line += ("; " if line else "") + "_files -g '*.tex'"
            if line:
                cases.append(f"    {c}) {line} ;;")
        print("""#compdef ax
_ax() {
  local -a cmds; cmds=(%s)
  if (( CURRENT == 2 )); then _describe 'command' cmds
  elif [[ $words[2] == new && CURRENT == 3 ]]; then compadd -- %s
  elif [[ $words[2] == new ]]; then compadd -- %s
  else
    case $words[2] in
%s
    esac
  fi
}
compdef _ax ax""" % (described, kinds, " ".join(words["new"][0]), "\n".join(cases)))
    elif a.shell == "bash":
        cases = []
        for c, (opts, choices, _) in words.items():
            if c == "new":
                continue
            if opts:
                cases.append(f'    {c}) [[ "$cur" == -* ]] && COMPREPLY=($(compgen -W "{" ".join(opts)}" -- "$cur"))'
                             + (f' || COMPREPLY=($(compgen -W "{" ".join(choices)}" -- "$cur"))' if choices else "")
                             + " ;;")
            elif choices:
                cases.append(f'    {c}) COMPREPLY=($(compgen -W "{" ".join(choices)}" -- "$cur")) ;;')
        print("""_ax() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  if [ "$COMP_CWORD" -eq 1 ]; then COMPREPLY=($(compgen -W "%s" -- "$cur"))
  elif [ "${COMP_WORDS[1]}" = new ] && [ "$COMP_CWORD" -eq 2 ]; then COMPREPLY=($(compgen -W "%s" -- "$cur"))
  elif [ "${COMP_WORDS[1]}" = new ]; then COMPREPLY=($(compgen -W "%s" -- "$cur"))
  else
    case "${COMP_WORDS[1]}" in
%s
    esac
  fi
}
complete -o default -F _ax ax""" % (cmds, kinds, " ".join(words["new"][0]), "\n".join(cases)))
    else:
        ps = lambda ws: ", ".join(f"'{w}'" for w in ws)
        cases = []
        for c, (opts, choices, _) in words.items():
            if c == "new" or not (opts or choices):
                continue
            cases.append(f"  elseif ($words[1] -eq '{c}') {{ $list = @({ps(opts + choices)}) }}")
        print("""Register-ArgumentCompleter -Native -CommandName ax -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $words = @($commandAst.CommandElements | ForEach-Object { $_.ToString() })
  $n = $words.Count; if ($wordToComplete -eq '') { $n++ }
  if ($n -le 2) { $list = @(%s) }
  elseif ($words[1] -eq 'new' -and $n -eq 3) { $list = @(%s) }
  elseif ($words[1] -eq 'new') { $list = @(%s) }
%s
  else { return }
  # files stay the default for the rest
  if ($wordToComplete -notlike '-*' -and $words[1] -ne 'new' -and $words[1] -ne 'completion' -and $words[1] -ne 'selftest') { return }
  $list | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
    [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
  }
}""" % (ps(PUBLIC_COMMANDS), ps(KINDS), ps(words["new"][0]), "\n".join(cases)))


# ---------- ax migrate, shared course preamble (akizumi-compat) ----------
# akizumi-compat.sty reads the nearest .akizumi/preamble.tex from the
# document's folder up to eight folders above it; ax only shows which one
# applies (bare ax, ax config, ax new) and packs it. ax migrate rewrites a
# copy of an older document (memoir + math-notes, article, CJKutf8) for an
# akizumi class and reports macros that clash with akizumi's.

SHARED_PREAMBLE = Path(".akizumi") / "preamble.tex"
SHARED_PREAMBLE_LEVELS = 9  # the folder itself and eight above: as akizumi-compat.sty


def shared_preamble(start=None):
    """The .akizumi/preamble.tex a document in `start` (default: here) gets."""
    here = Path(start or Path.cwd()).resolve()
    for folder in (here, *here.parents)[:SHARED_PREAMBLE_LEVELS]:
        if (folder / SHARED_PREAMBLE).is_file():
            return folder / SHARED_PREAMBLE
    return None


def _braced(text, i):
    """(content, end) of the {...} group starting at text[i], or (None, i)."""
    while i < len(text) and text[i] in " \t":
        i += 1
    if i >= len(text) or text[i] != "{":
        return None, i
    depth, j = 0, i
    while j < len(text):
        c = text[j]
        if c == "\\":
            j += 2
            continue
        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return text[i + 1:j], j + 1
        j += 1
    return None, i


def _strip_comment(line):
    m = re.search(r"(?<!\\)%", line)
    return line[:m.start()] if m else line


CS_DEF = re.compile(
    r"\\(?P<how>newcommand|renewcommand|providecommand|DeclareRobustCommand|NewDocumentCommand|"
    r"RenewDocumentCommand|ProvideDocumentCommand|DeclareDocumentCommand|DeclareMathOperator|"
    r"DeclarePairedDelimiter|DeclarePairedDelimiterX|def|gdef|edef|xdef|let)\*?\s*\{?\s*"
    # \expandafter\def\csname ...: the name is built, not written out
    r"\\(?P<name>(?!(?:csname|expandafter|noexpand|global)(?![A-Za-z@]))[A-Za-z@]+)")
ENV_DEF = re.compile(
    r"\\(?P<how>newenvironment|renewenvironment|NewDocumentEnvironment|RenewDocumentEnvironment|"
    r"DeclareTCBListing|newtheorem|newlist|akizumi@thm|akizumi@barenv)\*?\s*\{(?P<name>[A-Za-z*]+)\}")


def defined_names(text):
    """{name: how} for commands (\\name) and environments (name) a file defines."""
    found = {}
    for line in text.splitlines():
        line = _strip_comment(line)
        for m in CS_DEF.finditer(line):
            if "@" not in m["name"]:
                found.setdefault("\\" + m["name"], m["how"])
        for m in ENV_DEF.finditer(line):
            if m["how"] in ("akizumi@thm", "akizumi@barenv"):
                found.setdefault(m["name"], "newtheorem")
                found.setdefault(m["name"] + "*", "newtheorem")
            else:
                found.setdefault(m["name"], m["how"])
    return found


def akizumi_names(kind):
    """Commands, environments and packages the templates define or load for
    `kind`, read from the template files themselves."""
    src = REPO
    first = "beamerthemeAkizumi.sty" if kind == "slides" else f"{KINDS.get(kind, 'akizumi-note')}.cls"
    names, packages, todo, seen = {}, set(), [first], set()
    while todo:
        name = todo.pop()
        f = src / name
        if name in seen or not f.exists():
            continue
        seen.add(name)
        text = f.read_text()
        if name != "akizumi-compat.sty":  # its CJK and li give way to the document's own
            names.update({k: v for k, v in defined_names(text).items() if k not in names})
        body = "\n".join(_strip_comment(l) for l in text.splitlines())
        for m in re.finditer(r"\\(?:RequirePackage|usepackage|usetheme)(?:\[[^\]]*\])?\{([^}]*)\}", body):
            line = body[body.rfind("\n", 0, m.start()) + 1:m.start()]
            optional_load = re.search(r"\\if(?!x\b)[A-Za-z@]", line)  # e.g. \ifakizumi@units: an option
            for p in (p.strip() for p in m.group(1).split(",")):
                if optional_load and not (p.startswith("akizumi") or p == "Akizumi"):
                    continue
                if p.startswith("akizumi") or p == "Akizumi":
                    todo.append("beamerthemeAkizumi.sty" if p == "Akizumi" else p + ".sty")
                elif p:
                    packages.add(p)
        if name.endswith(".cls"):
            todo.append("akizumi-core.sty")
    return names, packages


# Names the LaTeX kernel and the standard classes define, which a preamble
# may \renewcommand without any package.
LATEX_KERNEL_NAMES = set("""thetable thefigure theequation thesection thesubsection thesubsubsection
thechapter thepart thepage thefootnote theenumi theenumii labelitemi labelitemii labelenumi labelenumii
figurename tablename contentsname refname bibname abstractname appendixname indexname partname
chaptername listfigurename listtablename today baselinestretch arraystretch footnoterule
familydefault rmdefault sfdefault ttdefault maketitle title author date and thanks
cleardoublepage clearpage section subsection paragraph emph textbf""".split())

_LATEX_SOURCES = {}


def defined_by_latex(name, packages):
    """Whether the LaTeX format or one of `packages` (those akizumi loads)
    defines \\name, read from their files (best effort)."""
    if not _LATEX_SOURCES:
        files = ["latex.ltx", "fontmath.ltx", "fonttext.ltx"] + [f"{p}.sty" for p in sorted(packages)]
        r = subprocess.run(["kpsewhich", *files], capture_output=True, text=True)
        text = []
        for f in r.stdout.split():
            try:
                text.append(Path(f).read_text(errors="replace"))
            except OSError:
                pass
        _LATEX_SOURCES["text"] = "\n".join(text)
    return re.search(r"\\(?:def|gdef|edef|let|newcommand\*?|renewcommand\*?|providecommand\*?|DeclareRobustCommand\*?|"
                     r"DeclareMathSymbol|DeclareMathOperator\*?|DeclareTextSymbol|DeclareTextCommand)\s*\{?\s*\\"
                     + re.escape(name) + r"(?![A-Za-z@])", _LATEX_SOURCES["text"]) is not None


# One-letter commands LaTeX already has (accents and special letters):
# \def\c{...} silently breaks \c{c}, \v{s}, \L, \S, ...
LATEX_LETTERS = set("a b c d H i j k l L o O P r S t u v".split())
CJK_WRAP = re.compile(r"\\(?:begin\{CJK\*?\}(?:\[[^\]]*\])?\{[^}]*\}\{[^}]*\}|end\{CJK\*?\})")
COURSE_MACROS = {"coursename": "course", "authorname": "author", "authorID": "id", "authorid": "id",
                 "studentid": "id", "studentID": "id", "documentname": "title"}
LAYOUT_MACROS = {"coursecode", "courseterm", "coverpagesize", "headingleft", "headingright",
                 "headingpagenumber", "chaptertitleformat", "chaptertitlefont", "chaptertocname"}
DROP_PACKAGES = {"CJK", "CJKutf8", "CJKspace", "CJKpunct", "algpseudocode", "math-notes"}
ZH_DIGITS = {c: i for i, c in enumerate("零一二三四五六七八九")}
PROBLEM_HEAD = re.compile(
    r"^(?P<indent>\s*)\\(?P<level>sub)?section\*?\s*\{\s*(?:(?:Problem|Question|Exercise|Q|問題|題目)\s*"
    r"(?P<n>\d+[a-z]?(?:\.[0-9A-Za-z]+)*(?![0-9A-Za-z]))|第\s*(?P<zh>\d+|[一二三四五六七八九十]+)\s*題)"
    r"\s*[.:：、)）-]?\s*(?P<title>.*?)\s*\}\s*$")
# Headings that end a problem, by level; the others always do.
HEADING = re.compile(r"^\s*\\(?:(?P<level>part|chapter|section|subsection)\b|appendix\b|printbibliography\b"
                     r"|bibliography\b|end\{document\})")
HEADING_RANK = {"part": 0, "chapter": 1, "section": 2, "subsection": 3}


def _zh_number(s):
    if s.isdigit():
        return int(s)
    if s == "十":
        return 10
    if "十" in s:
        a, _, b = s.partition("十")
        return (ZH_DIGITS.get(a, 1) if a else 1) * 10 + (ZH_DIGITS.get(b, 0) if b else 0)
    return ZH_DIGITS.get(s)


def _guess_lang(body):
    text = re.sub(r"\\[A-Za-z@]+|%.*", " ", body)
    han = len(re.findall(r"[\u4e00-\u9fff]", text))
    kana = len(re.findall(r"[\u3040-\u30ff]", text))
    hangul = len(re.findall(r"[\uac00-\ud7af]", text))
    latin = len(re.findall(r"[A-Za-z]", text))
    if hangul * 2 > latin and hangul > 20:
        return "ko"
    if kana * 2 > latin and kana > 20:
        return "ja"
    if han * 2 > latin and han > 20:
        return "zh"
    return "en"


PROBLEM_HEAD_START = re.compile(r"\s*\\(?:sub)?section\*?\s*\{[^{}]*\}")


def _own_lines(lines):
    """\\begin{document}, \\end{document} and Problem headings on lines of
    their own, so a body written on one line is migrated like any other."""
    out = []
    for line in lines:
        code = _strip_comment(line)
        parts = [p for p in re.split(r"(\\begin\{document\}|\\end\{document\})", code) if p.strip()]
        if len(parts) < 2:
            parts = [line]
        else:
            parts[-1] += line[len(code):]  # the comment stays at the end
        for part in parts:
            m = PROBLEM_HEAD_START.match(part)
            if m and _strip_comment(part[m.end():]).strip() and PROBLEM_HEAD.match(m.group(0)):
                out += [m.group(0), part[m.end():]]
            else:
                out.append(part)
    return out


STATEMENT_START = re.compile(
    r"\\(?:usepackage|RequirePackage|def|gdef|edef|xdef|newcommand|renewcommand|providecommand|"
    r"setlength|setcounter|title|author|date|DeclareMathOperator|newtheorem|usetikzlibrary)(?![A-Za-z@])")


def _split_statements(line):
    """A preamble line holding several statements (\\usepackage{a}\\setlength{...}),
    as one line per statement, so each is migrated (or kept) on its own."""
    code = _strip_comment(line)
    cuts, depth, i = [], 0, 0
    while i < len(code):
        c = code[i]
        if c == "\\":
            m = STATEMENT_START.match(code, i)
            if m and depth == 0 and code[:i].strip() and not re.search(
                    r"\\(?:expandafter|global|long|protected|outer|let\\[A-Za-z@]+)\s*$", code[:i]):
                cuts.append(i)
            i += 2
            continue
        depth += c == "{"
        depth -= c == "}"
        i += 1
    if not cuts:
        return [line]
    parts = [code[a:b].rstrip() for a, b in zip([0] + cuts, cuts + [len(code)])]
    parts[-1] += line[len(code):]  # the comment stays at the end
    return parts


def migrate_text(text, kind=None):
    """Rewrite one document. Returns (new text, kind, changes, notes): what
    was changed, and what needs a look."""
    changes, notes = [], []
    lines = _own_lines(text.split("\n"))
    begin = next((i for i, l in enumerate(lines) if re.match(r"\s*\\begin\{document\}", l)), None)
    if begin is None:
        die(T("找不到 \\begin{document}：ax migrate 只處理主檔", "No \\begin{document}: ax migrate works on main files"),
            T("被 \\input 的檔案不用轉，主檔轉好後照樣讀得到", "Files read with \\input need no migration"))
    pre, body = [p for l in lines[:begin] for p in _split_statements(l)], lines[begin:]
    # v0.6 renamed aaron to akizumi (\usetheme{Aaron}, \aaronsetup, ...)
    renamed = False
    for part in (pre, body):
        for i, l in enumerate(part):
            new = l
            for pattern, repl in AARON_SWAPS:
                new = pattern.sub(repl, new)
            if new != l:
                part[i], renamed = new, True
    if renamed:
        changes.append(T("舊名稱 aaron 改成 akizumi", "renamed aaron to akizumi"))

    # CJK wrappers, everywhere
    n = 0
    for part in (pre, body):
        for i, l in enumerate(part):
            new = CJK_WRAP.sub("", l)
            if new != l:
                n += 1
                part[i] = None if not new.strip() else new.rstrip()
    pre, body = [l for l in pre if l is not None], [l for l in body if l is not None]
    if n:
        changes.append(T(f"拿掉 {n} 處 CJK / CJK* 環境（xeCJK 不需要）",
                         f"removed {n} CJK / CJK* environment(s) (xeCJK needs none)"))

    # class and kind
    body_text = "\n".join(body)
    problems = [i for i, l in enumerate(body) if PROBLEM_HEAD.match(_strip_comment(l))]
    old_cls, old_opts, cls_line = None, [], None
    for i, l in enumerate(pre):
        m = re.match(r"\s*\\documentclass\s*(?:\[([^\]]*)\])?\s*\{([^}]*)\}", l)
        if m:
            cls_line, old_cls = i, m.group(2).strip()
            old_opts = [o.strip() for o in (m.group(1) or "").split(",") if o.strip()]
            break
    if cls_line is None:
        die(T("找不到 \\documentclass", "No \\documentclass found"))
    if old_cls == "beamer" and kind not in (None, "slides"):
        die(T(f"這是 beamer 簡報，只能轉成 slides，不能轉成 {kind}", f"This is a beamer deck: it converts to slides, not {kind}"),
            T("拿掉 --kind，或寫 --kind slides", "Leave out --kind, or give --kind slides"))
    if kind == "slides" and old_cls != "beamer":
        die(T(f"--kind slides 只用在 beamer 簡報；這份是 {old_cls}", f"--kind slides is for beamer decks; this is {old_cls}"))
    if old_cls == "beamer":
        # keep beamer and its options (aspectratio, ...); the theme becomes Akizumi
        kind = "slides"
        lang = _guess_lang(body_text)
        theme = f"\\usetheme{'[lang=' + lang + ']' if lang != 'en' else ''}{{Akizumi}}"
        themes = [i for i, l in enumerate(pre)
                  if re.match(r"\s*\\use(?:|color|font|inner|outer)theme\b", l)]
        if any(re.match(r"\s*\\usetheme\s*(?:\[[^\]]*\])?\s*\{Akizumi\}", pre[i]) for i in themes):
            themes, theme = [], None  # already on the Akizumi theme
        for i in themes:
            pre[i] = f"% ax migrate: {pre[i].strip()}"
        if theme is None:
            pass
        elif themes:
            pre[themes[0]] = theme + "\n" + pre[themes[0]]
        else:
            pre.insert(cls_line + 1, theme)
        if theme:
                changes.append(T(f"beamer 主題改成 {theme}" + ("（原本的主題已註解掉）" if themes else ""),
                             f"beamer theme is now {theme}" + (" (the old themes are commented out)" if themes else "")))
    elif old_cls.startswith("akizumi-"):
        kind = kind or next((k for k, c in KINDS.items() if c == old_cls), "note")
    else:
        # chapters: \chapter lines, and \include'd files (one chapter each)
        chapters = len(re.findall(r"^\s*\\chapter\b", body_text, re.M))
        includes = len(re.findall(r"^\s*\\include\s*\{", "\n".join(_strip_comment(l) for l in body), re.M))
        if old_cls in ("book", "memoir", "report", "scrbook", "scrreprt"):
            chapters += includes
        # homework: the word in the title or a heading, not anywhere in the text
        heads = "\n".join(re.findall(
            r"\\(?:title|subtitle|chapter|section|documentname|def\s*\\documentname|newcommand\s*\{?\\documentname\}?)"
            r"\*?\s*(?:\[[^\]]*\])?\s*\{([^}\n]*)\}", text))
        assignment = re.search(r"\b(?:Homework|Assignment|Problem Set)\b|作業\s*(?:[0-9０-９一二三四五六七八九十]|$)"
                               r"|第\s*\S{1,3}\s*次作業", heads, re.I | re.M) and chapters <= 1
        kind = kind or ("hw" if problems or assignment else "book" if chapters >= 2 else "note")
        opts = []
        lang = _guess_lang(body_text)
        if lang != "en":
            opts.append(f"lang={lang}")
        dropped = []
        for o in old_opts:
            if o in ("10pt", "11pt", "12pt", "13pt", "14pt"):
                opts.append(o)
            elif o == "letterpaper":
                opts.append("paper=letter")
            elif re.fullmatch(r"(?:9|1[5-9]|[2-9]\d)pt", o):  # memoir's extrafontsizes sizes
                opts.append(f"fontsize={o}")
            elif o not in ("a4paper", "extrafontsizes", "oneside", "openany"):
                dropped.append(o)
        # a note with only \section*: (1), Theorem 1, Listing 1, not 0.1
        starred = re.search(r"^\s*\\section\*", body_text, re.M)
        numbered = re.search(r"^\s*\\section\s*(?:\[[^\]]*\])?\s*\{", body_text, re.M)
        if kind == "note" and starred and not numbered:
            opts += ["thmwithin=none", "eqwithin=none", "codewithin=none"]
            notes.append(T("只有 \\section*：加上 thmwithin=none, eqwithin=none, codewithin=none，"
                           "定理、方程式、程式碼編成 1、2、3，不是 0.1",
                           "only \\section*: added thmwithin=none, eqwithin=none, codewithin=none, so theorems, "
                           "equations and code count 1, 2, 3 instead of 0.1"))
        pre[cls_line] = f"\\documentclass{'[' + ', '.join(opts) + ']' if opts else ''}{{{KINDS[kind]}}}"
        changes.append(T(f"{old_cls} → {KINDS[kind]}" + (f"（{', '.join(opts)}）" if opts else ""),
                         f"{old_cls} -> {KINDS[kind]}" + (f" ({', '.join(opts)})" if opts else "")))
        if dropped:
            notes.append(T(f"沒有對應的 class 選項，已略過：{', '.join(dropped)}",
                           f"class options with no akizumi equivalent, dropped: {', '.join(dropped)}"))
    if not pre[0].startswith("% !TEX program"):
        pre.insert(0, "% !TEX program = xelatex")
        cls_line += 1
    elif "xelatex" not in pre[0]:
        pre[0] = "% !TEX program = xelatex"
        changes.append(T("改用 XeLaTeX 編譯", "builds with XeLaTeX now"))

    # packages: drop the ones compat ignores; akizumi already loads others,
    # and loading them again with options is an option clash
    akz_names, akz_packages = akizumi_names(kind)
    dropped_pkgs = []
    for i, l in enumerate(pre):
        m = re.match(r"(\s*)\\usepackage\s*(\[[^\]]*\])?\s*\{([^}]*)\}(.*)$", l)
        if not m or l.lstrip().startswith("%"):
            continue
        names = [p.strip() for p in m.group(3).split(",") if p.strip()]
        keep = [p for p in names if p not in DROP_PACKAGES and p not in akz_packages]
        gone = [p for p in names if p not in keep]
        if not gone:
            continue
        if m.group(2) and any(p in akz_packages for p in gone):
            notes.append(T(f"{', '.join(gone)} 的選項 {m.group(2)} 沒有保留（akizumi 已經載入）",
                           f"options {m.group(2)} of {', '.join(gone)} not kept (akizumi loads it already)"))
        new = f"{m.group(1)}\\usepackage{m.group(2) or ''}{{{','.join(keep)}}}{m.group(4)}" if keep else None
        pre[i] = (new + "\n" if new else "") + f"% ax migrate: {l.strip()}"
        dropped_pkgs += gone
    if kind == "slides" and dropped_pkgs:
        # the theme loads what was dropped (TikZ): \usetikzlibrary and the
        # like must come after it
        at = next((i for i, l in enumerate(pre) if re.match(r"\s*\\usetheme\s*(?:\[[^\]]*\])?\s*\{Akizumi\}", l)), None)
        needs = next((i for i, l in enumerate(pre) if not l.lstrip().startswith("%") and re.match(
            r"\s*\\(?:usetikzlibrary|tikzset|pgfplotsset|usepgfplotslibrary|pgfdeclare)", l)), None)
        if at is not None and needs is not None and needs < at:
            theme_line, rest = pre[at].split("\n", 1) if "\n" in pre[at] else (pre[at], None)
            if rest is None:
                del pre[at]
            else:
                pre[at] = rest
            pre.insert(needs, theme_line)
    if dropped_pkgs:
        changes.append(T(f"不再載入 {', '.join(dropped_pkgs)}（akizumi 已經有，或用不到）",
                         f"no longer loading {', '.join(dropped_pkgs)} (akizumi has them, or they are not needed)"))
    if "math-notes" in dropped_pkgs:
        # \renewcommand of what math-notes (or a package it loaded) defined,
        # e.g. \backrefalt: give the name a definition first, so it still works
        guarded = []
        for i, l in enumerate(pre):
            if l.lstrip().startswith("%"):
                continue
            m = re.search(r"\\renewcommand(\*?)\s*\{?\s*\\([A-Za-z]+)", l)
            if m and "\\" + m.group(2) not in akz_names and m.group(2) not in LATEX_KERNEL_NAMES \
                    and not defined_by_latex(m.group(2), akz_packages):
                pre[i] = f"\\providecommand{m.group(1)}{{\\{m.group(2)}}}{{}}" + l
                guarded.append("\\" + m.group(2))
        if guarded:
            notes.append(T(f"{', '.join(guarded)} 原本由 math-notes 提供，akizumi 沒有：先用 \\providecommand 定義，"
                           "\\renewcommand 才不會出錯；用不到可以刪掉",
                           f"{', '.join(guarded)} came from math-notes, which akizumi does not have: "
                           "\\providecommand defines them first so the \\renewcommand works; delete them if unused"))

    # the document's own \newcommand of a name akizumi has: the document's
    # meaning wins, as it did before (files it \input's are only reported)
    renewed = []
    for i, l in enumerate(pre):
        if l.lstrip().startswith("%"):
            continue
        new = re.sub(r"\\newcommand(\*?)(\s*\{?\s*)\\([A-Za-z]+)(?![A-Za-z])",
                     lambda m: ("\\renewcommand" if "\\" + m.group(3) in akz_names else "\\newcommand")
                     + m.group(1) + m.group(2) + "\\" + m.group(3), l)
        new = re.sub(r"\\DeclareMathOperator(\*?)(\s*\{?\s*)\\([A-Za-z]+)(?![A-Za-z])",
                     lambda m: (f"\\let\\{m.group(3)}\\relax" if "\\" + m.group(3) in akz_names else "")
                     + m.group(0), new)
        if new != l:
            renewed += ["\\" + n for n in re.findall(r"\\(?:renewcommand\*?\s*\{?\s*|let)\\([A-Za-z]+)", new)
                        if "\\" + n in akz_names]
            pre[i] = new
    if renewed:
        changes.append(T(f"{', '.join(renewed)} 保留你自己的定義（改成 \\renewcommand；akizumi 也有）",
                         f"{', '.join(renewed)}: your own definition is kept (now \\renewcommand; akizumi has one too)"))

    # memoir's line spacing commands -> setspace
    if old_cls == "memoir":
        spacing = {"setSpacing": "setstretch", "OnehalfSpacing": "onehalfspacing",
                   "DoubleSpacing": "doublespacing", "SingleSpacing": "singlespacing",
                   "OnehalfSpacing*": "onehalfspacing", "DoubleSpacing*": "doublespacing"}
        pat = re.compile(r"\\(setSpacing|OnehalfSpacing\*?|DoubleSpacing\*?|SingleSpacing)(?![A-Za-z])")
        used = False
        for part in (pre, body):
            for i, l in enumerate(part):
                if l.lstrip().startswith("%"):
                    continue
                new = pat.sub(lambda m: "\\" + spacing[m.group(1)], l)
                if new != l:
                    part[i], used = new, True
        if used:
            pre.insert(cls_line + 1, "\\usepackage{setspace}")
            changes.append(T("memoir 的行距指令改成 setspace 的（\\setSpacing → \\setstretch …）",
                             "memoir's spacing commands now use setspace (\\setSpacing -> \\setstretch, ...)"))

    # memoir / math-notes course macros -> \akizumisetup, \author, \title
    setup, meta, labels, values, layout = [], [], [], {}, []
    for i, l in enumerate(pre):
        m = re.match(r"\s*\\(?:def|newcommand\*?|renewcommand\*?)\s*\{?\s*\\([A-Za-z]+)\s*\}?\s*(?=\{)", l)
        if not m or (m.group(1) not in COURSE_MACROS and m.group(1) not in LAYOUT_MACROS):
            continue
        value, end = _braced(l, m.end())
        if value is None:
            continue
        name, value = m.group(1), value.strip()
        pre[i] = f"% ax migrate: {l.strip()}"
        values[name] = value
        if name in COURSE_MACROS and value:
            key = COURSE_MACROS[name]
            if key in ("author", "title"):
                setup.append(f"\\{key}{{{value}}}")
                labels.append(f"\\{key}")
            else:
                meta.append(f"{key}={{{value}}}")
                labels.append(f"{key}=")
        elif name in LAYOUT_MACROS and value and name != "coverpagesize":
            layout.append("\\" + name)
    if layout:
        notes.append(T(f"版面巨集沒有對應的 akizumi 設定，已註解掉：{', '.join(layout)}",
                       f"layout macros with no akizumi setting, commented out: {', '.join(layout)}"))
    # the body may still say \coursename: keep those as plain macros
    live = "\n".join(l for l in pre + body if not l.lstrip().startswith("%"))
    keep_defs = [f"\\newcommand{{\\{n}}}{{{v}}}" for n, v in values.items()
                 if re.search(r"\\" + n + r"(?![A-Za-z])", live)]
    if setup:
        changes.append(T("課程巨集改成 " + "、".join(labels), "course macros moved to " + ", ".join(labels)))
    pre[cls_line + 1:cls_line + 1] = setup + keep_defs

    # \setcounter{chapter}{N} (in the preamble or the body) and the memoir
    # \chapter title: homework gets number=, a note the \chapter as its \title
    has_title = any(re.match(r"\s*\\maketitle", l) for l in body)
    live = lambda l: l.strip() and not l.lstrip().startswith("%")
    counter = next(((part, i, m) for part in (pre, body) for i, l in enumerate(part)
                    for m in [re.match(r"(\s*)\\setcounter\{chapter\}\{(\d+)\}", l)] if m), None)
    chapters_in_body = [i for i, l in enumerate(body) if re.match(r"\s*\\chapter\*?\s*(?:\[[^\]]*\])?\s*\{", l)]
    if kind != "book" and (counter or len(chapters_in_body) == 1):
        nxt = None
        if counter:
            part, i, m = counter
            start = i + 1 if part is body else 1
            nxt = next((j for j in range(start, len(body)) if live(body[j])), None)
            if nxt is not None and not re.match(r"\s*\\chapter\*?\s*(?:\[[^\]]*\])?\s*\{", body[nxt]):
                nxt = None
        elif not old_cls.startswith("akizumi-"):
            nxt = chapters_in_body[0]
        starred = nxt is not None and re.match(r"\s*\\chapter\*", body[nxt])
        number = int(counter[2].group(2)) if counter else None
        if number is not None and nxt is not None and not starred:
            number += 1  # \chapter steps the counter; \chapter* does not
        if counter:
            part, i, m = counter
            if kind == "hw":
                meta.insert(0, f"number={number}")
                changes.append(T(f"\\setcounter{{chapter}}{{{m.group(2)}}} → number={number}",
                                 f"\\setcounter{{chapter}}{{{m.group(2)}}} -> number={number}"))
            else:
                notes.append(T(f"\\setcounter{{chapter}}{{{m.group(2)}}} 已註解掉（{KINDS[kind]} 沒有章）",
                               f"\\setcounter{{chapter}}{{{m.group(2)}}} commented out ({KINDS[kind]} has no chapters)"))
            part[i] = f"{m.group(1)}% ax migrate: {part[i].strip()}"
        if nxt is not None:
            indent = re.match(r"\s*", body[nxt]).group(0)
            title, _ = _braced(body[nxt], body[nxt].index("{", body[nxt].index("\\chapter") + 8))
            body[nxt] = f"{indent}% ax migrate: {body[nxt].strip()}" + ("" if has_title else f"\n{indent}\\maketitle")
            n_title = re.search(r"(\d+)\s*$", title or "")
            if kind == "hw" and not counter and n_title:  # \chapter*{Homework 3}
                meta.insert(0, f"number={n_title.group(1)}")
                changes.append(T(f"\\chapter{{{title}}} → number={n_title.group(1)}",
                                 f"\\chapter{{{title}}} -> number={n_title.group(1)}"))
            if kind != "hw" and title and not any("\\title{" in x for x in setup):
                pre.insert(cls_line + 1, f"\\title{{{title}}}")
                if number is not None and not starred:
                    kicker = f"第 {number} 章" if _guess_lang(body_text) == "zh" else f"Chapter {number}"
                    meta.append(f"kicker={{{kicker}}}")
                changes.append(T(f"\\chapter{{{title}}} → \\title" + ("、kicker" if number and not starred else ""),
                                 f"\\chapter{{{title}}} -> \\title" + (", kicker" if number and not starred else "")))
            has_title = True
    if meta:
        pre.insert(cls_line + 1, "\\akizumisetup{" + ", ".join(meta) + "}")
    # unless the body opens with a title of its own: a titlepage, or a
    # centred / large block near the top that names the course, the author,
    # the assignment or the date (not a heading such as "Hand-Written Part")
    top = "\n".join(body[:12])
    names = [re.escape(v) for v in values.values() if v and len(v) > 2]
    own_title = re.search(r"\\begin\{titlepage\}", top) or (
        re.search(r"\\begin\{center\}|\\(LARGE|huge|Huge)\b", top)
        and re.search("|".join([r"\\today", r"\\(?:course|author|document)name", r"\\@?title\b",
                                r"\b(?:Homework|Assignment|Problem Set|Report)\b", "作業", "報告"] + names), top, re.I))
    if not has_title and not own_title and kind in ("hw", "note") and not old_cls.startswith("akizumi-"):
        body.insert(1, "\\maketitle")
        changes.append(T("加上 \\maketitle", "added \\maketitle"))

    # \section*{Problem k} -> problem environments (hw only)
    if kind == "hw":
        heads = [i for i, l in enumerate(body) if PROBLEM_HEAD.match(_strip_comment(l))]
        expected, out, open_, rank = 1, [], False, 2

        def close():
            # \end{problem} before trailing blank lines and page breaks
            k = len(out)
            while k and (not out[k - 1].strip() or re.match(r"\s*\\(newpage|clearpage|pagebreak)\b", out[k - 1])):
                k -= 1
            out.insert(k, "\\end{problem}")

        for i, l in enumerate(body):
            m = PROBLEM_HEAD.match(_strip_comment(l)) if i in heads else None
            h = HEADING.match(l)
            if open_ and (m or (h and (not h["level"] or HEADING_RANK[h["level"]] <= rank))):
                close()
                open_ = False
            if m:
                title = m["title"].strip("()（） ")
                if m["n"] and not m["n"].isdigit():
                    # Problem 1.1, 2.a, 3b: a label of its own, the count is untouched
                    opt = f"label={m['n']}" + (f", title={{{title}}}" if title else "")
                    out.append(f"{m['indent']}\\begin{{problem}}[{opt}]")
                    open_, rank = True, 3 if m["level"] else 2
                    continue
                k = int(m["n"]) if m["n"] else _zh_number(m["zh"])
                if k is not None and k != expected:
                    out.append(f"{m['indent']}\\setcounter{{problem}}{{{k - 1}}}")
                expected = (k or expected) + 1
                out.append(f"{m['indent']}\\begin{{problem}}" + (f"[{title}]" if title else ""))
                open_, rank = True, 3 if m["level"] else 2
                continue
            out.append(l)
        if heads:
            body = out
            changes.append(T(f"{len(heads)} 個 \\section*{{Problem k}} → problem 環境",
                             f"{len(heads)} \\section*{{Problem k}} -> problem environments"))

    return "\n".join(pre + body), kind, changes, notes, set(renewed)


def local_preamble_files(path, text):
    """[(file, content)]: the preamble of `text`, then the local .tex / .sty
    files it reads (and the ones those read), as LaTeX would find them."""
    out, seen = [], set()
    files = [(path, text.split("\\begin{document}")[0])]
    while files:
        f, content = files.pop(0)
        if f in seen:
            continue
        seen.add(f)
        out.append((f, content))
        for m in re.finditer(r"\\(?:input|include|usepackage|RequirePackage)\s*(?:\[[^\]]*\])?\s*\{([^}]*)\}",
                             "\n".join(_strip_comment(l) for l in content.splitlines())):
            for name in m.group(1).split(","):
                name = name.strip()
                for cand in (name, name + ".tex", name + ".sty"):
                    p = (path.parent / cand)
                    if p.is_file() and p.suffix in (".tex", ".sty"):
                        files.append((p, p.read_text(errors="replace")))
                        break
    return out


# Packages akizumi loads that also count as loaded under another name.
IMPLIED_PACKAGES = {"xcolor": ["color"], "graphicx": ["graphics"], "tikz": ["pgf"]}


def option_passes(path, text, kind):
    """\\PassOptionsToPackage lines for packages that local files load with
    options but akizumi loads first (else: Option clash), and where."""
    _, packages = akizumi_names(kind)
    for p in list(packages):
        packages.update(IMPLIED_PACKAGES.get(p, []))
    passes, where = {}, []
    for f, content in local_preamble_files(path, text)[1:]:
        for no, line in enumerate(content.splitlines(), 1):
            line = _strip_comment(line)
            for m in re.finditer(r"\\(?:usepackage|RequirePackage)\s*\[([^\]]*)\]\s*\{([^}]*)\}", line):
                opts = ",".join(o.strip() for o in m.group(1).split(",") if o.strip())
                for pkg in (p.strip() for p in m.group(2).split(",")):
                    if pkg in packages and opts:
                        passes.setdefault(pkg, [])
                        for o in opts.split(","):
                            if o not in passes[pkg]:
                                passes[pkg].append(o)
                        where.append(f"{f.name}:{no} {pkg}")
    return [f"\\PassOptionsToPackage{{{','.join(o)}}}{{{p}}}" for p, o in passes.items()], where


def clash_report(path, text, kind, skip=()):
    """(where, message) for each definition in the preamble or the local files
    it reads that clashes with akizumi or with LaTeX's one-letter commands."""
    names, _ = akizumi_names(kind)
    report = []
    for f, content in local_preamble_files(path, text):
        for no, line in enumerate(content.splitlines(), 1):
            line = _strip_comment(line)
            for m in list(CS_DEF.finditer(line)) + list(ENV_DEF.finditer(line)):
                name = m["name"] if m.re is ENV_DEF else "\\" + m["name"]
                how = m["how"]
                where = f"{f.name}:{no}"
                if f == path and name in skip:
                    continue
                if name in names:
                    if how in ("providecommand", "ProvideDocumentCommand"):
                        msg = T(f"{name} 被忽略：akizumi 已經定義，用的是 akizumi 的",
                                f"{name} is ignored: akizumi defines it, and akizumi's wins")
                    elif how in ("renewcommand", "renewenvironment", "RenewDocumentCommand", "RenewDocumentEnvironment",
                                 "def", "gdef", "edef", "xdef", "let", "DeclareRobustCommand", "DeclareDocumentCommand"):
                        msg = T(f"{name} 蓋掉 akizumi 的定義（意思可能不同）",
                                f"{name} replaces akizumi's definition (the meaning may differ)")
                    else:
                        msg = T(f"{name} akizumi 已經定義：LaTeX 會報 already defined",
                                f"{name} is already defined by akizumi: LaTeX stops with \"already defined\"")
                    report.append((where, msg))
                elif m.re is CS_DEF and m["name"] in LATEX_LETTERS and how in ("def", "gdef", "edef", "let", "renewcommand"):
                    report.append((where, T(f"{name} 蓋掉 LaTeX 的同名指令（重音或特殊字母，如 \\c{{c}}、\\v{{s}}、\\S）",
                                            f"{name} replaces LaTeX's own (an accent or letter, e.g. \\c{{c}}, \\v{{s}}, \\S)")))
    return report


def cmd_migrate(a):
    src = Path(a.file if a.file.endswith(".tex") else a.file + ".tex")
    if not src.is_file():
        die(T(f"找不到 {src}", f"{src} not found"))
    text = src.read_text(errors="replace")
    if a.output and not a.in_place:
        dest = Path(a.output)
        if dest.exists() and dest.resolve() == src.resolve():
            # -o naming the source itself: as --in-place, with the .bak
            a.in_place = True
        elif not dest.parent.is_dir():
            die(T(f"資料夾 {dest.parent} 不存在", f"The folder {dest.parent} does not exist"),
                T("先建立資料夾，或用 -o 指定別的位置", "Create it first, or give another place with -o"))
    new, kind, changes, notes, renewed = migrate_text(text, a.kind)
    if a.in_place:
        dest = src
    elif a.output:
        dest = Path(a.output)
    else:
        dest = src.with_name(f"{src.stem}-akizumi.tex")
    if dest.exists() and dest != src and not a.force and not a.dry_run:
        die(T(f"{dest} 已經存在", f"{dest} already exists"),
            T("加 --force 覆寫，或用 -o 指定別的檔名", "Add --force to overwrite it, or pick another name with -o"))

    # local style files that load akizumi's packages with options of their own
    passes, where = option_passes(src, new, kind)
    if passes:
        lines = new.split("\n")
        at = next(i for i, l in enumerate(lines) if re.match(r"\s*\\documentclass", l))
        lines[at:at] = passes
        new = "\n".join(lines)
        changes.append(T(f"{', '.join(sorted({w.split()[1] for w in where}))} 的選項改在 \\documentclass 前傳入"
                         f"（{', '.join(where)}；否則 Option clash）",
                         f"options of {', '.join(sorted({w.split()[1] for w in where}))} now passed before "
                         f"\\documentclass ({', '.join(where)}; else an option clash)"))
    # math-notes is no longer loaded: colors of its that the document uses
    if "% ax migrate: " in new and re.search(r"% ax migrate: .*\{[^}]*\bmath-notes\b", new):
        sty = src.parent / "math-notes.sty"
        if not sty.is_file():
            found = subprocess.run(["kpsewhich", "math-notes.sty"], capture_output=True, text=True).stdout.strip()
            sty = Path(found) if found else None
        if sty and sty.is_file():
            # packages math-notes loaded that akizumi does not
            _, akz_packages = akizumi_names(kind)
            for p in list(akz_packages):
                akz_packages.update(IMPLIED_PACKAGES.get(p, []))
            sty_body = "\n".join(_strip_comment(l) for l in sty.read_text(errors="replace").splitlines())
            missing = []
            for m in re.finditer(r"\\(?:RequirePackage|usepackage)\s*(?:\[[^\]]*\])?\s*\{([^}]*)\}", sty_body):
                for pkg in (x.strip() for x in m.group(1).split(",")):
                    if pkg and pkg not in akz_packages and pkg not in missing and pkg not in DROP_PACKAGES \
                            and pkg not in new:
                        missing.append(pkg)
            if missing:
                notes.append(T(f"math-notes 還載入了 akizumi 沒有的套件：{', '.join(missing)}；"
                               "文件用到它們的指令（例如 natbib 的 \\citealp）時，自己加上 \\usepackage",
                               f"math-notes also loaded packages akizumi does not: {', '.join(missing)}; "
                               "if the document uses their commands (natbib's \\citealp, say), add a \\usepackage"))
            live = "\n".join(_strip_comment(l) for l in new.split("\n"))
            colors = [m.group(0) for m in re.finditer(r"\\definecolor\{(\w+)\}\{[^}]*\}\{[^}]*\}",
                                                       sty.read_text(errors="replace"))
                      if re.search(r"[{!,]\s*" + m.group(1) + r"\s*[}!,]", live)
                      and not re.search(r"\\definecolor\{" + m.group(1) + r"\}", live)]
            if colors:
                lines = new.split("\n")
                at = next(i for i, l in enumerate(lines) if re.match(r"\s*\\documentclass", l)) + 1
                lines[at:at] = colors
                new = "\n".join(lines)
                named = ", ".join(re.findall(r"definecolor.(\w+)", " ".join(colors)))
                changes.append(T(f"從 math-notes 搬來用到的顏色：{named}",
                                 f"colors the document uses, copied from math-notes: {named}"))

    print(T(f"{cmd_text(str(src))} → {KIND_NAME[kind]}（{KINDS[kind]}）",
            f"{cmd_text(str(src))} -> {KIND_NAME[kind]} ({KINDS[kind]})"))
    for c in changes:
        ok(c)
    for n in notes:
        warn(n)
    clashes = clash_report(src, new, kind, renewed)
    per_file = {}
    for where, _ in clashes:
        per_file[where.rsplit(":", 1)[0]] = per_file.get(where.rsplit(":", 1)[0], 0) + 1
    for name, count in per_file.items():
        if name != src.name and count >= 8:
            notes_style = T(f"{name} 有 {count} 處撞名，像是舊的版面檔：考慮拿掉讀它的那一行，只把需要的巨集搬過來",
                            f"{name} has {count} clashes and looks like an old style file: consider dropping it "
                            "and moving over only the macros you need")
            warn(notes_style)
    if clashes:
        print(T("\n跟 akizumi 撞名：", "\nClashes with akizumi:"))
        for where, msg in clashes:
            warn(f"{where}  {msg}")
        note(T("  改名，或把 \\newcommand 換成 \\renewcommand（確定要你自己的意思時）",
               "  Rename them, or use \\renewcommand when you mean your own definition"))
    if a.dry_run:
        note(T("\n（--dry-run：沒有寫檔）", "\n(--dry-run: nothing written)"))
        return
    if a.in_place:
        backup = src.with_name(src.name + ".bak")
        if not backup.exists():
            shutil.copyfile(src, backup)
            note(T(f"  原檔備份在 {backup}", f"  The original is kept as {backup}"))
    dest.write_text(new if new.endswith("\n") else new + "\n")
    print()
    ok(T(f"已寫入 {dest}", f"Wrote {dest}"))
    print(T(f"  在 ax 專案裡：{cmd_text('ax build ' + dest.name)}；其他地方：{cmd_text('latexmk -xelatex ' + dest.name)}",
            f"  In an ax project: {cmd_text('ax build ' + dest.name)}; elsewhere: {cmd_text('latexmk -xelatex ' + dest.name)}"))
    shared = shared_preamble(dest.parent)
    if shared:
        note(T(f"  也會讀共用 preamble {shared}", f"  It also reads the shared preamble {shared}"))
    if a.project:
        # make the folder an ax project around the migrated file: ax build,
        # ax watch and Cursor then use XeLaTeX and the templates
        folder = dest.parent
        cfg_path = folder / PROJECT_CONFIG
        cfg = load_json(cfg_path) if cfg_path.exists() else {}
        cfg.update({"kind": kind, "main": dest.name})
        cfg.setdefault("template", a.pin or "latest")
        tracked = None if "pdf" in cfg else tracked_pdf(folder, dest, new)
        if tracked:
            cfg["pdf"] = tracked
        cfg_path.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
        write_build_files(folder, kind)
        ok(T(f"已設成 ax 專案（{PROJECT_CONFIG}、latexmkrc、.vscode；模板 {cfg['template']}）",
             f"Set up as an ax project ({PROJECT_CONFIG}, latexmkrc, .vscode; template {cfg['template']})"))
        if tracked:
            ok(T(f"PDF 照 git 裡原本的檔名輸出成 {tracked}（.ax.json 的 \"pdf\"）",
                 f"The PDF keeps the name it has in git, {tracked} (\"pdf\" in .ax.json)"))


def tracked_pdf(folder, main, text):
    """The one PDF git tracks directly in folder when it is not named after
    main (and is not a figure the document includes); else None."""
    r = subprocess.run(["git", "-C", str(folder), "ls-files", "-z", "--", "*.pdf"],
                       stdin=subprocess.DEVNULL, capture_output=True)
    if r.returncode:
        return None
    names = [n for n in r.stdout.decode("utf-8", "replace").split("\0") if n and "/" not in n]
    if len(names) != 1 or names[0] == f"{Path(main).stem}.pdf":
        return None
    stem = Path(names[0]).stem
    if re.search(r"\\(?:includegraphics|includepdf|input)\s*(?:\[[^\]]*\])?\s*\{[^}]*" + re.escape(stem), text):
        return None
    return names[0]


# ---------- ax selftest ----------

def selftest_watch(ax, d, result):
    """ax watch --bg builds after an edit, --status answers, --stop ends it."""
    label = T("專案 watch --bg", "project watch --bg")
    run = lambda *args: subprocess.run(ax + ["watch", *args], cwd=d, stdin=subprocess.DEVNULL,
                                       capture_output=True, encoding="utf-8", errors="replace")
    main_tex, pdf, last = d / "main.tex", d / "main.pdf", d / WATCH_LAST
    main_tex.write_text(main_tex.read_text() + "\n% watched\n")  # out of date: -pvc builds at once
    before = pdf.stat().st_mtime if pdf.exists() else 0
    r = run("--bg")
    if r.returncode:
        result(False, label)
        print(r.stdout + r.stderr)
        return
    state = json.loads((d / WATCH_STATE).read_text())
    built = False
    for _ in range(120):
        if last.exists() and pdf.exists() and pdf.stat().st_mtime != before:
            built = json.loads(last.read_text()).get("ok", False)
            break
        time.sleep(0.5)
    status = run("--status").returncode
    stop = run("--stop").returncode
    time.sleep(0.5)
    gone = not pid_alive(int(state["pid"]))
    if not built:
        warn(T("watch --bg 60 秒內沒有完成編譯；build/watch.log：",
               "watch --bg did not finish a build within 60 s; build/watch.log:"))
        log = d / WATCH_LOG
        print(log.read_text(errors="replace")[-2000:] if log.exists() else "")
    result(status == 0 and stop == 0 and gone, label)


def selftest_compat(ax, tmp, result):
    """akizumi-compat: a project reads the shared preamble two folders up, and
    ax migrate turns tests/migrate/old-hw.tex into a document that builds.
    Both build against the working tree's templates."""
    saved = os.environ.get("TEXINPUTS")
    os.environ["TEXINPUTS"] = str(REPO) + os.pathsep
    try:
        course = tmp / "course"
        (course / ".akizumi").mkdir(parents=True)
        (course / ".akizumi" / "preamble.tex").write_text(
            "\\akizumisetup{course={Shared}}\n\\newcommand{\\sharedmacro}{from the shared preamble}\n")
        d = course / "hw" / "t-shared"
        r = subprocess.run(ax + ["new", "hw", str(d), "--no-preamble", "--pin", "latest"],
                           stdin=subprocess.DEVNULL, capture_output=True, encoding="utf-8", errors="replace")
        code, out = r.returncode, r.stdout + r.stderr
        if code == 0:
            main_tex = d / "main.tex"
            main_tex.write_text(main_tex.read_text().replace("% Problem statement.", "\\sharedmacro"))
            code, out, _ = run_with_spinner(ax + ["build"], T("專案 共用 preamble", "project shared preamble"), cwd=d)
            status = subprocess.run(ax, cwd=d, stdin=subprocess.DEVNULL, capture_output=True,
                                    encoding="utf-8", errors="replace").stdout
            log = (d / "build" / "main.log").read_text(errors="replace") if code == 0 else ""
            if code == 0 and ("akizumi-compat: shared preamble" not in log or "preamble.tex" not in status):
                code, out = 1, status
        result(code == 0, T("專案 共用 preamble（.akizumi/preamble.tex）", "project shared preamble (.akizumi/preamble.tex)"))
        if code:
            print(out)

        d = tmp / "migrate"
        d.mkdir()
        shutil.copyfile(REPO / "tests" / "migrate" / "old-hw.tex", d / "old-hw.tex")
        r = subprocess.run(ax + ["migrate", "old-hw.tex"], cwd=d, stdin=subprocess.DEVNULL,
                           capture_output=True, encoding="utf-8", errors="replace")
        code, out = r.returncode, r.stdout + r.stderr
        if code == 0:
            code, more, _ = run_with_spinner(
                ["latexmk", "-xelatex", "-halt-on-error", "-interaction=nonstopmode", "old-hw-akizumi.tex"],
                T("ax migrate", "ax migrate"), cwd=d)
            out += more
            if code == 0 and (d / "old-hw.tex").read_text() != (REPO / "tests" / "migrate" / "old-hw.tex").read_text():
                code, out = 1, T("ax migrate 改到了原檔", "ax migrate changed the original file")
        result(code == 0, T("ax migrate（舊作業轉換後能編譯）", "ax migrate (an old homework builds once migrated)"))
        if code:
            print(out)
            print_error(d / "old-hw-akizumi.log")
        # more shapes: what migrate writes, and that it builds
        for name, kind, wanted in (
                ("old-note", "note", ["14pt", "eqwithin=none", "\\title{Sequences}", "kicker={Chapter 2}",
                                      "\\author{Tzu-You Lin}", "id={B1}", "\\setlength{\\parindent}{25pt}",
                                      "aaronlin1229.github.io"]),
                ("old-hw2", "hw", ["number=1,", "[label=1.1]", "[label=2.a]", "\\maketitle"]),
                ("old-slides", "slides", ["\\usetheme{Akizumi}\n\\usetikzlibrary"])):
            shutil.copyfile(REPO / "tests" / "migrate" / f"{name}.tex", d / f"{name}.tex")
            r = subprocess.run(ax + ["migrate", f"{name}.tex", "--kind", kind], cwd=d, stdin=subprocess.DEVNULL,
                               capture_output=True, encoding="utf-8", errors="replace")
            code, out = r.returncode, r.stdout + r.stderr
            new = (d / f"{name}-akizumi.tex").read_text() if code == 0 else ""
            missing = [w for w in wanted if w not in new]
            if code == 0 and missing:
                code, out = 1, T("轉出的檔案少了：", "the migrated file lacks: ") + ", ".join(missing) + "\n" + new
            if code == 0:
                code, out, _ = run_with_spinner(
                    ["latexmk", "-xelatex", "-halt-on-error", "-interaction=nonstopmode", f"{name}-akizumi.tex"],
                    T(f"ax migrate {name}", f"ax migrate {name}"), cwd=d)
            result(code == 0, T(f"ax migrate（{name}）", f"ax migrate ({name})"))
            if code:
                print(out)
                print_error(d / f"{name}-akizumi.log")
    finally:
        if saved is None:
            os.environ.pop("TEXINPUTS", None)
        else:
            os.environ["TEXINPUTS"] = saved

# ---------- ax selftest docs: the ```latex blocks in docs/reference*.md ----------
# A block with \documentclass is built as it is (\begin{document} is added after
# its preamble when it has none). Any other block is a fragment: its preamble
# commands go before \begin{document}, the rest after, in a default document.
# Fragments of the same class and options share one document; when that fails,
# each of them is built alone to find the broken one. An HTML comment on the
# line before a block changes this:
#   <!-- snippet: skip -->                            not built (pseudocode, partial)
#   <!-- snippet: class=akizumi-hw options=lang=zh,solutions -->
#   <!-- snippet: beamer -->                          a frame of an Akizumi deck
#   <!-- snippet: preamble -->                        preamble only, empty body
#   <!-- snippet: packages=akizumi-paper -->          \usepackage these first
#   <!-- snippet: ci-skip=macos,windows -->           not built on these systems in CI

SNIPPET_DOCS = (("docs/reference.md", "zh"), ("docs/reference.en.md", "en"))
SNIPPET_COMMENT = re.compile(r"^<!--\s*snippet:\s*(.*?)\s*-->$")
SNIPPET_PREAMBLE = re.compile(
    r"^\s*\\(?:documentclass|usepackage|RequirePackage|usetheme|akizumisetup|newcommand|renewcommand|"
    r"providecommand|DeclareMathOperator|DeclarePairedDelimiter|addbibresource|akizumiNewTheorem|"
    r"akizumiSetTheorem|akizumiNewCallout|akizumiCalloutSetup|akizumiNewCodeKind|akizumiNewIndex|"
    r"newcommenter|newif|title|subtitle|author|date|institute|usetikzlibrary|tikzset|pgfplotsset)"
    r"(?![A-Za-z@])")
SNIPPET_FILES = re.compile(r"\\(inputcode|lstinputlisting|inputproblem|include|input)\*?"
                           r"(?:\[[^\]]*\])?\{([^}]+)\}")
SNIPPET_CITES = re.compile(r"\\(?:cite|citep|citet|textcite|parencite|autocite)\*?(?:\[[^\]]*\])*\{([^}]+)\}")
SNIPPET_BIBS = re.compile(r"\bbib=([^,\]\s]+)|\\addbibresource\{([^}]+)\}")
# figures the snippets name (figures/a.pdf) need not exist: a box stands in
SNIPPET_SHIM = (r"\AtBeginDocument{\ifdefined\includegraphics\let\axSnippetGraphics\includegraphics"
                r"\renewcommand\includegraphics[2][]{\IfFileExists{#2}{\axSnippetGraphics[#1]{#2}}"
                r"{\fbox{\ttfamily\detokenize{#2}}}}\fi}")


def ci_skipped(systems):
    """This system's name when CI runs here and `systems` ("macos, windows") names it."""
    system = "macos" if MACOS else "windows" if WINDOWS else "linux"
    return system if os.environ.get("CI") and re.search(rf"\b{system}\b", systems) else None


def doc_snippets(rel, lang):
    """The ```latex blocks of one docs file, with the snippet comment before each."""
    lines = (REPO / rel).read_text(encoding="utf-8").splitlines()
    found, i = [], 0
    while i < len(lines):
        if lines[i].strip() == "```latex":
            j = i + 1
            while j < len(lines) and lines[j].strip() != "```":
                j += 1
            k = i - 1
            while k >= 0 and not lines[k].strip():
                k -= 1
            m = SNIPPET_COMMENT.match(lines[k].strip()) if k >= 0 else None
            opts = {}
            for word in m.group(1).split() if m else []:
                key, _, value = word.partition("=")
                opts[key] = value
            found.append({"file": rel, "fence": i + 1, "lang": lang, "opts": opts,
                          "lines": [(t, i + 2 + n) for n, t in enumerate(lines[i + 1:j])]})
            i = j
        i += 1
    return found


def _brace_depth(line):
    line = _strip_comment(line).replace("\\{", "").replace("\\}", "")
    return line.count("{") - line.count("}")


def _placeholder(t):
    return _strip_comment(t).strip() in ("", "...", "…")


def snippet_split(lines, preamble_only=False):
    """(preamble, body) of a fragment: preamble commands, with the lines their
    braces run on to, move to the preamble."""
    if preamble_only:
        return list(lines), []
    pre, body, target, depth = [], [], None, 0
    for t, n in lines:
        if depth <= 0:
            target = pre if SNIPPET_PREAMBLE.match(t) else body
            depth = 0
        target.append((t, n))
        depth += _brace_depth(t)
    return pre, body


def snippet_standalone(s):
    """A block with \\documentclass, completed into a document."""
    lines = list(s["lines"])
    cls = next(i for i, (t, _) in enumerate(lines) if "\\documentclass" in t)
    lines.insert(cls + 1, (SNIPPET_SHIM, None))
    text = "\n".join(t for t, _ in lines)
    if "\\begin{document}" not in text:
        end, depth = cls + 2, 0
        while end < len(lines):
            t = lines[end][0]
            if depth <= 0 and not (SNIPPET_PREAMBLE.match(t) or _placeholder(t)):
                break
            depth = max(depth, 0) + _brace_depth(t)
            end += 1
        pre = [x for x in lines[:end] if x[1] is None or not _placeholder(x[0])]
        lines = pre + [("\\begin{document}", None)] + lines[end:]
    if "\\end{document}" not in text:
        lines.append(("\\end{document}", None))
    return lines


def snippet_group_key(s):
    o = s["opts"]
    options = o.get("options", "")
    if "lang=" not in options:
        options = f"lang={s['lang']}" + ("," + options if options else "")
    return ("beamer" if "beamer" in o else o.get("class", "akizumi-note"), options, o.get("packages", ""))


def snippet_document(key, group):
    """One document holding every fragment of a group, \\clearpage between them."""
    cls, options, packages = key
    out = ([("\\documentclass[aspectratio=169]{beamer}", None), (f"\\usetheme[{options}]{{Akizumi}}", None)]
           if cls == "beamer" else [(f"\\documentclass[{options}]{{{cls}}}", None)])
    out.append((SNIPPET_SHIM, None))
    out += [(f"\\usepackage{{{p}}}", None) for p in packages.split(",") if p]
    bodies = []
    for s in group:
        pre, body = snippet_split(s["lines"], "preamble" in s["opts"])
        out += pre
        bodies.append(body)
    out.append(("\\begin{document}", None))
    if not any(bodies):
        out.append(("\\null", None))  # a document without pages is an error
    for body in bodies:
        if not body:
            continue
        text = "\n".join(t for t, _ in body)
        frame = cls == "beamer" and not re.search(r"\\begin\{frame\}|\\(?:standout|divider)frame", text)
        if frame:
            out.append(("\\begin{frame}[fragile]{Snippet}", None))
        out += body
        out.append(("\\end{frame}" if frame else "\\clearpage", None))
    out.append(("\\end{document}", None))
    return out


def snippet_stubs(work, snippets):
    """Files the snippets read: code, problem and chapter files, bibliographies."""
    def safe(name):
        return name and not Path(name).is_absolute() and ".." not in Path(name).parts and "\\" not in name
    keys, bibs = set(), set()
    for s in snippets:
        text = "\n".join(t for t, _ in s["lines"])
        for cmd, name in SNIPPET_FILES.findall(text):
            name = name.strip()
            if not safe(name):
                continue
            code = cmd in ("inputcode", "lstinputlisting")
            path = work / (name if code or Path(name).suffix else name + ".tex")
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text("".join(f"line {n}\n" for n in range(1, 41)) if code else "Stub text.\n",
                            encoding="utf-8")
        for group in SNIPPET_CITES.findall(text):
            keys.update(k.strip() for k in group.split(",") if k.strip())
        bibs.update((a or b).strip() for a, b in SNIPPET_BIBS.findall(text))
    bib = "".join(f"@article{{{k}, author={{A. Author}}, title={{Title}}, journal={{J}}, year={{2026}}}}\n"
                  for k in sorted(keys))
    for name in filter(safe, bibs):
        (work / name).parent.mkdir(parents=True, exist_ok=True)
        (work / name).write_text(bib, encoding="utf-8")


def snippet_build(work, name, lines):
    """Build one generated document: (ok, docs line of the first error when it
    is in a snippet, message)."""
    (work / f"{name}.tex").write_text("\n".join(t for t, _ in lines) + "\n", encoding="utf-8")
    env = dict(os.environ, TEXINPUTS=f"{REPO}{os.pathsep}{os.environ.get('TEXINPUTS', '')}")
    proc = subprocess.Popen(["latexmk", "-xelatex", "-interaction=nonstopmode", "-halt-on-error",
                             "-file-line-error", "-outdir=build", f"{name}.tex"],
                            cwd=work, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, encoding="utf-8", errors="replace",
                            start_new_session=not WINDOWS)
    try:
        out, _ = proc.communicate(timeout=240)
    except subprocess.TimeoutExpired:
        kill_tree(proc)
        proc.communicate()
        return False, None, T("超時", "timed out")
    if proc.returncode == 0:
        return True, None, ""
    err = first_error(work / "build" / f"{name}.log")
    if not err:
        return False, None, " / ".join([x for x in out.splitlines() if x.strip()][-3:])
    location, message, context = err
    where = None
    m = re.search(r"([^/\\]+)\.tex:(\d+)$", location)
    if m and m.group(1) == name and 0 < int(m.group(2)) <= len(lines):
        where = lines[int(m.group(2)) - 1][1]
    return False, where, message + "".join(f"\n      {c}" for c in context)


def selftest_docs(result):
    """Build every ```latex block of docs/reference.md and docs/reference.en.md."""
    from concurrent.futures import ThreadPoolExecutor
    need_tool("latexmk", T("請先安裝 TeX Live，再執行 ax doctor", "Install TeX Live, then run ax doctor"))
    work = REPO / "docs" / "build" / "snippets"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True)
    start = time.time()
    per_file = {rel: doc_snippets(rel, lang) for rel, lang in SNIPPET_DOCS}
    run, skipped = [], {rel: 0 for rel in per_file}
    for rel, snippets in per_file.items():
        for s in snippets:
            if "skip" in s["opts"] or ci_skipped(s["opts"].get("ci-skip", "")):
                skipped[rel] += 1
            else:
                run.append(s)
    snippet_stubs(work, run)
    jobs, groups = {}, {}  # jobs: name -> (snippets, generated lines)
    for s in run:
        if any("\\documentclass" in t for t, _ in s["lines"]):
            jobs[f"s{len(jobs)}"] = ([s], snippet_standalone(s))
        else:
            groups.setdefault((s["file"],) + snippet_group_key(s), []).append(s)
    for key, group in groups.items():
        jobs[f"g{len(jobs)}"] = (group, snippet_document(key[1:], group))
    note(T(f"編譯文件裡的 {len(run)} 個 LaTeX 片段（{len(jobs)} 份文件）…",
           f"Building {len(run)} LaTeX snippets from the docs ({len(jobs)} documents)..."))
    build = lambda table: lambda n: snippet_build(work, n, table[n][1])
    # biber is a packed executable that unpacks itself on its first run;
    # several first runs at once can trip over each other (seen on macOS CI)
    if shutil.which("biber") and any(SNIPPET_BIBS.search("\n".join(t for t, _ in s["lines"])) for s in run):
        subprocess.run(["biber", "--version"], capture_output=True)
    with ThreadPoolExecutor(max(1, min(4, os.cpu_count() or 1))) as pool:
        done = dict(zip(jobs, pool.map(build(jobs), jobs)))
        # one quiet retry, alone, for documents that failed next to others:
        # a real error fails again, a clash between parallel runs does not
        for name in [n for n, (good, _, _) in done.items() if not good]:
            shutil.rmtree(work / "build" / name, ignore_errors=True)
            for leftover in (work / "build").glob(f"{name}.*"):
                leftover.unlink()
            done[name] = snippet_build(work, name, jobs[name][1])
        # a shared document failed: build its fragments one by one to find which
        alone = {f"{name}-{s['fence']}": (name, [s], snippet_document(snippet_group_key(s), [s]))
                 for name, (good, _, _) in done.items() if not good and len(jobs[name][0]) > 1
                 for s in jobs[name][0]}
        alone_done = dict(zip(alone, pool.map(lambda n: snippet_build(work, n, alone[n][2]), alone)))
    failures = {rel: [] for rel in per_file}
    for name, (good, where, message) in done.items():
        group = jobs[name][0]
        if good:
            continue
        if len(group) == 1:
            failures[group[0]["file"]].append((group[0]["fence"], where, message))
            continue
        bad = [(alone[n][1][0], r) for n, r in alone_done.items() if alone[n][0] == name and not r[0]]
        for s, (_, where1, message1) in bad:
            failures[s["file"]].append((s["fence"], where1, message1))
        if not bad:
            warn(T("這些片段單獨都能編譯，放在同一份文件才失敗（", "These snippets build alone but fail in one document (")
                 + ", ".join(f"{s['file']}:{s['fence']}" for s in group) + T("）：", "): ") + message)
    for rel, snippets in per_file.items():
        bad = sorted(failures[rel])
        extra = T(f"，略過 {skipped[rel]} 個", f", {skipped[rel]} skipped") if skipped[rel] else ""
        result(not bad, T(f"文件片段 {rel}（{len(snippets)} 個{extra}）", f"doc snippets {rel} ({len(snippets)}{extra})"))
        for fence, where, message in bad:
            line = f"{rel}:{fence}" + (T(f"（錯在第 {where} 行）", f" (error on line {where})") if where else "")
            print(f"  {_paint(line, '1', err=True)}{T('：', ': ')}{message}", file=sys.stderr)
    if any(failures.values()):
        note(T(f"產生的文件在 {work}", f"The generated documents are in {work}"))
    note(T(f"文件片段共 {elapsed(time.time() - start)}", f"doc snippets took {elapsed(time.time() - start)}"))



def cmd_selftest(a):
    """Rebuild the examples and build one fresh project of each kind."""
    failed = []

    def result(good, label):
        (ok if good else fail)(label)
        if not good:
            failed.append(label)

    if a.part in ("all", "examples"):
        ex = REPO / "examples"
        shutil.rmtree(ex / "build", ignore_errors=True)
        for name in ("hw", "note", "exam", "slides", "book", "cheatsheet"):
            code, _, secs = run_with_spinner(
                ["latexmk", "-r", "latexmkrc", "-halt-on-error", "-interaction=nonstopmode",
                 f"{name}.tex"], T(f"範例 {name}", f"example {name}"), cwd=ex)
            result(code == 0, T(f"範例 {name:<10}（{elapsed(secs)}）", f"example {name:<10} ({elapsed(secs)})"))
            if code:
                print_error(ex / "build" / f"{name}.log")
            elif name == "cheatsheet":  # linked from the README, so kept next to its source
                shutil.copyfile(ex / "build" / "cheatsheet.pdf", ex / "cheatsheet.pdf")
    if a.part in ("all", "tests"):
        # tests/*.tex: one small document per feature, built against the working
        # tree; "% !TEX program = pdflatex|lualatex" on line 1 picks the engine
        td = REPO / "tests"
        shutil.rmtree(td / "build", ignore_errors=True)
        for tex in sorted(td.glob("*.tex")):
            # "% ci-skip: macos" skips a test on that system in CI (fonts macOS
            # downloads on first use make XeTeX wait forever without network)
            head = tex.read_text(errors="replace")[:600]
            skip = re.search(r"^% ci-skip:(.*)$", head, re.M)
            system = skip and ci_skipped(skip.group(1))
            if system:
                note(T(f"略過 {tex.stem}（CI 的 {system} 上不跑）", f"skipped {tex.stem} (not run on {system} in CI)"))
                continue
            first = head.split("\n", 1)[0]
            engine = "-pdf" if "pdflatex" in first else "-lualatex" if "lualatex" in first else "-xelatex"
            code, out, secs = run_with_spinner(
                ["latexmk", "-r", "latexmkrc", engine, "-halt-on-error", "-interaction=nonstopmode",
                 tex.name], T(f"測試 {tex.stem}", f"test {tex.stem}"), cwd=td, timeout=240, fatal=False)
            result(code == 0, T(f"測試 {tex.stem}（{elapsed(secs)}）", f"test {tex.stem} ({elapsed(secs)})")
                   + (T("：超時", ": timed out") if code == 124 else ""))
            if code == 124:  # show where it stopped
                log = td / "build" / f"{tex.stem}.log"
                tail = log.read_text(errors="replace").splitlines()[-25:] if log.exists() else out.splitlines()[-25:]
                print("\n".join("    " + line for line in tail))
            elif code:
                print_error(td / "build" / f"{tex.stem}.log")
    if a.part in ("all", "projects"):
        tmp = Path(tempfile.mkdtemp(prefix="ax-selftest-"))
        ax = [sys.executable, str(AX)]
        # --pin latest builds against this checkout, not the installed copy
        # (they differ in a worktree; new template files must be found too)
        os.environ["TEXINPUTS"] = f"{REPO}{os.pathsep}{os.environ.get('TEXINPUTS', '')}"
        for kind in KINDS:
            d = tmp / f"t-{kind}"
            # --pin latest: test the templates as they are now, not the last tag
            r = subprocess.run(ax + ["new", kind, str(d), "--title", "Test", "--no-preamble",
                                     "--pin", "latest"],
                               stdin=subprocess.DEVNULL, capture_output=True,
                               encoding="utf-8", errors="replace")
            out = r.stdout + r.stderr
            code = r.returncode
            if code == 0:
                code, out, secs = run_with_spinner(ax + ["build"], T(f"專案 {kind}", f"project {kind}"), cwd=d)
            result(code == 0, T(f"專案 {kind:<7}", f"project {kind:<7}"))
            if code:
                print(out)
        if (tmp / "t-hw").is_dir():
            code, out, _ = run_with_spinner(ax + ["both"], T("專案 both", "project both"), cwd=tmp / "t-hw")
            result(code == 0 and (tmp / "t-hw" / "main-solutions.pdf").exists(), T("專案 both", "project both"))
            if code:
                print(out)
            selftest_watch(ax, tmp / "t-hw", result)
        else:
            result(False, T("專案 both（作業專案沒有建立成功）", "project both (the homework project was not created)"))
        selftest_build(ax, tmp, result)  # prebuild, shell_escape, --chapter, count
        selftest_pdfname(ax, tmp, result)
        # references: biber runs and the citation resolves
        d = tmp / "t-bib"
        r = subprocess.run(ax + ["new", "note", str(d), "--title", "Test", "--bib", "--no-preamble",
                                 "--pin", "latest"], stdin=subprocess.DEVNULL, capture_output=True,
                           encoding="utf-8", errors="replace")
        good = False
        if r.returncode == 0:
            (d / "refs.bib").write_text("@article{key, author={A. Author}, title={T}, "
                                        "journal={J}, year={2026}}\n")
            main_tex = d / "main.tex"
            main_tex.write_text(main_tex.read_text().replace(
                "\\section{Introduction}", "\\section{Introduction}\nSee~\\cite{key}."))
            code, out, _ = run_with_spinner(ax + ["build"], T("專案 參考文獻", "project references"), cwd=d)
            good = code == 0 and not any("cite" in w for w in warnings_summary(d / "build" / "main.log"))
            if not good:
                print(out)
        result(good, T("專案 參考文獻（biber）", "project references (biber)"))
        # ax new hw --problems: problem files and \inputproblem
        d = tmp / "t-problems"
        r = subprocess.run(ax + ["new", "hw", str(d), "--problems", "2,B2", "--no-preamble",
                                 "--pin", "latest"], stdin=subprocess.DEVNULL, capture_output=True,
                           encoding="utf-8", errors="replace")
        code, out = r.returncode, r.stdout + r.stderr
        if code == 0:
            code, out, _ = run_with_spinner(ax + ["build"], T("專案 分題檔案", "project problem files"), cwd=d)
        result(code == 0 and (d / "problems" / "B2.tex").exists(),
               T("專案 作業 --problems", "project hw --problems"))
        if code:
            print(out)
        # code=minted: .ax.json asks for -shell-escape unless TeX's restricted
        # shell escape runs latexminted (TeX Live 2024+); without Pygments the
        # document warns and falls back to listings, so it still builds
        d = tmp / "t-minted"
        r = subprocess.run(ax + ["new", "note", str(d), "--title", "Test", "--code", "minted",
                                 "--no-preamble", "--pin", "latest"], stdin=subprocess.DEVNULL,
                           capture_output=True, encoding="utf-8", errors="replace")
        good = False
        if r.returncode == 0:
            for f in template_files(REPO):  # this checkout's files, even if another one is installed
                shutil.copy(f, d)
            main_tex = d / "main.tex"
            main_tex.write_text(main_tex.read_text().replace(
                "\\section{Introduction}", "\\section{Introduction}\n\\code[cpp]{int x;}\n"
                "\\begin{codeblock}[numbered, lang=python]\nprint(1)\n\\end{codeblock}"))
            code, out, _ = run_with_spinner(ax + ["build"], T("專案 code=minted", "project code=minted"), cwd=d)
            # full shell escape only where restricted shell escape cannot run latexminted
            good = code == 0 and (load_json(d / PROJECT_CONFIG).get("shell_escape") is True) != restricted_minted()
            if not good:
                print(out)
        result(good, T("專案 code=minted", "project code=minted"))
        # paper venues: the scaffold builds on the venue's style file without
        # option clashes. tests/venue-stubs stand in for the real files.
        bst = subprocess.run(["kpsewhich", "plainnat.bst"], capture_output=True, text=True).stdout.strip()
        for venue, v in PAPER_VENUES.items():
            if not v:
                continue
            d = tmp / f"t-paper-{venue}"
            r = subprocess.run(ax + ["new", "paper", str(d), "--venue", venue, "--split", "--title", "Test",
                                     "--no-preamble", "--pin", "latest"], stdin=subprocess.DEVNULL,
                               capture_output=True, encoding="utf-8", errors="replace")
            code, out = r.returncode, r.stdout + r.stderr
            if code == 0:
                shutil.copy(REPO / "tests" / "venue-stubs" / f"{venue}.sty", d / f"{v['sty']}.sty")
                if bst:
                    shutil.copy(bst, d / f"{v['sty']}.bst")
                (d / "refs.bib").write_text("@article{key, author={A. Author}, title={T}, "
                                            "journal={J}, year={2026}}\n")
                intro = d / "sections" / "introduction.tex"
                intro.write_text(intro.read_text() + "See \\citet{key}, \\eg \\cref{sec:method}.\n")
                code, out, _ = run_with_spinner(ax + ["build"], T(f"專案 paper {venue}", f"project paper {venue}"),
                                                cwd=d)
            result(code == 0, T(f"專案 paper --venue {venue}", f"project paper --venue {venue}"))
            if code:
                print(out)
        # main languages, with all three scripts in one document. Missing
        # characters depend on the fonts installed, so they only warn.
        for lang in ("zh", "ja", "ko"):
            d = tmp / f"t-{lang}"
            r = subprocess.run(ax + ["new", "hw", str(d), "--lang", lang, "--thmnames", "native",
                                     "--no-preamble", "--pin", "latest"],
                               stdin=subprocess.DEVNULL, capture_output=True,
                               encoding="utf-8", errors="replace")
            code, out = r.returncode, r.stdout + r.stderr
            if code == 0:
                main_tex = d / "main.tex"
                main_tex.write_text(main_tex.read_text().replace(
                    "% Problem statement.", "日本語の値、繁體中文的特徵值、한국어 문장. \\cref{thm:x}\n"
                    "\\begin{theorem}\\label{thm:x} $a=b$. \\end{theorem}"))
                code, out, _ = run_with_spinner(ax + ["build"], T(f"專案 lang={lang}", f"project lang={lang}"), cwd=d)
            result(code == 0, T(f"專案 lang={lang}", f"project lang={lang}"))
            if code:
                print(out)
            else:
                log = (d / "build" / "main.log").read_text(errors="replace")
                missing = sorted(set(re.findall(r"Missing character: There is no (\S+)", log)))
                if missing:
                    warn(T(f"lang={lang} 缺字（裝 Noto CJK 可補齊）：{' '.join(missing[:10])}",
                           f"lang={lang} missing characters (Noto CJK fills them in): {' '.join(missing[:10])}"))
        selftest_compat(ax, tmp, result)
        # ---------- index=true: ax build runs the indexer (upmendex or makeindex) ----------
        d = tmp / "t-index"
        r = subprocess.run(ax + ["new", "note", str(d), "--lang", "zh", "--no-preamble", "--pin", "latest"],
                           stdin=subprocess.DEVNULL, capture_output=True, encoding="utf-8", errors="replace")
        code, out = r.returncode, r.stdout + r.stderr
        if code == 0:
            main_tex = d / "main.tex"
            main_tex.write_text(main_tex.read_text().replace("[lang=zh]", "[lang=zh, index=true]").replace(
                "\\section{Introduction}", "\\printnotation\n\\section{Introduction}\n"
                "積分\\index{積分}、一致\\index{一致}、mesh\\index{partition!mesh}"
                "\\nota{$\\abs{x}$}{絕對值 |x|}\n\\printindex"))
            # TEXINPUTS already puts this checkout first (see above)
            code, out, _ = run_with_spinner(ax + ["build"], T("專案 索引", "project index"), cwd=d)
            ind = d / "build" / "main.ind"
            nota = d / "build" / "main-notation.ind"
            if code == 0 and not (ind.exists() and "\\hyperpage" in ind.read_text()
                                  and nota.exists() and "絕對值" in nota.read_text()):
                code, out = 1, T("索引或符號表沒有產生", "the index or the notation list was not made")
        result(code == 0, T("專案 索引（index=true）", "project index (index=true)"))
        if code:
            print(out)
        # ax docs: it maps sections between the two manuals by position, so
        # their headings must line up; and a topic finds its section
        zh_heads, en_heads = doc_sections(docs_file("zh"))[1], doc_sections(docs_file("en"))[1]
        r = subprocess.run(ax + ["docs", "theorem"], stdin=subprocess.DEVNULL, capture_output=True,
                           encoding="utf-8", errors="replace", env={**os.environ, "AX_LANG": "zh"})
        good = _same_shape(zh_heads, en_heads) and r.returncode == 0 and "### 定理" in r.stdout
        # paragraphs too, section by section, so a hit maps to the same paragraph
        zl, el = doc_sections(docs_file("zh"))[0], doc_sections(docs_file("en"))[0]
        apart = [f"docs/reference.md:{z['line'] + 1}" for z, e in zip(zh_heads, en_heads)
                 if len(doc_blocks(zl, z["line"] + 1, z["own"])) != len(doc_blocks(el, e["line"] + 1, e["own"]))]
        for where in apart:
            fail(T(f"  {where}：中英文手冊這一節的段落數不同", f"  {where}: this section has a different number "
                   "of paragraphs in the two manuals"))
        good = good and not apart
        # plain words, and no Chinese in the English answer
        r = subprocess.run(ax + ["docs", "number by section"], stdin=subprocess.DEVNULL, capture_output=True,
                           encoding="utf-8", errors="replace", env={**os.environ, "AX_LANG": "en"})
        good = good and r.returncode == 0 and "thmwithin" in r.stdout and not re.search(r"[\u4e00-\u9fff]", r.stdout)
        result(good, T("ax docs（兩種語言的手冊標題、段落對得上）", "ax docs (the two manuals' headings and paragraphs line up)"))
        if not good:
            print(T(f"  標題數：中文 {len(zh_heads)}，英文 {len(en_heads)}",
                    f"  headings: Chinese {len(zh_heads)}, English {len(en_heads)}"))
            print(r.stdout + r.stderr)
        shutil.rmtree(tmp, ignore_errors=True)
    if a.part in ("all", "docs"):
        selftest_docs(result)
    print()
    if failed:
        fail(T(f"{len(failed)} 項失敗", f"{len(failed)} failed"))
        sys.exit(1)
    ok(T("全部通過", "All passed"))


# ---------- recent projects (for the ax menu) ----------
RECENT = CACHE / "recent.json"


def remember_project(root=None):
    """Note a project in the recent list (newest first, at most 12)."""
    try:
        root = Path(root or ".").resolve()  # commands chdir to the project first
        cfg = load_json(root / PROJECT_CONFIG)
        if not cfg:
            return
        items = [r for r in load_json(RECENT) or [] if r.get("path") != str(root)]
        items.insert(0, {"path": str(root), "kind": cfg.get("kind", "?"), "time": time.time()})
        RECENT.parent.mkdir(parents=True, exist_ok=True)
        RECENT.write_text(json.dumps(items[:12], ensure_ascii=False, indent=1))
    except (OSError, ValueError, TypeError):
        pass


def recent_projects():
    items = load_json(RECENT)
    if not isinstance(items, list):
        return []
    return [r for r in items if isinstance(r, dict) and (Path(r.get("path", "")) / PROJECT_CONFIG).exists()]


# ---------- bare `ax`: project status ----------

def ago(path):
    secs = time.time() - path.stat().st_mtime
    if secs < 60:
        return T("剛剛", "just now")
    if secs < 3600:
        return T(f"{int(secs // 60)} 分鐘前", f"{int(secs // 60)} min ago")
    if secs < 86400:
        return T(f"{int(secs // 3600)} 小時前", f"{int(secs // 3600)} h ago")
    return T(f"{int(secs // 86400)} 天前", f"{int(secs // 86400)} days ago")


def show_status(actions=True):
    """Bare `ax` inside a project: what this project is and what to do next
    (actions=False when a menu follows instead of the command list)."""
    cfg = find_project(quiet=True)
    if not cfg:
        return False
    kind = cfg.get("kind", "?")
    main = Path(cfg.get("main", "main.tex"))
    pin = cfg.get("template", "?")
    tags = template_tags()
    print(T(f"{cmd_text(Path.cwd().name)}（{KIND_NAME.get(kind, kind)}）",
            f"{cmd_text(Path.cwd().name)} ({KIND_NAME.get(kind, kind)})"))
    version = pin
    if pin == "frozen":
        version = T(f"已 freeze（來自 {cfg.get('frozen_from')}）", f"frozen (from {cfg.get('frozen_from')})")
    elif pin == "latest":
        version = T("latest（跟著模板 repo 目前的內容）", "latest (follows the template repo as it is now)")
    elif tags and pin != tags[0]:
        version = T(f"{pin}（有新版 {tags[0]}：ax upgrade）", f"{pin} (newer: {tags[0]}, ax upgrade)")
    print(T(f"  模板  {version}", f"  template  {version}"))
    pdf = output_pdf(main.stem, cfg=cfg)
    if pdf.exists():
        state = T(f"{pdf}，{ago(pdf)}更新", f"{pdf}, updated {ago(pdf)}")
    else:
        state = T("還沒編譯過", "not built yet")
    print(T(f"  PDF   {state}", f"  PDF       {state}"))
    shared = shared_preamble()
    if shared:
        print(T(f"  共用  {shared}", f"  shared    {shared}"))
    running = watcher()
    if running:
        print(T(f"  監看  背景執行中（PID {running['pid']}；ax watch --status、--stop）",
                f"  watch     running in the background (PID {running['pid']}; ax watch --status, --stop)"))
    if not actions:
        return True
    print(T("\n常用：", "\nUseful:"))
    for c, text in ((("ax watch", T("存檔就重編", "rebuild on save")),
                     ("ax build", T("編譯一次", "build once")),
                     ("ax open", T("打開 PDF", "open the PDF")))
                    + ((("ax both", T("題目卷和解答", "problems and solutions")),)
                       if kind in ("hw", "exam") else ())):
        print(f"  {cmd_text(c):<20} {text}")
    note(T("\n全部指令：ax --help", "\nAll commands: ax --help"))
    return True


# ---------- bare `ax` on a terminal: menus ----------

def _short(path, limit=48):
    home = str(Path.home())
    path = "~" + path[len(home):] if path.startswith(home) else path
    return path if len(path) <= limit else "…" + path[-(limit - 1):]


def _run(parser, argv):
    a = parser.parse_args(argv)
    a.func(a)


def home_menu(parser):
    """Bare `ax` outside a project."""
    tags = template_tags()
    print(f"{cmd_text('akizumi-latex')} {_paint(tags[0] if tags else '', '2')}")
    print(_paint(T("這裡不是專案資料夾。要做什麼？", "Not in a project folder. What next?"), "2"))
    recent = recent_projects()
    items = [("new", T("建立新文件", "Start a new document"), "ax new")]
    if recent:
        items.append(("recent", T("最近的專案", "Recent projects"),
                      T(f"{len(recent)} 個", f"{len(recent)}")))
    items += [("doctor", T("檢查環境", "Check the setup"), "ax doctor"),
              ("docs", T("查文件", "Look something up"), "ax docs"),
              ("help", T("所有指令", "All commands"), "ax --help")]
    i = select("", [(label, hint) for _, label, hint in items])
    if i is None:
        return
    key = items[i][0]
    print()
    if key == "new":
        _run(parser, ["new"])
    elif key == "recent":
        recent_menu(recent)
    elif key == "doctor":
        _run(parser, ["doctor"])
    elif key == "docs":
        topic = ask(T("查什麼？（例如 定理、minted、index；留白打開整份手冊）：",
                      "Topic? (e.g. theorem, minted, index; blank opens the manual): "))
        _run(parser, ["docs"] + topic.split())
    else:
        parser.print_help()


def recent_menu(recent):
    def label(r):
        name = Path(r["path"]).name
        return f"{name}  {_paint(KIND_NAME.get(r.get('kind'), r.get('kind', '')), '2')}"
    i = select(T("最近的專案：", "Recent projects:"),
               [(label(r), _short(r["path"])) for r in recent])
    if i is None:
        return
    path = Path(recent[i]["path"])
    print()
    options = []
    if shutil.which("cursor"):
        options.append(("cursor", T("用 Cursor 開啟", "Open in Cursor")))
    cfg = load_json(path / PROJECT_CONFIG)
    pdf = path / output_pdf(Path(cfg.get("main", "main.tex")).stem, cfg=cfg)
    if pdf.exists():
        options.append(("pdf", T("打開 PDF", "Open the PDF")))
    options.append(("folder", T("打開資料夾", "Open the folder")))
    j = select(cmd_text(_short(str(path))), [(text, "") for _, text in options])
    if j is not None:
        what = options[j][0]
        if what == "cursor":
            subprocess.Popen(["cursor", str(path)])
        elif what == "pdf":
            open_file(pdf)
        else:
            open_file(path)
    note(T(f"在終端機進入專案：cd {_short(str(path))}", f"To work there: cd {_short(str(path))}"))


def project_menu(parser, cfg):
    """Bare `ax` inside a project, after its status."""
    kind = cfg.get("kind")
    running = watcher()
    items = [(["build"], T("編譯一次", "Build once"), "ax build"),
             (["watch"], T("存檔就重編", "Rebuild on save"), "ax watch")]
    if running:
        items.append((["watch", "--stop"], T("停止背景監看", "Stop the background watcher"), "ax watch --stop"))
    else:
        items.append((["watch", "--bg"], T("在背景監看", "Watch in the background"), "ax watch --bg"))
    items.append((["open"], T("打開 PDF", "Open the PDF"), "ax open"))
    if kind in ("hw", "exam"):
        items.append((["both"], T("題目卷和解答各一份", "Problems and solutions"), "ax both"))
    if shutil.which("cursor"):
        items.append((None, T("用 Cursor 開啟", "Open in Cursor"), "cursor ."))
    items += [(["docs"], T("查文件", "Look something up"), "ax docs"),
              (["--help"], T("所有指令", "All commands"), "ax --help")]
    print()
    i = select(T("要做什麼？", "What next?"), [(label, hint) for _, label, hint in items])
    if i is None:
        return
    argv = items[i][0]
    print()
    if argv is None:
        subprocess.Popen(["cursor", "."])
    elif argv == ["--help"]:
        parser.print_help()
    elif argv == ["docs"]:
        topic = ask(T("查什麼？（例如 定理、minted、index；留白打開整份手冊）：",
                      "Topic? (e.g. theorem, minted, index; blank opens the manual): "))
        _run(parser, ["docs"] + topic.split())
    else:
        _run(parser, argv)



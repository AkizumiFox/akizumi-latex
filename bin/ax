                  "leaving the original alone; list macros that clash with akizumi's."),
                [("ax migrate thesis.tex", "寫出 thesis-akizumi.tex", "writes thesis-akizumi.tex"),
                 ("ax migrate hw1.tex --kind hw --dry-run", "只列出會改什麼", "only list the changes"),
                 ("ax migrate main.tex --in-place", "直接改原檔，原檔備份成 main.tex.bak",
                  "rewrite it in place, keeping main.tex.bak")]),
    "docs": (T("查參考手冊（docs/reference.md）。給主題就在終端機印出最相關的一節；中英文都能查，"
               "也可以是選項名稱或巨集。",
               "Look things up in the reference (docs/reference.en.md). With a topic, the best-matching "
               "section is printed here; Chinese or English words, option names and macros all work."),
             [("ax docs", "打開整份手冊", "open the whole manual"),
              (T("ax docs 定理", "ax docs theorem"), "印出〈定理、定義、證明〉", 'print "Theorems, definitions, proofs"'),
              (T("ax docs 按節編號", 'ax docs "number by section"'), "一般的說法也行：印出 thmwithin 選項",
               "plain words work too: prints the thmwithin option"),
              ("ax docs thmcounter --web", "在瀏覽器打開提到它的那一節", "open the section about it in the browser"),
              ("ax docs --cheatsheet", "打開速查表 PDF", "open the cheat sheet PDF")]),
}


class ExamplesFormatter(argparse.HelpFormatter):
    """Wraps a one-paragraph description; keeps text with line breaks (the
    examples, the command list) as written, wrapping only lines too wide for
    the terminal under their own description column. Widths count CJK
    characters as two columns, which argparse itself does not."""

    def _fill_text(self, text, width, indent):
        if "\n" not in text:
            return "\n".join(wrap_cols(" ".join(text.split()), width + len(indent), indent))
        out = []
        for line in text.splitlines():
            if _width(indent + line) <= self._width:
                out.append(indent + line)
                continue
            m = re.match(r"(\s*\S+(?: \S+)*?\s{2,})(\S.*)", line)  # "  command   what it does"
            lead, rest = (m.group(1), m.group(2)) if m else (re.match(r"\s*", line).group(0), line.strip())
            if _width(lead) > self._width // 2:
                lead, rest = re.match(r"\s*", line).group(0), line.strip()
                out += wrap_cols(rest, self._width, indent + lead + "  ", indent + lead)
            else:
                out += wrap_cols(rest, self._width, indent + " " * _width(lead), indent + lead)
        return "\n".join(out) + ("\n" if text.endswith("\n") else "")

    def _split_lines(self, text, width):
        return wrap_cols(" ".join(text.split()), width)

    def add_argument(self, action):
        if action.help is not argparse.SUPPRESS:
            lengths = [_width(self._format_action_invocation(x)) + self._current_indent
                       for x in [action, *self._iter_indented_subactions(action)]]
            self._action_max_length = max(self._action_max_length, *lengths)
            self._add_item(self._format_action, [action])

    def _format_action(self, action):
        help_position = min(self._action_max_length + 2, self._max_help_position)
        help_width = max(self._width - help_position, 11)
        action_width = help_position - self._current_indent - 2
        header = self._format_action_invocation(action)
        if not action.help:
            parts = [" " * self._current_indent + header + "\n"]
        elif _width(header) <= action_width:
            parts = [" " * self._current_indent + header + " " * (action_width - _width(header) + 2)]
            indent_first = 0
        else:
            parts = [" " * self._current_indent + header + "\n"]
            indent_first = help_position
        if action.help and action.help.strip():
            lines = self._split_lines(self._expand_help(action), help_width)
            parts.append(" " * indent_first + lines[0] + "\n")
            parts += [" " * help_position + line + "\n" for line in lines[1:]]
        elif not parts[0].endswith("\n"):
            parts.append("\n")
        for sub in self._iter_indented_subactions(action):
            parts.append(self._format_action(sub))
        return self._join_parts(parts)

    def _format_usage(self, usage, actions, groups, prefix):
        # argparse wraps the usage line by len(); narrow it until it fits
        width = self._width
        try:
            for _ in range(30):
                text = super()._format_usage(usage, actions, groups, prefix)
                if max(_width(l) for l in text.splitlines() or [""]) <= width or self._width < 30:
                    return text
                self._width -= 2
            return text
        finally:
            self._width = width


def _width(text):
    """Columns text takes in a terminal: CJK characters take two; colour
    codes and control characters none."""
    text = re.sub(r"\x1b\[[0-9;]*m", "", text)
    # \x03 \x04 mark code in the manual's text: backticks without colour
    marks = "\x03\x04" if not COLOR["out"] else ""
    return sum(1 if ch in marks else 0 if ord(ch) < 32 else
               2 if unicodedata.east_asian_width(ch) in "WF" else 1 for ch in text)


def cmd_help(name):
    """add_parser keywords for a command's --help."""
    description, examples = CMD_HELP.get(name, (None, []))
    # prog: Python before 3.10 would put the top-level usage line in front
    kw = {"prog": f"ax {name}", "help": HELP_LINES[name], "description": description or HELP_LINES[name],
          "formatter_class": ExamplesFormatter}
    if examples:
        width = max(_width(c) for c, _, _ in examples) + 2
        kw["epilog"] = T("範例：\n", "Examples:\n") + "\n".join(
            f"  {c}{' ' * (width - _width(c))}{T(zh, en)}" for c, zh, en in examples)
    return kw


# argparse's own words in the Chinese interface. argparse looks them up
# through its module-level _() each time it formats help (and when a parser
# adds -h), so replacing _ translates them; the English interface keeps them.
# Error messages stay as they are: Parser.error reads them.
ARGPARSE_ZH = {
    "usage: ": "用法：",
    "options": "選項",
    "optional arguments": "選項",  # Python before 3.10
    "positional arguments": "參數",
    "show this help message and exit": "顯示這段說明",
    "show program's version number and exit": "顯示版本",
    "%(heading)s:": "%(heading)s：",
}
if UI == "zh":
    _argparse_gettext = argparse._
    argparse._ = lambda text: ARGPARSE_ZH.get(text) or _argparse_gettext(text)


CMD_METAVAR = T("指令", "command")


class Parser(argparse.ArgumentParser):
    """argparse with friendlier error messages and typo suggestions."""

    def format_help(self):
        text = super().format_help()
        if UI == "zh":  # "選項:" from Pythons whose heading colon is not translatable
            text = re.sub(r"^(選項|參數)((?:\x1b\[[0-9;]*m)*):", r"\1\2：", text, flags=re.M)
        return text

    def error(self, message):
        m = re.search(r"invalid choice: '([^']*)'", message)
        if m and CMD_METAVAR in message:
            word = m.group(1)
            guess = suggest(word, PUBLIC_COMMANDS)
            die(T(f"沒有 {word} 這個指令" + (f"，你是不是要打 {cmd_text('ax ' + guess)}？" if guess else ""),
                  f"There is no command {word}" + (f"; did you mean {cmd_text('ax ' + guess)}?" if guess else "")),
                T("ax --help 看全部指令", "ax --help lists all commands"))
        m = re.search(r"argument (\S+): invalid choice: '([^']*)' \(choose from (.*)\)", message)
        if m:
            choices = re.findall(r"'([^']*)'", m.group(3))
            guess = suggest(m.group(2), choices)
            die(T(f"{m.group(1)} 不能是 {m.group(2)}" + (f"，你是不是要打 {guess}？" if guess else ""),
                  f"{m.group(1)} cannot be {m.group(2)}" + (f"; did you mean {guess}?" if guess else "")),
                T(f"可用的值：{'、'.join(choices)}", f"Choices: {', '.join(choices)}"))
        m = re.search(r"unrecognized arguments: (.*)", message)
        if m:
            word = m.group(1).split()[0]
            # argparse reports these from the top parser: the command's own
            # options are the ones to suggest from
            prog, options = self.prog, NEW_OPTIONS
            cmd = next((w for w in sys.argv[1:] if not w.startswith("-")), None)
            if PARSER is not None and cmd in PUBLIC_COMMANDS:
                cp = next(x for x in PARSER._actions if isinstance(x, argparse._SubParsersAction)).choices[cmd]
                prog = cp.prog
                options = [o for x in cp._actions for o in x.option_strings if o.startswith("--")]
            guess = suggest(word, options) if word.startswith("-") else None
            die(T(f"看不懂的參數：{m.group(1)}" + (f"，你是不是要打 {guess}？" if guess else ""),
                  f"Unknown argument: {m.group(1)}" + (f"; did you mean {guess}?" if guess else "")),
                T(f"{prog} --help 看可用的參數", f"{prog} --help lists the options"))
        m = re.search(r"the following arguments are required: (.*)", message)
        if m:
            die(T(f"少了參數：{m.group(1)}", f"Missing argument: {m.group(1)}"),
                T(f"{self.prog} --help 看用法", f"{self.prog} --help shows how to use it"))
        hint = T(f"{self.prog} --help 看用法", f"{self.prog} --help shows how to use it")
        m = re.search(r"argument (\S+): invalid (\w+) value: '([^']*)'", message)
        if m:
            kind = {"int": T("整數", "a whole number"), "float": T("數字", "a number")}.get(m.group(2), m.group(2))
            die(T(f"{m.group(1)} 要是{kind}，不能是 {m.group(3)}", f"{m.group(1)} must be {kind}, not {m.group(3)}"), hint)
        m = re.search(r"argument (\S+): expected (one|at least one|at most one) argument", message)
        if m:
            die(T(f"{m.group(1)} 後面要接一個值", f"{m.group(1)} needs a value after it"), hint)
        m = re.search(r"argument (\S+): not allowed with argument (\S+)", message)
        if m:
            die(T(f"{m.group(1)} 和 {m.group(2)} 不能一起用", f"{m.group(1)} and {m.group(2)} cannot be used together"), hint)
        m = re.search(r"ambiguous option: (\S+) could match (.*)", message)
        if m:
            choices = [c.strip() for c in m.group(2).split(",")]
            die(T(f"{m.group(1)} 不夠明確，可能是 {'、'.join(choices)}",
                  f"{m.group(1)} is ambiguous; it could be {', '.join(choices)}"), hint)
        m = re.search(r"argument (\S+): ignored explicit argument '([^']*)'", message)
        if m:
            die(T(f"{m.group(1)} 不接值（多了 {m.group(2)}）", f"{m.group(1)} takes no value (got {m.group(2)})"), hint)
        die(message, hint)


def main():
    p = Parser(prog="ax", usage=f"ax [-h] [--version] {CMD_METAVAR} ...",
               description=T("建立與編譯 akizumi-latex 專案。", "Start and build akizumi-latex projects."),
               epilog=HELP_COMMANDS + HELP_EXAMPLES, formatter_class=ExamplesFormatter)
    p.add_argument("--version", action="version",
                   version=T(f"ax（模板 {', '.join(template_tags()[:1]) or '未打版本'}）",
                             f"ax (template {', '.join(template_tags()[:1]) or 'untagged'})"))
    # The command list is written out in HELP_COMMANDS; argparse's own list
    # would also show the internal ones (texinputs, copypdf, explain).
    sub = p.add_subparsers(dest="command", required=True, metavar=CMD_METAVAR, help=argparse.SUPPRESS,
                           parser_class=Parser)

    n = sub.add_parser("new", prog="ax new", help=HELP_LINES["new"],
                       description=T("建立新專案。沒給的種類、資料夾、標題會互動式詢問。",
                                     "Start a new project. Kind, folder and title are asked for "
                                     "when not given."),
                       epilog=HELP_EXAMPLES, formatter_class=ExamplesFormatter)
    n.add_argument("kind", nargs="?", metavar=T("種類", "kind"), help=" / ".join(KINDS))
    n.add_argument("dir", nargs="?", metavar=T("資料夾", "folder"))
    n.add_argument("--title", metavar=T("標題", "TITLE"), help=T("標題（作業不用，會寫成「作業 N」）",
                                     'title (not for homework: it becomes "Homework N")'))
    n.add_argument("--author", metavar=T("作者", "AUTHOR"), help=T("作者，預設取自 config.json（ax config 看位置）",
                                      "author; default from config.json (ax config shows where)"))
    n.add_argument("--course", metavar=T("課名", "COURSE"), help=T("課名；書和簡報放在標題上方", "course; above the title in books and slides"))
    n.add_argument("--number", metavar=T("編號", "NUMBER"), help=T("作業編號", "homework number"))
    n.add_argument("--due", metavar=T("期限", "DUE"), help=T("作業繳交期限", "homework due date"))
    n.add_argument("--id", metavar=T("學號", "ID"), help=T("學號，預設取自 config.json", "student ID; default from config.json"))
    n.add_argument("--lang", choices=["en", "zh", "ja", "ko"],
                   help=T("主語言，預設取自 config.json", "main language; default from config.json"))
    n.add_argument("--thmnames", choices=["english", "native"],
                   help=T("定理名稱：english（Theorem、Proof）或 native（定理、證明）",
                          "theorem names: english (Theorem, Proof) or native (定理, 證明)"))
    n.add_argument("--text", choices=["serif", "sans", "times", "palatino"], help=T("內文字型（預設 serif）", "body font (default serif)"))
    n.add_argument("--paper", choices=["a4", "letter", "pad"],
                   help=T("紙張；pad 是平板閱讀版面", "paper; pad is a page for reading on a tablet"))
    n.add_argument("--layout", choices=["normal", "margin"],
                   help=T("margin：右側寬邊欄放 sidenote", "margin: wide right margin for sidenotes"))
    n.add_argument("--bib", action="store_true", help=T("加上 refs.bib 和參考文獻", "add refs.bib and a bibliography"))
    n.add_argument("--code", choices=["listings", "minted"],
                   help=T("程式碼上色：listings（預設）或 minted（Pygments；TeX Live 2024 以前要 -shell-escape，ax 會加）",
                          "code highlighting: listings (default) or minted (Pygments; TeX before 2024 needs -shell-escape, which ax adds)"))
    n.add_argument("--progress", action="store_true", help=T("簡報底部加進度條", "progress bar along the slides' bottom"))
    n.add_argument("--venue", choices=list(PAPER_VENUES),
                   help=T("paper：投稿的會議（預設 plain）；會議的 .sty 要自己下載",
                          "paper: the venue (default plain); you download its .sty"))
    n.add_argument("--split", action="store_true",
                   help=T("paper：每一節放在 sections/ 裡的獨立檔案", "paper: each section in its own file in sections/"))
    g = n.add_mutually_exclusive_group()
    g.add_argument("--anonymous", action="store_true", default=None,
                   help=T("paper：匿名投稿版（會議預設如此）", "paper: anonymous submission (the default for venues)"))
    g.add_argument("--no-anonymous", dest="anonymous", action="store_false",
                   help=T("paper：署名版（camera-ready）", "paper: with author names (camera-ready)"))
    n.add_argument("--pin", metavar=T("版本", "PIN"), help=T("模板版本，預設最新的 tag；latest 表示永遠用安裝的最新檔案",
                                   "template version; default the newest tag. latest always uses the installed files"))
    n.add_argument("--git", action="store_true", help=T("建立 git repo 並做第一個 commit",
                                                        "create a git repo with a first commit"))
    n.add_argument("--no-preamble", action="store_true",
                   help=T("不加入設定資料夾裡的 preamble.tex / preamble-種類.tex",
                          "leave out preamble.tex / preamble-KIND.tex from the config folder"))
    n.add_argument("--force", action="store_true", help=T("資料夾已存在且不是空的也照樣建立",
                                                          "use the folder even if it exists and is not empty"))
    n.add_argument("--problems", metavar="N|B4,C2",
                   help=T("作業：建立 problems/p1.tex…pN.tex（或 B1…B4、C1…C2 分組）並用 \\inputproblem 載入",
                          "homework: create problems/p1.tex ... pN.tex (or groups B1...B4, C1...C2) "
                          "and load them with \\inputproblem"))
    n.set_defaults(func=cmd_new)

    for name, func in (("build", cmd_build), ("watch", cmd_watch), ("both", cmd_both)):
        c = sub.add_parser(name, **cmd_help(name))
        c.add_argument("file", nargs="?", metavar=T("檔案", "file"),
                       help=T("預設是專案的 main.tex", "default: the project's main.tex"))
        c.set_defaults(func=func)
        c.add_argument("--no-prebuild", action="store_true",
                       help=T('跳過 .ax.json 的 "prebuild" 步驟', 'skip the "prebuild" steps in .ax.json'))
        if name != "both":
            c.add_argument("--chapter", action="append", metavar="N",
                           help=T("只編第 N 章（章要用 \\include 載入；可寫 3,5 或資料夾名），"
                                  "輸出 main-chN.pdf，章號照舊",
                                  "build only chapter N (chapters must be \\include'd; 3,5 or a "
                                  "folder name also work) into main-chN.pdf, keeping its number"))
        if name == "watch":
            g = c.add_mutually_exclusive_group()
            g.add_argument("--bg", action="store_true",
                           help=T("在背景監看，馬上把終端機還給你（輸出寫到 build/watch.log）",
                                  "watch in the background and return at once (output in build/watch.log)"))
            g.add_argument("--status", action="store_true",
                           help=T("背景監看有沒有在跑、上次編譯成功還是失敗",
                                  "whether a background watcher runs, and how its last build went"))
            g.add_argument("--stop", action="store_true", help=T("停止背景監看", "stop the background watcher"))
            g.add_argument("--log", action="store_true",
                           help=T("即時看背景監看的輸出（Ctrl-C 結束）",
                                  "follow the background watcher's output (Ctrl-C to quit)"))
    c = sub.add_parser("count", **cmd_help("count"))
    c.add_argument("file", nargs="?", metavar=T("檔案", "file"),
                   help=T("預設是專案的 main.tex", "default: the project's main.tex"))
    c.add_argument("--limit", type=int, metavar="N", help=T("字數上限", "word limit"))
    c.set_defaults(func=cmd_count)
    o = sub.add_parser("open", **cmd_help("open"))
    o.add_argument("file", nargs="?", metavar=T("檔案", "file"),
                   help=T("預設是專案的 main.pdf", "default: the project's main.pdf"))
    o.add_argument("--solutions", action="store_true",
                   help=T("打開 ax both 產生的解答", "open the solutions made by ax both"))
    o.set_defaults(func=cmd_open)
    for name, func in (("doctor", cmd_doctor), ("upgrade", cmd_upgrade), ("freeze", cmd_freeze),
                       ("pack", cmd_pack), ("config", cmd_config)):
        sub.add_parser(name, **cmd_help(name)).set_defaults(func=func)
    c = sub.add_parser("completion", prog="ax completion", help=HELP_LINES["completion"],
                       description=T("印出 Tab 補全腳本。\n\n"
                                     "  zsh：       在 ~/.zshrc 加  eval \"$(ax completion zsh)\"\n"
                                     "  bash：      在 ~/.bashrc 加 eval \"$(ax completion bash)\"\n"
                                     "  PowerShell：在 $PROFILE 加  ax completion powershell | Out-String | Invoke-Expression",
                                     "Print a Tab-completion script.\n\n"
                                     "  zsh:        add to ~/.zshrc   eval \"$(ax completion zsh)\"\n"
                                     "  bash:       add to ~/.bashrc  eval \"$(ax completion bash)\"\n"
                                     "  PowerShell: add to $PROFILE   ax completion powershell | Out-String | Invoke-Expression"),
                       formatter_class=ExamplesFormatter)
    c.add_argument("shell", choices=["zsh", "bash", "powershell"])
    c.set_defaults(func=cmd_completion)
    t = sub.add_parser("selftest", **cmd_help("selftest"))
    t.add_argument("part", nargs="?", choices=["all", "examples", "tests", "projects", "docs"], default="all",
                   help=T("預設 all", "default: all"))
    t.set_defaults(func=cmd_selftest)
    m = sub.add_parser("migrate", **cmd_help("migrate"))
    m.add_argument("file", metavar=T("檔案", "file"))
    m.add_argument("-o", "--output", metavar=T("檔案", "file"),
                   help=T("寫到這裡（預設是同資料夾的 檔名-akizumi.tex）",
                          "write here (default: NAME-akizumi.tex next to it)"))
    m.add_argument("--in-place", action="store_true",
                   help=T("直接改原檔（原檔備份成 .bak）", "rewrite the file itself (the original is kept as .bak)"))
    m.add_argument("--kind", choices=["hw", "note", "exam", "book", "slides"],
                   help=T("要轉成的種類；預設依內容判斷", "kind to convert to; default: guessed from the content"))
    m.add_argument("--dry-run", action="store_true", help=T("只列出會改什麼，不寫檔", "list the changes, write nothing"))
    m.add_argument("--force", action="store_true", help=T("輸出檔已存在也覆寫", "overwrite the output file"))
    m.add_argument("--project", action="store_true",
                   help=T("同時把資料夾設成 ax 專案（.ax.json、latexmkrc、.vscode）",
                          "also make the folder an ax project (.ax.json, latexmkrc, .vscode)"))
    m.add_argument("--pin", metavar=T("版本", "version"),
                   help=T("搭配 --project：模板版本，預設 latest", "with --project: template version, default latest"))
    m.set_defaults(func=cmd_migrate)
    d = sub.add_parser("docs", **cmd_help("docs"))
    d.add_argument("topic", nargs="*", metavar=T("主題", "topic"),
                   help=T("中文或英文，也可以是選項名稱或巨集（例如 定理、minted、thmcounter、\\cref）",
                          "Chinese or English words, an option name or a macro "
                          "(e.g. theorem, minted, thmcounter, \\cref)"))
    d.add_argument("--en", action="store_true", help=T("看英文版", "the English manual"))
    d.add_argument("--web", action="store_true",
                   help=T("在瀏覽器打開 GitHub 上的手冊（有主題就跳到那一節）",
                          "open the manual on GitHub in the browser (at the section, given a topic)"))
    d.add_argument("--cheatsheet", action="store_true",
                   help=T("打開速查表 PDF（examples/cheatsheet.pdf）", "open the cheat sheet PDF (examples/cheatsheet.pdf)"))
    d.set_defaults(func=cmd_docs)

    # internal: latexmkrc asks for the pinned template path; ax watch explains
    # failures and copies the PDF out after successful runs
    sub.add_parser("texinputs").set_defaults(func=cmd_texinputs)
    c = sub.add_parser("copypdf")
    c.add_argument("src")
    c.add_argument("dest")
    c.set_defaults(func=cmd_copypdf)
    e = sub.add_parser("explain")
    e.add_argument("job")
    e.set_defaults(func=cmd_explain)

    if len(sys.argv) == 1:
        menus = menu_keys_ok()
        try:
            if show_status(actions=not menus):
                if menus:
                    project_menu(p, project_config())
            elif menus:
                home_menu(p)
            else:
                p.print_help()
        except KeyboardInterrupt:
            print()
            sys.exit(130)
        sys.exit(0)
    global PARSER
    PARSER = p
    a = p.parse_args()
    try:
        a.func(a)
    except KeyboardInterrupt:
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
